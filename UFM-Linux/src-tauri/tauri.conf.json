{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultimate File Manager Pro Companion",
  "version": "0.1.0",
  "identifier": "za.kilowatch.ufm-companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ultimate File Manager Pro Companion",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; font-src 'self' data:; connect-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Kilowatch",
    "homepage": "https://github.com/Kilowatch/ultimate-file-manager-pro",
    "category": "Utility",
    "shortDescription": "Ultimate File Manager Pro Companion for Linux",
    "longDescription": "Native Wayland-first Linux desktop companion for Ultimate File Manager Pro — dual-pane file browser, Wi-Fi transfer and remote APK/XAPK sideloading.",
    "copyright": "Copyright © 2026 Kilowatch. GPL-3.0.",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "librsvg2"
        ],
        "release": "1",
        "epoch": 0
      }
    }
  }
}

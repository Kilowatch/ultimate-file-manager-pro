# Apache SSHD, MINA, and FTPServer use ServiceLoader and reflection which R8 breaks in release.
# IMPORTANT: The broad -keep for org.apache.ftpserver.** is also required to preserve the
# thread-safety patch at app/src/main/java/org/apache/ftpserver/listener/nio/FtpResponseEncoder.java.
# That class shadows the broken library version and MUST retain its exact package name at runtime.
# See: java.nio.charset.CoderMalfunctionError fix — shared static CharsetEncoder → ThreadLocal.
-keep class org.apache.sshd.** { *; }
-keep class org.apache.mina.** { *; }
-keep class org.apache.ftpserver.** { *; }
-keep class net.i2p.crypto.eddsa.** { *; }


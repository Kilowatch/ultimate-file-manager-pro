# R8 generated: suppress warnings for classes used by JCIFS (SMB) / GSSAPI
# that are not present on Android.
-dontwarn javax.el.BeanELResolver
-dontwarn javax.el.ELContext
-dontwarn javax.el.ELResolver
-dontwarn javax.el.ExpressionFactory
-dontwarn javax.el.FunctionMapper
-dontwarn javax.el.ValueExpression
-dontwarn javax.el.VariableMapper
-dontwarn org.ietf.jgss.GSSContext
-dontwarn org.ietf.jgss.GSSCredential
-dontwarn org.ietf.jgss.GSSException
-dontwarn org.ietf.jgss.GSSManager
-dontwarn org.ietf.jgss.GSSName
-dontwarn org.ietf.jgss.Oid

# Apache POI — keep Escher/DDF record fields accessed via reflection.
# DefaultEscherRecordFactory uses Class.getField("RECORD_ID") in its static initializer.
# Without this, R8 strips RECORD_ID causing java.lang.NoSuchFieldException at runtime.
-keepclassmembers class org.apache.poi.ddf.** {
    public static final short RECORD_ID;
}

# Apache POI — java.awt and javax.xml classes not present on Android
-dontwarn java.awt.Color
-dontwarn java.awt.Dimension
-dontwarn java.awt.Rectangle
-dontwarn java.awt.geom.Rectangle2D$Double
-dontwarn java.awt.geom.Rectangle2D
-dontwarn javax.xml.bind.DatatypeConverter
-dontwarn javax.xml.stream.XMLEventFactory
-dontwarn javax.xml.stream.XMLStreamReader
-dontwarn javax.xml.stream.events.Namespace

# xmlbeans optional service providers (XPath/XQuery, not used by UFM)
-dontwarn org.apache.xmlbeans.impl.store.PathDelegate$SelectPathInterface
-dontwarn org.apache.xmlbeans.impl.store.QueryDelegate$QueryInterface

# JCIFS-NG and its dependencies (required for Release builds)
# Keep only packages actually used — jcifs.smb1.* is intentionally excluded
# so R8 strips SMB1 classes from the release APK.
-keep class jcifs.CIFSContext { *; }
-keep class jcifs.config.** { *; }
-keep class jcifs.context.** { *; }
-keep class jcifs.smb.** { *; }
-keep class eu.agno3.jcifs.** { *; }
-keep class org.bouncycastle.** { *; }

# ── smbj (com.hierynomus:smbj) ──────────────────────────────────────────────
# smbj uses reflection/ServiceLoader to load its JceSecurityProvider and
# uses enum constants + sealed class hierarchies for SMB2/3 packet encoding.
# R8 strips/renames these classes in release builds, causing:
#   - Silent crypto negotiation failures → repeated retries/timeouts
#   - SPNEGO/NTLM auth fallback loops
#   - Massive slowdown on ALL SMB operations (list, open, thumbnails, transfer)
# This is the root cause of "debug fast, release very slow" SMB behavior.
-keep class com.hierynomus.smbj.** { *; }
-keep class com.hierynomus.mssmb2.** { *; }
-keep class com.hierynomus.msfscc.** { *; }
-keep class com.hierynomus.protocol.** { *; }
-keep class com.hierynomus.security.** { *; }
-keep class com.hierynomus.asn1.** { *; }
-keep class com.hierynomus.ntlm.** { *; }
-keep class com.hierynomus.spnego.** { *; }
-keep class com.hierynomus.msdtyp.** { *; }
-keep class com.hierynomus.mserref.** { *; }
-dontwarn com.hierynomus.**

# MBassador event bus — transitive dependency of smbj.
# Uses reflection to instantiate event subscription handlers via constructors.
# R8 obfuscates these classes, causing "provider handler invocation did not
# specify the necessary constructor" errors at runtime.
-keep class net.engio.mbassy.** { *; }

# Suppress warnings for optional/legacy components not used or present on Android
-dontwarn org.bouncycastle.**
-dontwarn jcifs.http.**

# Missing R8 rules for security/auth classes (generated by build)
-dontwarn javax.security.auth.callback.NameCallback
-dontwarn javax.security.auth.kerberos.KerberosKey
-dontwarn javax.security.auth.kerberos.KerberosPrincipal
-dontwarn javax.security.auth.kerberos.KerberosTicket
-dontwarn javax.security.auth.login.AppConfigurationEntry$LoginModuleControlFlag
-dontwarn javax.security.auth.login.AppConfigurationEntry
-dontwarn javax.security.auth.login.Configuration
-dontwarn javax.security.auth.login.LoginContext
-dontwarn org.ietf.jgss.MessageProp

# Keep Room-generated implementations used by WorkManager (avoid R8 stripping them)
-keep class * extends androidx.room.RoomDatabase { *; }
# WorkManager internal DB implementation
-keep class androidx.work.impl.WorkDatabase_Impl { *; }
-keep class androidx.work.impl.WorkDatabase$* { *; }

# Keep generated Room/DAO implementations (broad rule to be safe for release builds)
-keep class **_Impl { *; }


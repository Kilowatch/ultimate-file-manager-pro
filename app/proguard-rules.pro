# ── Amazon Appstore SDK (IAP 3.0.8) ──────────────────────────────────────────
# Required by Amazon: the PurchasingListener callbacks and ResponseReceiver are
# invoked via reflection and broadcast intents from the Appstore process.
# Without these rules R8 will strip or rename the IAP classes and purchases break.
-dontwarn com.amazon.**
-keep class com.amazon.device.iap.** { *; }
-keep class com.amazon.device.drm.** { *; }
-keepattributes *Annotation*

# ── PDFBox-Android (PDF Conversion) ──────────────────────────────────────────
-keep class com.tom_roush.pdfbox.** { *; }
-dontwarn javax.xml.stream.**
-dontwarn javax.xml.namespace.**

# ── EMC ECS NFS Client (Netty 3.x: org.jboss.netty) ────────────────────────────
# NfsShareClient + NFS RPC runtime classes accessed via reflection
-keep class com.emc.ecs.nfsclient.** { *; }

# Netty 3 (org.jboss.netty) — used by nfs-client for NIO transport.
# Heavily uses reflection for ChannelPipeline, ChannelFactory, Selector, etc.
-keep class org.jboss.netty.** { *; }

# Suppress warnings for optional Netty 3 components not available on Android
-dontwarn org.jboss.netty.**
-dontwarn com.sun.jna.**

# Missing R8 rules (generated by build)
-dontwarn com.gemalto.jp2.JP2Decoder
-dontwarn com.gemalto.jp2.JP2Encoder

# Keep strings.xml and static fields of R$string class from obfuscation or shrinking
-keepclassmembers class **.R$string {
    public static <fields>;
}

# ── Native libnfs JNI Bridge ────────────────────────────────────────────────
# Preserve the LibNfsBridge class and its native methods to prevent rename,
# which would cause UnsatisfiedLinkError at runtime since C JNI symbols match
# the fully qualified package/class name.
-keep class za.kilowatch.ultimatefilemanager.network.LibNfsBridge {
    *;
}


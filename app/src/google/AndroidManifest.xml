<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play In-App Billing (Tip Jar) -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <application>
        <!--
             Prevent Firebase from auto-initialising via FirebaseInitProvider during
             super.onCreate(). UfmApplication registers BouncyCastle synchronously
             before super.onCreate() and then calls FirebaseApp.initializeApp() manually,
             ensuring the security provider list is stable before any Firebase HTTPS
             thread starts. Without this, the BC insertion race causes an NPE in
             OpenSSLSocketFactoryImpl.createSocket() on Firebase's ThreadPoolExecutor.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>
</manifest>

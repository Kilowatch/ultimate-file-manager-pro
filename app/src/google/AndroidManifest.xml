<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play In-App Billing (Tip Jar) -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <application>
        <!--
             FirebaseInitProvider is removed so Firebase can never auto-initialise during
             the ContentProvider phase (before UfmApplication.onCreate, on the main
             thread). UfmApplication registers BouncyCastle synchronously first, then the
             google-flavor Analytics.init() initialises Firebase on a dedicated background
             thread — so the security provider list is stable before any Firebase HTTPS
             thread starts (avoiding the BC insertion race / NPE in
             OpenSSLSocketFactoryImpl.createSocket()), and no Firebase work ever runs on
             the main thread (avoiding the >5000 ms "Main thread blocked" ANR on
             low-end Android TV devices).
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <!-- 10 Milestone Badge App Icon Launcher Aliases (Google Mobile) -->
        <!-- 5 Points -->
        <activity-alias
            android:name=".BadgeIcon5"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_points_5"
            android:roundIcon="@mipmap/ic_launcher_points_5_round"
            android:label="@string/app_name"
            android:targetActivity=".onboarding.LanguageWelcomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


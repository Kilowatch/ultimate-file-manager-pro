<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Bookmark Launcher Widget (Mobile only) -->
        <receiver
            android:name=".widget.BookmarkWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bookmark_info" />
        </receiver>

        <service
            android:name=".widget.BookmarkWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- FTP/SFTP Toggle Widget (Mobile only) -->
        <receiver
            android:name=".widget.FtpSftpWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ftp_sftp_info" />
        </receiver>

    </application>

</manifest>

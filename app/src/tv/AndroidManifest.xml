<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TV Support - Required for TV devices -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.type.tv"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Prevent TvRemoteActivity / TvSetupGuideActivity (declared in the shared main
         manifest with screenOrientation="portrait" so they resolve on TV builds) from
         implying android.hardware.screen.portrait is REQUIRED. Android TV devices are
         landscape-only and do not declare portrait support, so a required portrait
         feature excludes ~99% of Android TV devices from the Play listing. The app runs
         fine either way — this only restores device coverage. -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />
    <application
        xmlns:tools="http://schemas.android.com/tools"
        android:icon="@mipmap/ic_launcher_tv"
        android:roundIcon="@mipmap/ic_launcher_tv"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.UltimateFileManager.Tv"
        tools:replace="android:icon,android:roundIcon,android:theme">
        <activity android:name=".onboarding.LanguageWelcomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TV Server Foreground Service — keeps PairingServer and TV file browsing alive
             in the background even when UFM is closed on TV. TV builds only. -->
        <service
            android:name=".network.TvServerForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- TV Boot actions for BootReceiver -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_tv_gradient">

    <!-- Current Icon Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="24dp">

        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_glass_card">

            <ImageView
                android:id="@+id/imgCurrentIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtIconName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:textSize="24sp"
            android:textColor="@color/tv_text_primary"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetIcon"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/reset_icon_to_default"
            android:textSize="16sp"
            android:focusable="true"
            app:strokeColor="?attr/colorError"
            android:textColor="?attr/colorError"
            app:icon="@drawable/ic_refresh"
            app:iconTint="?attr/colorError"
            android:ellipsize="end"
            android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowseIcon"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:text="@string/browse_icon_file"
            android:textSize="16sp"
            android:focusable="true"
            app:icon="@drawable/ic_folder"
            android:ellipsize="end"
            android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/done"
            android:textSize="16sp"
            android:focusable="true"
            app:icon="@drawable/ic_check"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Collapsible Built-in Icons Grid (hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutBuiltinSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/tv_glass_border"
            android:layout_marginVertical="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBuiltinIcons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>
</LinearLayout>

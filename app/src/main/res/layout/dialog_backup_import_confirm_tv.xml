<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="700dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="32dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_icon_circle_accent"
        android:layout_marginBottom="18dp">

        <ImageView
            android:id="@+id/imgHeroIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_file_backup"
            app:tint="@color/white"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/backup_confirm_import_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="10dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/backup_confirm_import_message"
        android:textColor="@color/tv_text_secondary"
        android:textSize="15sp"
        android:textAlignment="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="28dp" />

    <!-- Confirm Import & Restart Button -->
    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/backup_import_action_btn"
        android:background="@drawable/selector_tv_button_yellow"
        android:textColor="@color/selector_tv_button_text_yellow"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/cancel"
        android:background="@drawable/selector_tv_button"
        android:textColor="@color/tv_text_primary"
        android:textSize="14sp"
        android:focusable="true" />

</LinearLayout>

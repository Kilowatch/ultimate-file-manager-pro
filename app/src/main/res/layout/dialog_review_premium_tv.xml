<?xml version="1.0" encoding="utf-8"?>
<!--
    TV In-App Review Dialog — UFMStandard glass card, compact layout.
    Designed to fit on screen without any scrolling at 1080p / standard TV safe area.
    Total estimated height: ~470dp — well within TV dialog limits.

    IDs preserved for ReviewUiHelper.kt:
      btnRate, btnMaybeLater, btnNoThanks, btnTipLink
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_dialog_surface"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- ── Hero Star Icon ── -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_tv_card_glass">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_star"
            app:tint="@color/tv_button_focused_yellow"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- ── Title ── -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hey_got_a_minute"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black" />

    <!-- ── 5-Star Accent Row ── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star"
            app:tint="@color/tv_button_focused_yellow"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star"
            app:tint="@color/tv_button_focused_yellow"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star"
            app:tint="@color/tv_button_focused_yellow"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star"
            app:tint="@color/tv_button_focused_yellow"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star"
            app:tint="@color/tv_button_focused_yellow"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- ── Body Card ── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/tv_glass_white_10"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/tv_glass_border">

        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/youve_been_using_the_app"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textAlignment="center"
            android:padding="12dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ── Button Stack ── -->

    <!-- 1. Rate the App (primary — gets focus first) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRate"
        style="@style/TvContinueButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/rate_the_app"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        app:icon="@drawable/ic_star"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <!-- 2. Maybe Later -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMaybeLater"
        style="@style/TvContinueButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/maybe_later"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- 3. No Thanks -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNoThanks"
        style="@style/TvContinueButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/no_thanks_1"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- ── Divider ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/tv_glass_border" />

    <!-- ── Tip Jar Banner ── -->
    <!--
        selector_tv_button_yellow handles D-pad focus:
          focused → yellow fill (readable over purple tint)
          default → glass white + border (purple tint from layer-list shows through)
        The LinearLayout acts as the clickable row; ID preserved for ReviewUiHelper.
    -->
    <LinearLayout
        android:id="@+id/btnTipLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:background="@drawable/selector_tv_button_yellow"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:focusable="true"
        android:clickable="true">

        <!-- Coffee icon -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_coffee"
            app:tint="@color/tile_tip_jar_accent"
            android:contentDescription="@null"
            android:scaleType="centerInside" />

        <!-- Title + subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_jar_title"
                android:textColor="@color/tile_tip_jar_accent"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/theres_also_a_tiny_coffee"
                android:textColor="@color/tv_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Chevron -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/tile_tip_jar_accent"
            android:contentDescription="@null"
            android:scaleType="centerInside" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- TV EPUB Viewer — D-pad scrollable WebView with focus border -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".viewer.EpubViewerActivity">

    <!-- TV Header Bar -->
    <LinearLayout
        android:id="@+id/layoutTvHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_white_10"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_icon_btn" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/margin_md">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:ellipsize="middle"
                tools:text="My Book Title" />

            <TextView
                android:id="@+id/txtChapterInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:singleLine="true"
                tools:text="Chapter 1 of 12" />
        </LinearLayout>

        <!-- TOC button -->
        <ImageView
            android:id="@+id/btnToc"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_view_list"
            android:contentDescription="@string/epub_table_of_contents"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:layout_marginEnd="8dp"
            android:background="@drawable/selector_tv_icon_btn" />

    </LinearLayout>

    <!-- Loading progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/tv_accent"
        android:visibility="gone"
        android:layout_gravity="center" />

    <!-- Scrollable WebView with Focus Border -->
    <FrameLayout
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/tv_safe_horizontal"
        android:layout_marginBottom="16dp"
        android:padding="4dp"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:background="@drawable/selector_tv_policy_scroll">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@color/tv_button_focused_yellow" />
    </FrameLayout>

    <!-- Bottom D-pad chapter navigation bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_white_10">

        <Button
            android:id="@+id/btnPrevChapter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/epub_prev_chapter"
            android:textSize="14sp"
            android:layout_marginEnd="32dp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_button" />

        <Button
            android:id="@+id/btnNextChapter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/epub_next_chapter"
            android:textSize="14sp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_button" />

    </LinearLayout>

</LinearLayout>

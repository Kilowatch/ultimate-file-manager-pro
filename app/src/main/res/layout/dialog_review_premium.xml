<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hey_got_a_minute"
        android:textColor="@color/ufm_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-medium"
        android:layout_gravity="center_horizontal"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/youve_been_using_the_app"
        android:textColor="@color/ufm_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textAlignment="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRate"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:text="@string/rate_the_app"
        app:cornerRadius="16dp"
        android:backgroundTint="@color/ufm_primary"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMaybeLater"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/maybe_later"
        app:cornerRadius="16dp"
        android:textAllCaps="false"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNoThanks"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/no_thanks"
        android:textColor="@color/ufm_text_primary"
        android:backgroundTint="#1A000000"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:textSize="14sp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="@color/ufm_surface_variant" />

    <TextView
        android:id="@+id/btnTipLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="8dp"
        android:text="@string/theres_also_a_tiny_coffee"
        android:textColor="@color/tile_tip_jar_accent"
        android:textSize="13sp"
        android:textAlignment="center"
        android:fontFamily="sans-serif-medium"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>

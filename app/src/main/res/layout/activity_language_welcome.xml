<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="52dp"
            android:paddingBottom="32dp"
            android:gravity="center_horizontal">

            <!-- Hero App Icon (Clean & Prominent) -->
            <ImageView
                android:id="@+id/imgAppLogo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name_1"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/app_name_1"
                android:textColor="@color/mobile_text_primary"
                android:textSize="28sp"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/txtTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/welcome_tagline"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/welcome_select_language"
                android:textColor="@color/mobile_text_primary"
                android:textSize="15sp"
                android:gravity="center"
                android:fontFamily="sans-serif-bold" />

            <!-- Language Selection Dropdown -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLanguageSelector"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:rippleColor="@color/mobile_glass_ripple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <!-- Frosted Flag Badge in Dropdown -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_icon_frosted">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgSelectedFlag"
                            android:layout_width="30dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.ExtraSmall" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtSelectedLanguage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-bold"
                        tools:text="English" />

                    <!-- Frosted Expand Chevron Badge -->
                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_btn_icon_frosted">

                        <ImageView
                            android:id="@+id/imgChevron"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorPrimary"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="28dp" />

            <!-- Disclaimer & Hint -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/welcome_translation_disclaimer"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/welcome_change_later_hint"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:fontFamily="sans-serif-italic" />

            <TextView
                android:id="@+id/txtFossLegalNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/foss_legal_notice"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:fontFamily="sans-serif"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Modern Expressive Pill CTA Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetDefault"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_set_default_language"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="29dp"
                app:elevation="4dp"
                app:rippleColor="#33FFFFFF"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="12dp"
                app:iconSize="20dp"
                app:iconTint="@android:color/white" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

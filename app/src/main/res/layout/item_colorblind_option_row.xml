<?xml version="1.0" encoding="utf-8"?>
<!--
    One selectable option in a Colorblind Mode group (mobile).
    Structure follows item_font_size_row.xml, with the letter badge replaced by a
    colour swatch.

    The swatch is deliberately an empty View: its background is a GradientDrawable
    the Activity builds from ColorblindPalette, so the swatch shows the *result* of
    the option rather than a fixed decoration. That matters most for the strength
    rows, where "Low / Medium / High" is otherwise an abstract scale with nothing
    to look at.

    The swatch is never the only signal. The label, the description line and the
    radio button all carry the meaning; a swatch alone would be exactly the
    colour-only cue this feature exists to remove.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="13dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Frosted swatch container -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_btn_icon_frosted">

        <View
            android:id="@+id/viewSwatch"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            tools:background="#1565C0" />
    </FrameLayout>

    <!-- Title & Description -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_card_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold"
            tools:text="Red-Green" />

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp"
            tools:text="For protanopia and deuteranopia." />
    </LinearLayout>

    <!-- Selection indicator. Mode-off appearance is unchanged: the Activity
         re-tints this only while Colorblind Mode is on. -->
    <RadioButton
        android:id="@+id/rbSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="?attr/colorPrimary"
        android:clickable="false"
        android:focusable="false"
        android:saveEnabled="false" />
</LinearLayout>

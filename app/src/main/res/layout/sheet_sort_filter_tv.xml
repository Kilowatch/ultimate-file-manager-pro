<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_lg"
    android:background="@color/ufm_surface">

    <!-- Title -->
    <TextView
        android:id="@+id/txtSortTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sort_title"
        android:textColor="@color/ufm_text_primary"
        android:textSize="@dimen/text_lg"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/margin_md" />

    <!-- 3-Column Layout for TV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Column 1: Sort By -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="@dimen/margin_md">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_by_1"
                android:textColor="@color/ufm_text_secondary"
                android:textSize="@dimen/text_sm"
                android:layout_marginBottom="@dimen/margin_sm" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgSortMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortName"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_by_name" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortSize"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_by_size" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortDate"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_by_date" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSortType"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_by_type" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Column 2: Sort Order -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="@dimen/margin_md">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order"
                android:textColor="@color/ufm_text_secondary"
                android:textSize="@dimen/text_sm"
                android:layout_marginBottom="@dimen/margin_sm" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgSortOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAscending"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_ascending" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDescending"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_descending" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Column 3: Filter -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="@dimen/margin_md">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter"
                android:textColor="@color/ufm_text_secondary"
                android:textSize="@dimen/text_sm"
                android:layout_marginBottom="@dimen/margin_sm" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_all"
                    android:checked="true" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipImages"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_images" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVideos"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_videos" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAudio"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_audio" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDocuments"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_documents" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipApks"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_apks" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Column 4: Show Hidden Files -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_hidden_files"
                android:textColor="@color/ufm_text_secondary"
                android:textSize="@dimen/text_sm"
                android:layout_marginBottom="@dimen/margin_sm" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgHiddenFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHiddenEnabled"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_twin_window_startup_subtitle_on" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHiddenDisabled"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_twin_window_startup_subtitle_off" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Column 5: Group by Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_by_date"
                android:textColor="@color/ufm_text_secondary"
                android:textSize="@dimen/text_sm"
                android:layout_marginBottom="@dimen/margin_sm" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgGroupByDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGroupDateEnabled"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_twin_window_startup_subtitle_on" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGroupDateDisabled"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_twin_window_startup_subtitle_off" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </LinearLayout>

    <!-- Apply Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplySort"
        style="@style/ContinueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/continue_button_height"
        android:layout_marginTop="@dimen/margin_lg"
        android:text="@string/apply" />

</LinearLayout>

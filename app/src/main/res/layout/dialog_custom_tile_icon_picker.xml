<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom Tile Icon Picker Dialog — Mobile Frosted Glass Standard
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Header: Icon Badge + Title + Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder_special"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_tile_select_icon"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/custom_tile_select_icon_desc"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mobile_glass_stroke"
        android:layout_marginBottom="12dp" />

    <!-- Icon Grid RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIconPicker"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mobile_glass_stroke"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Browse Custom Icon Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBrowseIcon"
        style="@style/Widget.Material3Expressive.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/tile_icon_browse"
        android:textColor="@color/mobile_text_primary"
        android:textSize="14sp"
        app:icon="@drawable/ic_folder"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="?attr/colorPrimary"
        app:strokeColor="@color/mobile_glass_stroke"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Done / OK Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDoneIconPicker"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/action_done"
        android:textColor="@color/white"
        android:textSize="14.5sp"
        android:fontFamily="sans-serif-bold"
        app:cornerRadius="12dp" />

</LinearLayout>

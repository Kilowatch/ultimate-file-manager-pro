<?xml version="1.0" encoding="utf-8"?>
<!-- Scanned Page Item — Premium Glassmorphic Standard -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_reindex_option_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Rounded Thumbnail Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        android:backgroundTint="#26FFFFFF">

        <ImageView
            android:id="@+id/imgPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/scanner_pages" />
    </androidx.cardview.widget.CardView>

    <!-- Page Title & Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/txtPageNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold"
            tools:text="Page 1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready for export"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Delete Page Button -->
    <ImageView
        android:id="@+id/btnDeletePage"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="@string/clear_text"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple"
        app:tint="@color/ufm_denied" />

</LinearLayout>

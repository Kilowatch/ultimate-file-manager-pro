<?xml version="1.0" encoding="utf-8"?>
<!-- Paired Device Item — Premium Glass Card with Polished Action Controls -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="@dimen/margin_md"
    android:layout_marginVertical="6dp"
    android:padding="16dp"
    android:background="@drawable/bg_reindex_option_card">

    <!-- Top Header Row: Icon + Device Info + Action Button Group -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- TV Device Icon Badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imgDeviceIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tv"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>

        <!-- Device Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="@color/mobile_text_primary"
                android:textSize="16sp"
                tools:text="Bedroom TV" />

            <!-- Status Pill Badge -->
            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/bg_badge_step_pill"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                tools:text="192.168.10.76 · Connected" />

        </LinearLayout>

        <!-- Polished Action Buttons (Rename & Delete) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Edit / Rename Button -->
            <ImageView
                android:id="@+id/btnEditName"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_icon_frosted"
                android:clickable="true"
                android:contentDescription="@string/rename_device"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_edit"
                app:tint="?attr/colorPrimary" />

            <!-- Unpair / Delete Button -->
            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_icon_danger"
                android:clickable="true"
                android:contentDescription="@string/remove_device"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_delete"
                app:tint="#FFEF5350" />

        </LinearLayout>

    </LinearLayout>

    <!-- Connect / Disconnect Full-Width Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:text="@string/connect"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_check_circle"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="16dp"
        app:iconTint="@color/white"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>

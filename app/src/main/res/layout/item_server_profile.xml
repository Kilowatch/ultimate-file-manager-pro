<?xml version="1.0" encoding="utf-8"?>
<!-- Server Profile Card — Premium Glassmorphic Standard -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_reindex_option_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- 40dp Frosted User/Profile Icon -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginEnd="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_file_server"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Profile Details Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Username & Read-Only Badge Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/mobile_text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="admin" />

            <!-- Read-only pill badge -->
            <TextView
                android:id="@+id/txtReadOnlyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/read_only_badge"
                android:textColor="#FFA726"
                android:textSize="10sp"
                android:fontFamily="sans-serif-bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_badge_step_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Location label -->
        <TextView
            android:id="@+id/txtLocationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="middle"
            android:layout_marginTop="2dp"
            tools:text="Internal Storage / Download" />

        <!-- Auth Type Badge -->
        <TextView
            android:id="@+id/txtAuthType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textColor="?attr/colorPrimary"
            android:background="@drawable/bg_badge_step_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp"
            android:visibility="visible"
            tools:text="PASSWORD + SSH KEY" />

        <!-- Warning Layout -->
        <LinearLayout
            android:id="@+id/layoutWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/imgWarning"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/ufm_denied" />

            <TextView
                android:id="@+id/txtWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_action_required_warning"
                android:textColor="@color/ufm_denied"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Edit button -->
    <ImageView
        android:id="@+id/btnEdit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/ic_edit"
        android:contentDescription="@string/edit"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple"
        app:tint="@color/mobile_text_secondary" />

    <!-- Delete button -->
    <ImageView
        android:id="@+id/btnDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="@string/delete"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple"
        app:tint="@color/ufm_denied"
        android:layout_marginStart="4dp" />

</LinearLayout>

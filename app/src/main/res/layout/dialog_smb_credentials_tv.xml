<?xml version="1.0" encoding="utf-8"?>
<!-- TV: Credential entry dialog after picking a host -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/bg_glass_card_dark">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/tv_accent"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smb_credentials_header"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <!-- Host chip -->
    <TextView
        android:id="@+id/txtCredHost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_icon_circle_accent"
        android:textColor="@color/tv_text_primary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-mono"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Username -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="@string/network_field_username"
                android:textColorHint="@color/tv_text_primary"
                app:hintTextColor="@color/tv_text_primary"
                app:boxStrokeColor="@color/tv_accent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCredUsername"
                    android:textColor="@color/tv_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="@string/network_field_password"
                app:endIconMode="password_toggle"
                android:textColorHint="@color/tv_text_primary"
                app:hintTextColor="@color/tv_text_primary"
                app:boxStrokeColor="@color/tv_accent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCredPassword"
                    android:textColor="@color/tv_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:focusable="true"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Domain -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCredDomain"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/network_field_domain"
                android:textColorHint="@color/tv_text_primary"
                app:hintTextColor="@color/tv_text_primary"
                app:boxStrokeColor="@color/tv_accent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCredDomain"
                    android:textColor="@color/tv_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCredCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            
            
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/cancel"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCredConnect"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/smb_btn_connect"
            android:textColor="@color/tv_text_primary"
            android:focusable="true"
            app:backgroundTint="@color/ufm_primary"
            app:cornerRadius="12dp"
            
            
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:elevation="0dp"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="beforeDescendants"
    android:background="@drawable/selector_tv_list_item">

    <!-- User icon -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:src="@drawable/ic_file_server"
        android:background="@drawable/bg_icon_circle_accent"
        android:duplicateParentState="true"
        app:tint="@color/selector_tv_icon_tint_yellow" />

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:duplicateParentState="true"
        android:layout_marginStart="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:duplicateParentState="true"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/selector_tv_button_text_yellow"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:duplicateParentState="true"
                tools:text="admin" />

            <!-- Read-only badge -->
            <TextView
                android:id="@+id/txtReadOnlyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/read_only_badge"
                android:textColor="#FF9800"
                android:textSize="10sp"
                android:fontFamily="sans-serif-bold"
                android:textAllCaps="true"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLocationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/selector_tv_btn_secondary_text"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            tools:text="Internal Storage / Download" />
        <TextView
            android:id="@+id/txtAuthType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:textAllCaps="true"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:visibility="visible" />
        <LinearLayout
            android:id="@+id/layoutWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:visibility="visible">
            <ImageView
                android:id="@+id/imgWarning"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/status_error" />
            <TextView
                android:id="@+id/txtWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_action_required_warning"
                android:textColor="@color/status_error"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Edit button -->
    <ImageView
        android:id="@+id/btnEdit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:src="@drawable/ic_edit"
        android:contentDescription="@string/edit"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/selector_tv_icon_btn"
        app:tint="@color/selector_tv_icon_tint_yellow" />

    <!-- Delete button -->
    <ImageView
        android:id="@+id/btnDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="@string/delete"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/selector_tv_icon_btn"
        app:tint="@color/ufm_denied"
        android:layout_marginStart="8dp" />

</LinearLayout>

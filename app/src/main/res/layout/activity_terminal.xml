<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile ADB Terminal — Premium Glassmorphic Standard -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient">

    <!-- Modern Glass Header Bar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            app:tint="@color/mobile_icon_tint" />

        <!-- Title + Live Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_terminal_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="1dp">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_translucent" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_terminal_status_disconnected"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Copy Output Button -->
        <ImageView
            android:id="@+id/btnCopyTerminal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_copy"
            android:contentDescription="@string/adb_terminal_copy"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            app:tint="@color/mobile_icon_tint" />

        <!-- Clear Output Button -->
        <ImageView
            android:id="@+id/btnClearTerminal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/adb_terminal_clear"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            app:tint="@color/mobile_icon_tint" />

        <!-- Connect Button -->
        <ImageView
            android:id="@+id/btnConnect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_terminal"
            android:contentDescription="@string/adb_terminal_connect"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            app:tint="@color/mobile_icon_tint" />

        <!-- Disconnect Button -->
        <ImageView
            android:id="@+id/btnDisconnect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/adb_terminal_disconnect"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            android:visibility="gone"
            app:tint="@color/ufm_error" />
    </LinearLayout>

    <!-- Terminal Console Area -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTerminal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:strokeColor="@color/mobile_glass_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toTopOf="@id/scrollQuickCommands"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Terminal Output Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTerminal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Commands Carousel -->
    <HorizontalScrollView
        android:id="@+id/scrollQuickCommands"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/layoutInput">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipCmdLs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ls -la"
                android:textColor="@color/mobile_text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_reindex_option_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/chipCmdPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pm list packages"
                android:textColor="@color/mobile_text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_reindex_option_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/chipCmdTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="top -n 1"
                android:textColor="@color/mobile_text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_reindex_option_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/chipCmdDf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="df -h"
                android:textColor="@color/mobile_text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_reindex_option_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/chipCmdProp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="getprop"
                android:textColor="@color/mobile_text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_reindex_option_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/chipCmdBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dumpsys battery"
                android:textColor="@color/mobile_text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_reindex_option_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/chipCmdUptime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="uptime"
                android:textColor="@color/mobile_text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_reindex_option_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/chipCmdLogcat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="logcat -d -t 50"
                android:textColor="@color/mobile_text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_reindex_option_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/chipCmdClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="clear"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:background="@drawable/bg_reindex_option_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginHorizontal="4dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ "
            android:textColor="?attr/colorPrimary"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/editCommand"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:hint="@string/adb_terminal_hint"
            android:textColor="@color/mobile_text_primary"
            android:textColorHint="@color/mobile_text_secondary"
            android:background="@drawable/bg_reindex_option_card"
            android:paddingHorizontal="14dp"
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:singleLine="true"
            android:scrollHorizontally="true" />

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_forward"
            android:background="@drawable/bg_header_action_ripple"
            android:contentDescription="@string/adb_terminal_send"
            android:clickable="true"
            android:focusable="true"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_danger"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shield_alert"
            app:tint="?attr/ufmDenied"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/webdav_cert_dialog_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="6dp" />

    <!-- Description Message -->
    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/webdav_cert_dialog_msg"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13.5sp"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="16dp" />

    <!-- Certificate Details Glass Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="14dp"
        android:layout_marginBottom="20dp">

        <!-- Subject -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/webdav_cert_dialog_subject"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/txtCertSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp" />

        <!-- Issuer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/webdav_cert_dialog_issuer"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/txtCertIssuer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp" />

        <!-- Validity -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/webdav_cert_dialog_valid"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/txtCertValidity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp" />

        <!-- SHA-256 Fingerprint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/webdav_cert_dialog_fingerprint"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/txtCertFingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_accent"
            android:textSize="11.5sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Trust & Connect Button (Primary) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTrust"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/webdav_cert_dialog_trust"
        android:textColor="@android:color/white"
        android:textSize="14.5sp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/btn_save_bg_tint"
        android:layout_marginBottom="8dp" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp" />

</LinearLayout>

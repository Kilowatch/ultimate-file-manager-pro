<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".settings.ThemeActivity">

    <!-- TV Header Bar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_white_10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_icon_btn" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/margin_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_tile_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden toolbar for compatibility -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Theme option cards — scrollable container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="@dimen/margin_xl">

            <!-- Light -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLight"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginBottom="@dimen/margin_md"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <!-- Swatch -->
                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#FFF5F5F5"
                        android:layout_marginEnd="@dimen/margin_lg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_light"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium" />

                    <RadioButton
                        android:id="@+id/rbLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/tv_accent"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dark -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDark"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginBottom="@dimen/margin_md"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#FF121212"
                        android:layout_marginEnd="@dimen/margin_lg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_dark"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium" />

                    <RadioButton
                        android:id="@+id/rbDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/tv_accent"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AMOLED Black -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAmoled"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginBottom="@dimen/margin_md"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <!-- Pure-black swatch -->
                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#FF000000"
                        android:layout_marginEnd="@dimen/margin_lg" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_amoled"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_amoled_desc"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rbAmoled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/tv_accent"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- System Default -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSystem"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <!-- Split swatch -->
                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:layout_marginEnd="@dimen/margin_lg">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFF5F5F5" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FF121212" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/theme_system"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium" />

                    <RadioButton
                        android:id="@+id/rbSystem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/tv_accent"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>


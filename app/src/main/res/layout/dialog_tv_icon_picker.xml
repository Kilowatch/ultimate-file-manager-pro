<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Icon Picker Dialog — full-screen semi-transparent overlay.
    Shows a grid of built-in icons to choose from with Apply/Cancel.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <LinearLayout
        android:layout_width="680dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_tv_dialog_surface"
        android:padding="32dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_palette"
                app:tint="@color/tv_accent"
                android:layout_marginEnd="16dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tile_icon_pick_builtin"
                android:textColor="@color/tv_text_primary"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/tv_glass_border"
            android:layout_marginBottom="20dp" />

        <!-- Icon grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tvIconPickerGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            android:descendantFocusability="afterDescendants"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="6" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIconPickerCancel"
                style="@style/TvContinueButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:text="@string/tile_color_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIconPickerApply"
                style="@style/TvGrantButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="@string/apply" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>

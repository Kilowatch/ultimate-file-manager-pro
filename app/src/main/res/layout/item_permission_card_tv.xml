<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPermission"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/tv_glass_white_10"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/tv_glass_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="18dp"
        android:gravity="center_vertical">

        <!-- ── Frosted Icon Container ── -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_tv_card_glass">

            <ImageView
                android:id="@+id/imgPermIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_permission_icon"
                app:tint="@color/tv_accent"
                tools:src="@drawable/ic_folder" />
        </FrameLayout>

        <!-- ── Text Block: Title + Status + Description ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp">

            <!-- Title row: name + status badge side by side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtPermTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-bold"
                    tools:text="Storage Access" />

                <!-- Status badge -->
                <TextView
                    android:id="@+id/txtPermStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_status_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    tools:text="Required"
                    tools:textColor="@color/ufm_pending" />

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/txtPermDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Required to browse, copy, move and manage files on your device storage." />

        </LinearLayout>

        <!-- ── Grant Button ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrant"
            style="@style/TvGrantButton"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:text="@string/btn_grant"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="24dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle_accent">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_md">
            <TextView
                android:id="@+id/txtToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_edit_title_add"
                android:textColor="@color/mobile_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_shares_title"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_md">

            <!-- Type selector -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/network_field_type"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />
                    <LinearLayout
                        android:id="@+id/gridType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipSmb"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="64dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:text="@string/network_type_smb"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                app:icon="@drawable/ic_network"
                                android:checkable="true"
                                android:checked="true"
                                app:backgroundTint="@color/selector_protocol_bg"
                                app:iconTint="@color/selector_protocol_text"
                                android:textColor="@color/selector_protocol_text"
                                app:iconGravity="textStart"
                                android:gravity="center"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/mobile_glass_stroke"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipFtp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="64dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:text="@string/network_type_ftp"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                app:icon="@drawable/ic_remote_manage"
                                android:checkable="true"
                                app:backgroundTint="@color/selector_protocol_bg"
                                app:iconTint="@color/selector_protocol_text"
                                android:textColor="@color/selector_protocol_text"
                                app:iconGravity="textStart"
                                android:gravity="center"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/mobile_glass_stroke"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipSftp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="64dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:text="@string/network_type_sftp"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                app:icon="@drawable/ic_lock"
                                android:checkable="true"
                                app:backgroundTint="@color/selector_protocol_bg"
                                app:iconTint="@color/selector_protocol_text"
                                android:textColor="@color/selector_protocol_text"
                                app:iconGravity="textStart"
                                android:gravity="center"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/mobile_glass_stroke"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipScp"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="64dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:text="@string/network_type_scp"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                app:icon="@drawable/ic_terminal"
                                android:checkable="true"
                                app:backgroundTint="@color/selector_protocol_bg"
                                app:iconTint="@color/selector_protocol_text"
                                android:textColor="@color/selector_protocol_text"
                                app:iconGravity="textStart"
                                android:gravity="center"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/mobile_glass_stroke"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipNfs"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="64dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:text="@string/network_type_nfs"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                app:icon="@drawable/ic_nfs"
                                android:checkable="true"
                                app:backgroundTint="@color/selector_protocol_bg"
                                app:iconTint="@color/selector_protocol_text"
                                android:textColor="@color/selector_protocol_text"
                                app:iconGravity="textStart"
                                android:gravity="center"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/mobile_glass_stroke"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />

                                <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipDlna"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="64dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:text="@string/network_type_dlna"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                app:icon="@drawable/ic_dlna"
                                android:checkable="true"
                                app:backgroundTint="@color/selector_protocol_bg"
                                app:iconTint="@color/selector_protocol_text"
                                android:textColor="@color/selector_protocol_text"
                                app:iconGravity="textStart"
                                android:gravity="center"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/mobile_glass_stroke"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



            <!-- Connection fields card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/network_field_name"
                        android:textColorHint="@color/mobile_text_primary"
                        app:hintTextColor="@color/mobile_text_primary"
                        app:boxStrokeColor="@color/ufm_primary">
                        <com.google.android.material.textfield.TextInputEditText android:textColor="@color/mobile_text_primary" android:textColorHint="@color/mobile_text_primary"
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- DLNA Device Picker (visible only when DLNA type selected) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectDlnaDevice"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/dlna_scan_network"
                        android:textColor="@color/ufm_primary"
                        android:visibility="gone"
                        app:icon="@drawable/ic_dlna"
                        app:iconTint="@color/ufm_primary"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/mobile_glass_stroke" />

                    <TextView
                        android:id="@+id/txtDlnaSelectedDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- SMB Connection Type (Share / Server) — visible only when SMB is selected -->
                    <LinearLayout
                        android:id="@+id/layerSmbConnectionType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/network_field_connection_type"
                            android:textColor="@color/mobile_card_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipSmbShare"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="64dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:text="@string/network_conn_type_share"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:checkable="true"
                                android:checked="true"
                                app:backgroundTint="@color/selector_protocol_bg"
                                app:iconTint="@color/selector_protocol_text"
                                android:textColor="@color/selector_protocol_text"
                                android:gravity="center"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/mobile_glass_stroke"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipSmbServer"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="64dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:text="@string/network_conn_type_server"
                                android:textSize="12sp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:checkable="true"
                                app:backgroundTint="@color/selector_protocol_bg"
                                app:iconTint="@color/selector_protocol_text"
                                android:textColor="@color/selector_protocol_text"
                                android:gravity="center"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/mobile_glass_stroke"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Host field + Scan button -->
                    <LinearLayout
                        android:id="@+id/layerHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/network_field_host"
                            android:textColorHint="@color/mobile_text_primary"
                            app:hintTextColor="@color/mobile_text_primary"
                            app:boxStrokeColor="@color/ufm_primary">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHost"
                                android:textColor="@color/mobile_text_primary"
                                android:textColorHint="@color/mobile_text_primary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <ImageButton
                            android:id="@+id/btnScanHosts"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_icon_circle_accent"
                            android:src="@drawable/ic_search"
                            android:contentDescription="@string/smb_cd_scan"
                            android:visibility="visible"
                            app:tint="@color/mobile_text_primary" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layerPort"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/network_field_port"
                        android:textColorHint="@color/mobile_text_primary"
                        app:hintTextColor="@color/mobile_text_primary"
                        app:boxStrokeColor="@color/ufm_primary">
                        <com.google.android.material.textfield.TextInputEditText android:textColor="@color/mobile_text_primary" android:textColorHint="@color/mobile_text_primary"
                            android:id="@+id/etPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtHostKeyFingerprint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ufm_text_secondary"
                        android:textSize="13sp"
                        android:padding="8dp"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:text="@string/ssh_host_key_not_verified" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsername"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/network_field_username"
                        android:textColorHint="@color/mobile_text_primary"
                        app:hintTextColor="@color/mobile_text_primary"
                        app:boxStrokeColor="@color/ufm_primary">
                        <com.google.android.material.textfield.TextInputEditText android:textColor="@color/mobile_text_primary" android:textColorHint="@color/mobile_text_primary"
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/network_field_password"
                        app:endIconMode="password_toggle"
                        android:textColorHint="@color/mobile_text_primary"
                        app:hintTextColor="@color/mobile_text_primary"
                        app:boxStrokeColor="@color/ufm_primary">
                        <com.google.android.material.textfield.TextInputEditText android:textColor="@color/mobile_text_primary" android:textColorHint="@color/mobile_text_primary"
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- NFS Version Selector (NFS only) -->
                    <LinearLayout
                        android:id="@+id/layerNfsVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/nfs_version"
                            android:textColor="@color/mobile_text_primary"
                            android:textSize="14sp" />

                        <RadioGroup
                            android:id="@+id/rgNfsVersion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbNfsAuto"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/nfs_version_auto"
                                android:textColor="@color/mobile_text_primary" />

                            <RadioButton
                                android:id="@+id/rbNfs3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/nfs_version_3"
                                android:textColor="@color/mobile_text_primary" />

                            <RadioButton
                                android:id="@+id/rbNfs4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/nfs_version_4"
                                android:textColor="@color/mobile_text_primary" />
                        </RadioGroup>
                    </LinearLayout>

                    <!-- Domain (SMB only) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDomain"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="@string/network_field_domain"
                        android:textColorHint="@color/mobile_text_primary"
                        app:hintTextColor="@color/mobile_text_primary"
                        app:boxStrokeColor="@color/ufm_primary">
                        <com.google.android.material.textfield.TextInputEditText android:textColor="@color/mobile_text_primary" android:textColorHint="@color/mobile_text_primary"
                            android:id="@+id/etDomain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Remote path field + Browse button -->
                    <LinearLayout
                        android:id="@+id/layerPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/network_field_path"
                            android:textColorHint="@color/mobile_text_primary"
                            app:hintTextColor="@color/mobile_text_primary"
                            app:boxStrokeColor="@color/ufm_primary">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPath"
                                android:textColor="@color/mobile_text_primary"
                                android:textColorHint="@color/mobile_text_primary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                android:imeOptions="actionDone" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <ImageButton
                            android:id="@+id/btnBrowseShares"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_icon_circle_accent"
                            android:src="@drawable/ic_folder"
                            android:contentDescription="@string/smb_cd_browse_shares"
                            android:visibility="visible"
                            app:tint="@color/mobile_text_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SSH Auth Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSshAuth"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/network_btn_show_ssh_auth"
                android:textColor="@color/ufm_primary"
                android:visibility="gone" />

            <!-- SSH Authentication card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSshAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/network_header_ssh_auth"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/network_field_private_key"
                            android:textColorHint="@color/mobile_text_primary"
                            app:hintTextColor="@color/mobile_text_primary"
                            app:boxStrokeColor="@color/ufm_primary">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPrivateKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/mobile_text_primary"
                                android:inputType="text"
                                android:focusable="false"
                                android:clickable="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickKey"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/network_btn_pick_key"
                            android:textColor="@color/ufm_primary" />
                    </LinearLayout>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbUseKeychain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/network_label_use_keychain"
                        android:textColor="@color/mobile_card_text_primary"
                        app:buttonTint="@color/ufm_primary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SMB Protocol Version card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSmbProtocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/network_field_smb_protocol"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />
                    <RadioGroup
                        android:id="@+id/rgSmbProtocol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton
                            android:id="@+id/rbSmbAuto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/network_smb_protocol_auto"
                            android:textColor="@color/mobile_card_text_primary"
                            android:checked="true" />
                        <RadioButton
                            android:id="@+id/rbSmb2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/network_smb_protocol_smb2"
                            android:textColor="@color/mobile_card_text_primary" />
                        <RadioButton
                            android:id="@+id/rbSmb3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/network_smb_protocol_smb3"
                            android:textColor="@color/mobile_card_text_primary" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Access Mode card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/network_field_access"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />
                    <RadioGroup
                        android:id="@+id/rgAccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RadioButton
                            android:id="@+id/rbReadOnly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/network_access_readonly"
                            android:textColor="@color/mobile_card_text_primary"
                            android:checked="true" />
                        <RadioButton
                            android:id="@+id/rbReadWrite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/network_access_readwrite"
                            android:textColor="@color/mobile_card_text_primary" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Test Connection result -->
            <TextView
                android:id="@+id/txtTestResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone"
                android:background="@drawable/bg_glass_card_dark" />

            <!-- NFS Debug Log (shown on NFS errors) -->
            <LinearLayout
                android:id="@+id/layerNfsDebugLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                android:background="@drawable/bg_glass_card_dark">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/nfs_debug_log"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtNfsDebugLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="11sp"
                    android:background="@android:color/black"
                    android:alpha="0.8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyDebugLog"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nfs_debug_log_copy"
                    android:textColor="@color/ufm_primary" />
            </LinearLayout>

            <!-- Test Connection -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:text="@string/network_btn_test"
                android:textSize="15sp" />

            <!-- Save -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:text="@string/network_btn_save"
                android:textSize="15sp"
                android:textColor="@color/btn_save_text_color"
                app:backgroundTint="@color/btn_save_bg_tint"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

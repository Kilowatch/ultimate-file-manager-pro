<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile Vault Entry - UFM Standard -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVaultEntry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:descendantFocusability="blocksDescendants"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke"
    app:rippleColor="@color/mobile_glass_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:descendantFocusability="afterDescendants">

        <!-- Header Row: Icon + Info (always visible) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="false"
            android:descendantFocusability="blocksDescendants">

            <!-- 40dp Frosted Icon Badge -->
            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:focusable="false"
                android:background="@drawable/bg_btn_icon_frosted">

                <ImageView
                    android:id="@+id/imgVaultIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:focusable="false"
                    android:contentDescription="@string/cd_storage_icon"
                    android:src="@drawable/ic_folder"
                    app:tint="?attr/colorPrimary" />

            </FrameLayout>

            <!-- Vault Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:focusable="false"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/txtVaultName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="15.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:focusable="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Secure Photos" />

                <TextView
                    android:id="@+id/txtVaultPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="12sp"
                    android:focusable="false"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    tools:text="/storage/emulated/0/Private" />

                <!-- File Count Badge -->
                <TextView
                    android:id="@+id/txtFileCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_status_badge_accent"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:focusable="false"
                    android:fontFamily="sans-serif-medium"
                    tools:text="24 files" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action buttons — hidden by default, shown when card is expanded -->
        <LinearLayout
            android:id="@+id/layoutVaultActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:descendantFocusability="afterDescendants">

            <!-- Button Row 1: Open + Decrypt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:focusable="false"
                android:descendantFocusability="afterDescendants">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVaultOpen"
                    style="@style/Widget.Material3Expressive.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/vault_open"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVaultDecrypt"
                    style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/vault_decrypt"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    app:cornerRadius="12dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- Button Row 2: Remove -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:focusable="false"
                android:descendantFocusability="afterDescendants">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVaultRemove"
                    style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/vault_remove"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/ufm_denied"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/ufm_denied"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

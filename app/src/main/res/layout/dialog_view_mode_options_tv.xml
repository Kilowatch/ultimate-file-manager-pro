<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_tv_dialog_surface"
        android:padding="32dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imgDialogIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_grid_view_custom"
                app:tint="@color/tv_accent"
                android:layout_marginEnd="16dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/txtDialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Layout Options"
                android:textColor="@color/tv_text_primary"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/tv_glass_border"
            android:layout_marginBottom="24dp" />

        <!-- Section: Grid Columns -->
        <LinearLayout
            android:id="@+id/layoutColumns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/column_count"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-bold"/>

            <!-- 4 Columns Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardColumns4"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:background="@drawable/bg_glass_card">

                    <RadioButton
                        android:id="@+id/rbColumns4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/columns_4"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3 Columns Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardColumns3"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:background="@drawable/bg_glass_card">

                    <RadioButton
                        android:id="@+id/rbColumns3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/columns_3"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Section: List Size -->
        <LinearLayout
            android:id="@+id/layoutListSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="List Layout Size"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-bold"/>

            <!-- Large Size Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSizeLarge"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:background="@drawable/bg_glass_card">

                    <RadioButton
                        android:id="@+id/rbSizeLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Large"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medium Size Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSizeMedium"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:background="@drawable/bg_glass_card">

                    <RadioButton
                        android:id="@+id/rbSizeMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Medium"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Small Size Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSizeSmall"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:background="@drawable/bg_glass_card">

                    <RadioButton
                        android:id="@+id/rbSizeSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Small"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTvClose"
            style="@style/TvContinueButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/close" />

    </LinearLayout>
</FrameLayout>

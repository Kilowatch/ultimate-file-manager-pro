<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Status Icon -->
    <ImageView
        android:id="@+id/imgResultIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:src="@android:drawable/stat_sys_download_done"
        android:layout_marginBottom="12dp"
        android:contentDescription="@null" />

    <!-- Title (Success / Failed) -->
    <TextView
        android:id="@+id/txtResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/installation_successful"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- App Name / Package Name -->
    <TextView
        android:id="@+id/txtResultAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:textColor="@color/tv_button_focused_yellow"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Detail Message -->
    <TextView
        android:id="@+id/txtResultMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:gravity="center" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Dismiss / OK Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismiss"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:text="@string/btn_dismiss"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/tv_glass_white_10"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:focusable="true" />

        <!-- Open App Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:text="@string/btn_open_app"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/tv_glass_white_10"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>

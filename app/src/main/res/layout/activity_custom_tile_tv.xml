<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".storage.CustomTileActivity">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_white_10">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_icon_btn"
            app:tint="@color/selector_tv_icon_tint_yellow"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStorageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="My Custom Tile" />

            <TextView
                android:id="@+id/txtStorageSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone"
                tools:text="Optional subtitle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnManageTiles"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:src="@drawable/ic_tune"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/selector_tv_button_yellow"
                app:tint="@color/selector_tv_button_text"
                android:visibility="gone"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/cd_manage_tiles" />

            <!-- Palette button -->
            <ImageView
                android:id="@+id/btnColorTile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:src="@drawable/ic_palette"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/selector_tv_button_yellow"
                app:tint="@color/selector_tv_button_text"
                android:visibility="gone"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/tile_color_title" />

            <!-- Import Code button -->
            <ImageView
                android:id="@+id/btnImportColorCode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:src="@drawable/ic_import_code"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/selector_tv_button_yellow"
                app:tint="@color/selector_tv_button_text"
                android:visibility="gone"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/tile_color_import" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/selector_tv_button_yellow"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_done"
                android:textColor="@color/tv_button_focused_yellow_text"
                android:fontFamily="sans-serif-bold"
                android:textSize="14sp"
                android:paddingHorizontal="20dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                style="@style/Widget.Material3.Button" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:clipChildren="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStorage"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:paddingTop="16dp"
                android:paddingHorizontal="@dimen/tv_safe_horizontal"
                android:descendantFocusability="afterDescendants"
                tools:listitem="@layout/item_storage_card_tv" />

        </LinearLayout>

        <!-- Empty State overlay -->
        <LinearLayout
            android:id="@+id/layoutEmptyStorage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieEmptyStorage"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:contentDescription="@null"
                app:lottie_rawRes="@raw/anim_empty_storage"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/txtEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/custom_tile_empty"
                android:textColor="@color/tv_text_hint"
                android:textSize="@dimen/tv_text_body"
                android:textAlignment="center" />

        </LinearLayout>
    </FrameLayout>

</LinearLayout>

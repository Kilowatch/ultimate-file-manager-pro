<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutKeyboardPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="8dp">

    <!-- Text input field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/bt_remote_keyboard_hint"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etKeyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLines="6"
            android:inputType="textMultiLine|textNoSuggestions"
            android:imeOptions="flagNoFullscreen"
            android:gravity="top"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Special key row 1: Backspace · Tab · Enter · Clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKbBackspace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/bt_remote_keyboard_backspace"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            app:strokeColor="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKbTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="@string/bt_remote_keyboard_tab"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            app:strokeColor="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKbEnter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="@string/bt_remote_keyboard_enter"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            app:strokeColor="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKbClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/bt_remote_keyboard_clear"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            app:strokeColor="?attr/colorError" />

    </LinearLayout>

    <!-- Special key row 2: Select All -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKbSelectAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bt_remote_keyboard_select_all"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            app:strokeColor="?attr/colorPrimary" />

    </LinearLayout>

</LinearLayout>

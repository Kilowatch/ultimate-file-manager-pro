<?xml version="1.0" encoding="utf-8"?>
<!-- App Detail — Premium Mobile Bottom Sheet / Dialog -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margin_xl"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- App Icon Header -->
    <ImageView
        android:id="@+id/imgDetailAppIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_apps"
        android:contentDescription="@null" />

    <!-- App Name -->
    <TextView
        android:id="@+id/tvDetailAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        tools:text="Google Chrome" />

    <!-- Package Name -->
    <TextView
        android:id="@+id/tvDetailAppPackage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textAlignment="center"
        android:layout_marginBottom="18dp"
        tools:text="com.android.chrome" />

    <!-- Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_reindex_option_card"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <!-- App Size Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Size"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvDetailAppSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                tools:text="145 MB" />
        </LinearLayout>

        <!-- Installed Date Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Installed"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvDetailAppDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                tools:text="Aug 18, 2026 14:30" />
        </LinearLayout>

        <!-- App Type Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Type"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvDetailAppType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/bg_badge_step_pill"
                tools:text="User Application" />
        </LinearLayout>

        <!-- Debloat Section (if available) -->
        <LinearLayout
            android:id="@+id/layoutDetailDebloat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:paddingTop="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/mobile_glass_stroke"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvDetailDebloatRec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4ADE80"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                tools:text="RECOMMENDED FOR REMOVAL" />

            <TextView
                android:id="@+id/tvDetailDebloatDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                tools:text="Safe to disable or uninstall if not using vendor sync features." />
        </LinearLayout>

    </LinearLayout>

    <!-- Extract APK/XAPK Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDetailExtract"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/extract"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_copy"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/white" />

    <!-- Open System App Info Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDetailAppInfo"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/app_info"
        android:textColor="@color/mobile_text_primary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/mobile_text_primary" />

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDetailClose"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="@string/remote_close"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:textAllCaps="false" />

</LinearLayout>

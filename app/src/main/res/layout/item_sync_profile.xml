<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:strokeColor="@color/mobile_glass_stroke"
    app:strokeWidth="1dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Frosted Icon Squircle -->
        <FrameLayout
            android:id="@+id/layoutIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iconSync"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sync"
                app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:textColor="@color/mobile_card_text_primary"
            android:textSize="17sp"
            app:layout_constraintEnd_toStartOf="@+id/btnMenu"
            app:layout_constraintStart_toEndOf="@+id/layoutIcon"
            app:layout_constraintTop_toTopOf="@+id/layoutIcon"
            tools:text="DCIM Backup" />

        <!-- Interval Badge -->
        <TextView
            android:id="@+id/txtInterval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chip_primary"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@+id/txtName"
            app:layout_constraintStart_toStartOf="@+id/txtName"
            tools:text="Every 1h" />

        <!-- Frosted Menu Button -->
        <FrameLayout
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/mobile_card_text_secondary"
                android:contentDescription="@string/options" />
        </FrameLayout>

        <!-- Source / Dest Paths -->
        <LinearLayout
            android:id="@+id/layoutPaths"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/switchEnabled"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtInterval">

            <TextView
                android:id="@+id/txtSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="13.5sp"
                app:drawableStartCompat="@drawable/ic_phone"
                app:drawableTint="?attr/colorPrimary"
                tools:text="Internal Storage/DCIM" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:layout_marginVertical="3dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/txtDest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="13.5sp"
                app:drawableStartCompat="@drawable/ic_network"
                app:drawableTint="?attr/colorPrimary"
                tools:text="NAS Media / Backups" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/layoutPaths"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layoutPaths" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/mobile_glass_stroke"
            app:layout_constraintTop_toBottomOf="@+id/layoutPaths" />

        <!-- Last Sync Info -->
        <TextView
            android:id="@+id/txtLastSync"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawablePadding="8dp"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_time"
            app:drawableTint="@color/mobile_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            tools:text="Last sync: 2 mins ago (15 files)" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

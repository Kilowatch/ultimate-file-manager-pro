<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <!-- ═══════════════════ VOLUME ROW ═══════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOL"
            android:textSize="10sp"
            android:textColor="?attr/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginEnd="12dp"
            android:maxLines="1" />

        <!-- Vol Down -->
        <ImageButton
            android:id="@+id/btnVolDown"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_remove_circle"
            app:tint="?android:attr/textColorPrimary"
            android:background="@drawable/bg_remote_nav_btn"
            android:contentDescription="Volume Down"
            android:scaleType="center"
            android:padding="12dp"
            android:layout_marginHorizontal="6dp" />

        <!-- Mute -->
        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_music"
            app:tint="?android:attr/textColorPrimary"
            android:background="@drawable/bg_remote_nav_btn"
            android:contentDescription="Mute"
            android:scaleType="center"
            android:padding="14dp"
            android:layout_marginHorizontal="6dp" />

        <!-- Vol Up -->
        <ImageButton
            android:id="@+id/btnVolUp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_add"
            app:tint="?android:attr/textColorPrimary"
            android:background="@drawable/bg_remote_nav_btn"
            android:contentDescription="Volume Up"
            android:scaleType="center"
            android:padding="12dp"
            android:layout_marginHorizontal="6dp" />

    </LinearLayout>

    <!-- ═══════════════════ MEDIA CONTROLS ROW ═══════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDIA"
            android:textSize="10sp"
            android:textColor="?attr/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginEnd="12dp"
            android:maxLines="1" />

        <!-- Rewind -->
        <ImageButton
            android:id="@+id/btnRewind"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_replay_10"
            app:tint="?android:attr/textColorPrimary"
            android:background="@drawable/bg_remote_nav_btn"
            android:contentDescription="Rewind"
            android:scaleType="center"
            android:padding="10dp"
            android:layout_marginHorizontal="4dp" />

        <!-- Play / Pause -->
        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_play"
            app:tint="?attr/colorOnPrimary"
            android:background="@drawable/bg_remote_playpause"
            android:contentDescription="@string/play_pause"
            android:scaleType="center"
            android:padding="14dp"
            android:layout_marginHorizontal="4dp"
            android:elevation="4dp" />

        <!-- Fast Forward -->
        <ImageButton
            android:id="@+id/btnFastForward"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_forward_10"
            app:tint="?android:attr/textColorPrimary"
            android:background="@drawable/bg_remote_nav_btn"
            android:contentDescription="Fast Forward"
            android:scaleType="center"
            android:padding="10dp"
            android:layout_marginHorizontal="4dp" />

        <!-- Stop -->
        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_pause"
            app:tint="?android:attr/textColorPrimary"
            android:background="@drawable/bg_remote_nav_btn"
            android:contentDescription="Stop"
            android:scaleType="center"
            android:padding="14dp"
            android:layout_marginHorizontal="4dp" />

    </LinearLayout>

</LinearLayout>

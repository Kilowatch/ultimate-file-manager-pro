<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_glass"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgWarning"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/ic_warning_badge"
        app:tint="@color/ufm_error" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/analyzer_duplicate_all_selected_warning"
        android:textColor="@color/ufm_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/analyzer_duplicate_all_selected_msg"
        android:textColor="@color/ufm_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:layout_marginBottom="24dp">
        <TextView
            android:id="@+id/txtDangerousFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ufm_error"
            android:textSize="13sp"
            android:textStyle="italic"
            android:gravity="center" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteAnyway"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/analyzer_delete_anyway"
        app:backgroundTint="@color/ufm_error"
        app:cornerRadius="16dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/cancel"
        android:textColor="@color/ufm_text_secondary"
        app:cornerRadius="16dp" />

</LinearLayout>

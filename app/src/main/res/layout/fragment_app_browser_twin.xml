<?xml version="1.0" encoding="utf-8"?>
<!--
    Twin-Window App Browser Fragment — compact, single-column layout used when
    the App Browser is hosted in one half of the split-screen twin window.
    Shows ONLY user-installed apps (no System / Debloater tabs, no search bar).
    Clean dark-glass header with back, title, and sort icons.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ─── Compact Header ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back / close button -->
        <ImageView
            android:id="@+id/btnTvBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_icon_circle_accent"
            app:tint="@color/mobile_icon_tint" />

        <!-- Title -->
        <TextView
            android:id="@+id/txtTvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:text="@string/perm_query_apps_title"
            android:textColor="@color/mobile_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Sort -->
        <ImageView
            android:id="@+id/btnSortApp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_sort"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/mobile_icon_tint" />

    </LinearLayout>

    <!-- ─── App count label ─────────────────────────────────────────── -->
    <TextView
        android:id="@+id/txtAppCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="76 apps" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="txtAppCount" />

    <!-- ─── Selection Action Bar (hidden by default) ────────────────── -->
    <LinearLayout
        android:id="@+id/layoutSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/mobile_glass_header"
        android:elevation="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/btnCloseSelection"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/action_clear_selection"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/mobile_icon_tint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSelectionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                tools:text="1 selected" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/action_select_all"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:paddingVertical="0dp"
                android:paddingHorizontal="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                app:backgroundTint="?attr/colorPrimaryContainer"
                app:icon="@drawable/ic_check"
                app:iconTint="?attr/colorPrimary"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ─── Solid Bottom Action Bar (hidden until apps selected) ───── -->
    <!-- This container has a solid background so touches don't pass     -->
    <!-- through to the RecyclerView item behind the Extract button.     -->
    <LinearLayout
        android:id="@+id/layoutActionPillsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:background="@color/mobile_glass_header"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPillCopy"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/extract"
            android:clickable="true"
            android:focusable="true"
            app:icon="@drawable/ic_copy"
            app:iconSize="16dp" />

    </LinearLayout>

    <!-- ─── App List ────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSelectionBar"
        app:layout_constraintBottom_toTopOf="@id/layoutActionPillsScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_app_twin" />

    <!-- ─── Progress ───────────────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ─── Empty State ─────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_apps_found"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

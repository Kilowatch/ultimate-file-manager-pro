<?xml version="1.0" encoding="utf-8"?>
<!-- TV Media Player — fullscreen overlay layout.
     SurfaceView fills the entire screen; header + controls float on top.
     Controls auto-hide after 3 s during video playback. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_gradient_start"
    tools:context=".viewer.MediaPlayerActivity">

    <!-- Video SurfaceView — fills entire screen (hidden for audio) -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Audio placeholder — centred (visible for audio) -->
    <LinearLayout
        android:id="@+id/audioPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <ImageView
            android:id="@+id/icAudioArt"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_audio"
            android:alpha="0.4"
            android:contentDescription="@string/audio"
            app:tint="@color/tv_text_secondary" />
    </LinearLayout>

    <!-- Loading progress — centred over video -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/tv_accent"
        android:visibility="gone" />

    <!-- ── Overlay: TV Header Bar (top) ── -->
    <LinearLayout
        android:id="@+id/layoutTvHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_media_header_bg"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_media_btn"
            app:tint="@color/tv_icon_tint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/margin_md">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:ellipsize="middle"
                tools:text="movie.mp4" />

            <TextView
                android:id="@+id/txtDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="1:23:45" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Overlay: Controls (bottom) ── -->
    <LinearLayout
        android:id="@+id/controlsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="@dimen/tv_safe_vertical"
        android:background="@color/tv_media_header_bg">

        <!-- Seek bar -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/tv_accent"
            android:thumbTint="@color/tv_accent"
            android:progressBackgroundTint="@color/tv_glass_white_20"
            android:max="1000"
            android:layout_marginBottom="8dp"
            android:focusable="false" />

        <!-- Time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/txtElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                tools:text="0:00" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                tools:text="-1:23:45" />
        </LinearLayout>

        <!-- Playback controls row — D-pad targets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Rewind 10s -->
            <LinearLayout
                android:id="@+id/btnRewind"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:background="@drawable/selector_tv_media_btn"
                android:layout_marginEnd="24dp">

                <ImageView
                    android:id="@+id/icRewind"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_replay_10"
                    android:contentDescription="@string/rewind_10_seconds"
                    android:focusable="false"
                    app:tint="@color/tv_icon_tint" />
            </LinearLayout>

            <!-- Play / Pause — primary control -->
            <LinearLayout
                android:id="@+id/btnPlayPause"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:background="@drawable/selector_tv_media_btn"
                android:layout_marginEnd="24dp">

                <ImageView
                    android:id="@+id/icPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@string/play_pause"
                    android:focusable="false"
                    app:tint="@color/tv_icon_tint" />
            </LinearLayout>

            <!-- Forward 10s -->
            <LinearLayout
                android:id="@+id/btnForward"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:background="@drawable/selector_tv_media_btn">

                <ImageView
                    android:id="@+id/icForward"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_forward_10"
                    android:contentDescription="@string/forward_10_seconds"
                    android:focusable="false"
                    app:tint="@color/tv_icon_tint" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

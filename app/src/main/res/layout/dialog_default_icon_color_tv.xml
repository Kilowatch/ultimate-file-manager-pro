<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_tv_dialog_surface"
        android:padding="28dp">

        <!-- Header: Title of the dialog -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_palette"
                app:tint="@color/tv_accent"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/tv_glass_border"
            android:layout_marginBottom="20dp" />

        <!-- Preview and options horizontal row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <!-- Left: Large color preview circle -->
            <LinearLayout
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="28dp">

                <View
                    android:id="@+id/dialogSelectedColorPreview"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_color_swatch" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="16sp"
                        android:fontFamily="monospace"
                        android:layout_marginEnd="4dp" />

                    <EditText
                        android:id="@+id/dialogSelectedColorHex"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:maxLength="8"
                        android:inputType="textFilter"
                        android:digits="0123456789abcdefABCDEF"
                        android:fontFamily="monospace"
                        android:textSize="16sp"
                        android:textColor="@color/tv_text_primary"
                        android:hint="FF6B35"
                        android:textColorHint="@color/tv_text_secondary"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="10dp"
                        android:gravity="center_vertical"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@+id/dialogBtnApply"
                        android:nextFocusUp="@+id/dialogBtnCustom" />

                </LinearLayout>
            </LinearLayout>

            <!-- Right: Preset swatches recycler and action buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preset Colors"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <!-- Presets grid (2 rows of 4 swatches) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dialogPresetsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants" />

                <!-- Reset & Custom buttons inside dialog -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dialogBtnCustom"
                        style="@style/TvContinueButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/default_icon_color_custom" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dialogBtnReset"
                        style="@style/TvContinueButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/default_icon_color_reset" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Actions (Cancel / Apply) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBtnCancel"
                style="@style/TvContinueButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                
                
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/tile_color_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBtnApply"
                style="@style/TvGrantButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                
                
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/apply" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

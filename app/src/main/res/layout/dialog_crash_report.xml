<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- Icon Badge Circle -->
    <FrameLayout
        android:id="@+id/badgeIconContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_icon_circle_accent"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgCrashIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_crash_report"
            app:tint="@color/ufm_progress_critical" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/txtCrashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Dialog Message Body -->
    <TextView
        android:id="@+id/txtCrashMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp" />

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- No Thanks -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrashNoThanks"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Send Report -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrashSend"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="14dp"
            app:elevation="0dp" />
    </LinearLayout>

</LinearLayout>

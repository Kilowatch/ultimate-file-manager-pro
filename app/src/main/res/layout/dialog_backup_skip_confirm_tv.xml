<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Backup Skip Confirm Dialog - UFM TV Standard
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_dialog_surface"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_tv_card_glass"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_warning"
            app:tint="@color/tv_button_focused_yellow"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/backup_password_skip_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/backup_skip_confirm_desc"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/TvContinueButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/cancel"
            android:focusable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSkip"
            style="@style/TvGrantButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.2"
            android:text="@string/save_unencrypted"
            android:fontFamily="sans-serif-bold"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>

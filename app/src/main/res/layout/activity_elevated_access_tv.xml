<?xml version="1.0" encoding="utf-8"?>
<!--
  Elevated Access, TV.

  Rebuilt rather than adapted: the previous `activity_shizuku_tv.xml` was a flat status block with
  two hard-coded download buttons and no manager concept at all. This layout carries the SAME view
  IDs as `activity_elevated_access.xml` so one Activity class serves both — the IDs are the contract
  between the two files, and the Activity resolves them through a refs holder rather than a binding.

  The manager cards are NOT declared here. They are inflated from `item_elevated_manager_tv.xml` into
  `layoutManagersContainer`, one per ElevatedManager entry, so a fourth manager needs no change to
  this file. Cross-card D-pad wiring is left to default focus traversal because the number of cards
  is only known at runtime.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient">

    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/tv_glass_white_10"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="@drawable/selector_tv_icon_btn"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:focusable="true"
            app:tint="@color/tv_text_primary"
            android:nextFocusDown="@id/btnShizukuEnable" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/shizuku_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Hero: overall status -->
            <LinearLayout
                android:id="@+id/cardStatusHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="32dp">

                <FrameLayout
                    android:id="@+id/layoutStatusIconBg"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_status_badge_accent">

                    <ImageView
                        android:id="@+id/imgStatusIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_shield_check"
                        android:contentDescription="@null"
                        app:tint="@color/tv_accent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtHeroAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-black"
                    tools:text="Porter" />

                <TextView
                    android:id="@+id/txtShizukuStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/shizuku_not_installed"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_status_badge_accent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="@string/shizuku_badge_unavailable"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/txtShizukuDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/shizuku_description"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="18sp"
                    android:lineSpacingExtra="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShizukuEnable"
                    style="@style/TvYellowFocusStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/shizuku_btn_enable"
                    android:visibility="gone"
                    android:focusable="true"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="28dp"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-black"
                    android:textSize="18sp"
                    android:textAllCaps="false" />

                <!-- Capability checkmarks -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/icProtectedCheck"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_check_circle"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:tint="?attr/ufmShizukuOk"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/icSpeedCheck"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="20dp"
                        android:src="@drawable/ic_check_circle"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:tint="?attr/ufmShizukuOk"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/icSecurityCheck"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="20dp"
                        android:src="@drawable/ic_check_circle"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:tint="?attr/ufmShizukuOk"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- Detection in progress (NFR-07 / E-18). Shown only until the first resolve lands,
                 so the manager cards below are never read as a settled "nothing installed". -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressDetection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:trackCornerRadius="4dp"
                app:indicatorColor="@color/tv_accent"
                app:trackColor="#1AFFFFFF" />

            <!-- One card per manager, inflated at runtime in ElevatedManager order. -->
            <LinearLayout
                android:id="@+id/layoutManagersSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/shizuku_section_managers"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06" />

                <LinearLayout
                    android:id="@+id/layoutManagersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Active service information -->
            <LinearLayout
                android:id="@+id/cardServiceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shizuku_service_info_title"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/shizuku_service_provider_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtServiceProviderVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-black"
                        tools:text="Porter Service" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/shizuku_service_permission_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtServicePermissionVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-black"
                        tools:text="Granted (API v23)" />
                </LinearLayout>
            </LinearLayout>

            <!-- Setup guide -->
            <LinearLayout
                android:id="@+id/cardSetupGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shizuku_section_setup_guide"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/shizuku_step_1"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/shizuku_step_2"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/shizuku_step_3"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="17sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecheckStatus"
                style="@style/TvYellowFocusStyle"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="@string/shizuku_recheck_status"
                android:focusable="true"
                android:paddingVertical="12dp"
                android:paddingHorizontal="28dp"
                android:textColor="@color/black"
                android:fontFamily="sans-serif-black"
                android:textSize="18sp"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

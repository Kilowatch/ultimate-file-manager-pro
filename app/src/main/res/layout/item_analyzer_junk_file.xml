<?xml version="1.0" encoding="utf-8"?>
<!--
    Junk/Old File Row — Mobile
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke"
    app:rippleColor="@color/mobile_glass_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:paddingVertical="10dp">
        
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="@dimen/margin_md"
            android:src="@drawable/ic_junk"
            app:tint="@color/mobile_card_text_secondary"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtJunkFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text=".thumbdata4--96746816" />

            <TextView
                android:id="@+id/txtJunkFilePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="start"
                tools:text="/storage/emulated/0/.thumbnails" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtJunkFileSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ufm_risk_safe"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            tools:text="12 MB" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

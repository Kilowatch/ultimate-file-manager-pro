<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tile_color_custom"
        android:textColor="@color/ufm_text_primary"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Palette + Hue Slider row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- HSV square palette -->
        <za.kilowatch.ultimatefilemanager.ui.HsvPaletteView
            android:id="@+id/hsvPalette"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Space android:layout_width="12dp" android:layout_height="match_parent" />

        <!-- Vertical hue slider — same height as palette (enforced by weight) -->
        <za.kilowatch.ultimatefilemanager.ui.HueSliderView
            android:id="@+id/hueSlider"
            android:layout_width="32dp"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- Preset swatches row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="14dp">

        <View android:id="@+id/swatchBlack"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_color_swatch"
            android:layout_marginHorizontal="4dp" />
        <View android:id="@+id/swatchWhite"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_color_swatch"
            android:layout_marginHorizontal="4dp" />
        <View android:id="@+id/swatchRed"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_color_swatch"
            android:layout_marginHorizontal="4dp" />
        <View android:id="@+id/swatchOrange"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_color_swatch"
            android:layout_marginHorizontal="4dp" />
        <View android:id="@+id/swatchYellow"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_color_swatch"
            android:layout_marginHorizontal="4dp" />
        <View android:id="@+id/swatchGreen"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_color_swatch"
            android:layout_marginHorizontal="4dp" />
        <View android:id="@+id/swatchBlue"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_color_swatch"
            android:layout_marginHorizontal="4dp" />
        <View android:id="@+id/swatchPurple"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_color_swatch"
            android:layout_marginHorizontal="4dp" />

    </LinearLayout>

    <!-- Preview + action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <View
            android:id="@+id/colorPreview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_color_swatch" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tile_color_cancel"
            android:textColor="@color/ufm_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelect"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tile_color_done" />

    </LinearLayout>

</LinearLayout>
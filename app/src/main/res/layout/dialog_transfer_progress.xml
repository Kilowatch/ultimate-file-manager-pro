<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtProgressTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/copying_files"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/txtProgressFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/item_00"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtProgressCurrentFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/filenameext"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="middle" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:trackThickness="8dp"
        app:trackCornerRadius="4dp"
        android:progress="0"
        app:indicatorColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/txtProgressSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/s_0_mb_0_mb_0"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:gravity="end" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Mobile Update Available Dialog - Dark glassmorphism adhering to UFMStandard
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:gravity="center_horizontal">

    <!-- Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/imgUpdateIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_install"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/txtUpdateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/mobile_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:gravity="center" />

    <!-- Version Badge Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_badge_step_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txtVersionDiff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Release Notes / Changelog Container (Expanded to fill available screen height) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="14dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/txtChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.25"
            android:background="@drawable/bg_dialog_code_surface"
            android:padding="14dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Primary Action Button (Download APK) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadUpdate"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:textAllCaps="false"
            android:gravity="center"
            android:textAlignment="center"
            android:lineSpacingExtra="3dp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

        <!-- Secondary & Dismiss Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewRelease"
                style="@style/Widget.Material3Expressive.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/update_btn_view_release"
                android:textColor="@color/mobile_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:gravity="center"
                android:textAlignment="center"
                android:lineSpacingExtra="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemindLater"
                style="@style/Widget.Material3Expressive.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/update_btn_remind_later"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-normal"
                android:textAllCaps="false"
                android:gravity="center"
                android:textAlignment="center"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

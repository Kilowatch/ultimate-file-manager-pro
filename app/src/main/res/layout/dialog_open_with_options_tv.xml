<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV Open With Target Options Dialog - UFMStandard Glass -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- Hero App Icon Badge in Frosted Squircle -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/imgAppIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            tools:src="@mipmap/ic_launcher" />
    </FrameLayout>

    <!-- App Name Title -->
    <TextView
        android:id="@+id/txtAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="6dp"
        tools:text="VLC" />

    <!-- Package Name Subtitle -->
    <TextView
        android:id="@+id/txtAppPackage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:singleLine="true"
        android:ellipsize="middle"
        android:layout_marginBottom="24dp"
        tools:text="org.videolan.vlc" />

    <!-- Option 1: Always use this app -->
    <LinearLayout
        android:id="@+id/cardSetDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/bg_tv_reindex_option_card"
        android:layout_marginBottom="12dp">

        <!-- 44dp Frosted Icon Badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/selector_tv_icon_tint_yellow"
                android:duplicateParentState="true"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:id="@+id/txtSetDefaultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_with_set_default"
                android:textColor="@color/selector_tv_button_text_yellow"
                android:duplicateParentState="true"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/txtSetDefaultSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/selector_tv_storage_category_text_secondary"
                android:duplicateParentState="true"
                android:textSize="13sp"
                tools:text="Remember default for .mp4 files" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/selector_tv_icon_tint_yellow"
            android:duplicateParentState="true"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Option 2: App Info -->
    <LinearLayout
        android:id="@+id/cardAppInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/bg_tv_reindex_option_card"
        android:layout_marginBottom="18dp">

        <!-- 44dp Frosted Icon Badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="@color/selector_tv_icon_tint_yellow"
                android:duplicateParentState="true"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:id="@+id/txtAppInfoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_with_app_info"
                android:textColor="@color/selector_tv_button_text_yellow"
                android:duplicateParentState="true"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/txtAppInfoSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/open_with_app_info_desc"
                android:textColor="@color/selector_tv_storage_category_text_secondary"
                android:duplicateParentState="true"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/selector_tv_icon_tint_yellow"
            android:duplicateParentState="true"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/cancel"
        android:background="@drawable/selector_tv_button"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textColor="@color/tv_text_primary"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:focusable="true"
        android:textAllCaps="false" />

</LinearLayout>

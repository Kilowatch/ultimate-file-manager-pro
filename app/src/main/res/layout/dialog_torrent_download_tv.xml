<?xml version="1.0" encoding="utf-8"?>
<!--
    Torrent / Magnet Download Dialog — UFMStandard Glass (TV)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- Header Icon -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_magnet"
        app:tint="@color/tv_accent"
        android:layout_marginBottom="10dp"
        android:importantForAccessibility="no" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/download_torrent_downloads"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="4dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Paste a Magnet URL or select a local .torrent file"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginBottom="18dp" />

    <!-- Selected .torrent File Card (Visible when a file is selected) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSelectedTorrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/tv_glass_white_10"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/tv_accent"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_folder"
                app:tint="@color/tv_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/txtTorrentFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/txtTorrentFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveTorrentFile"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Remove"
                android:background="@drawable/selector_tv_button"
                app:backgroundTint="@null"
                android:textColor="@color/tv_button_text_selector"
                android:textSize="12sp"
                android:focusable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Magnet Section (Visible when no file is selected) -->
    <LinearLayout
        android:id="@+id/layoutMagnetSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Magnet Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMagnet"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/download_enter_magnet_hint"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="@color/tv_text_hint"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editMagnetUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/tv_text_primary"
                android:textSize="15sp"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Paste & Browse Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBrowseTorrentFile"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="@string/download_pick_torrent_file"
                android:background="@drawable/selector_tv_button"
                app:backgroundTint="@null"
                android:textColor="@color/tv_button_text_selector"
                android:textSize="13sp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPasteMagnet"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Paste Magnet"
                android:background="@drawable/selector_tv_button"
                app:backgroundTint="@null"
                android:textColor="@color/tv_button_text_selector"
                android:textSize="13sp"
                android:focusable="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Download Location Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/tv_glass_white_10"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/tv_glass_border"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_folder"
                app:tint="@color/tv_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_location_label"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtSaveLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:ellipsize="middle" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeLocation"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/download_change_location"
                android:background="@drawable/selector_tv_button"
                app:backgroundTint="@null"
                android:textColor="@color/tv_button_text_selector"
                android:textSize="12sp"
                android:focusable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- TV Action Buttons (Horizontal: Cancel on left, Start on right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:background="@drawable/selector_tv_button"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/tv_button_text_selector"
            android:textSize="15sp"
            android:focusable="true"
            android:textAllCaps="false"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartDownload"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/download_action_start"
            android:background="@drawable/selector_tv_button_yellow"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="?attr/ufmFocusFillText"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold"
            android:focusable="true"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Unclaimed Tip Detected Dialog — Mobile UFMStandard Frosted Glass
    Strict UFMStandard:
    - Root: @drawable/bg_dialog_glass (95% opaque theme-aware frosted glass)
    - 24dp padding
    - 56dp frosted squircle hero frame with ic_coffee
    - Title: sans-serif-black 20sp, Subtitle: 13sp
    - Frosted card: @color/mobile_glass_card
    - Vertically stacked buttons: Primary filled, secondary outlined/text
    - Clear zero-personal-data privacy disclosure
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Hero Badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_btn_icon_frosted">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_coffee"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtPromptTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/dialog_unclaimed_tip_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black" />

    <!-- Subtitle (Order ID & Points) -->
    <TextView
        android:id="@+id/txtPromptSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp" />

    <!-- Frosted Message & Privacy Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtPromptMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dialog_unclaimed_tip_message"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="13.5sp"
                android:lineSpacingExtra="3dp"
                android:gravity="center" />

            <!-- Privacy Guarantee Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:paddingHorizontal="10dp"
                android:background="@drawable/bg_badge_bubble">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/dialog_unclaimed_tip_privacy_note"
                    android:textColor="@color/mobile_card_text_secondary"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons — Vertically stacked -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Primary Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGeneratePass"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/dialog_unclaimed_tip_btn_generate"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            app:cornerRadius="12dp"
            app:elevation="0dp" />

        <!-- Secondary Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectExisting"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/dialog_unclaimed_tip_btn_connect_existing"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:strokeColor="@color/mobile_glass_stroke"
            app:strokeWidth="1.5dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp" />

        <!-- Dismiss / Skip Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipPrompt"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="@string/dialog_unclaimed_tip_btn_skip"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</LinearLayout>

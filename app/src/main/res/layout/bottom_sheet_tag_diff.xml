<?xml version="1.0" encoding="utf-8"?>
<!--
    Tag Field Diff Review — Mobile UFMStandard Glass Bottom Sheet
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_glass"
    android:paddingBottom="24dp">

    <!-- Drag Handle (UFMStandard) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header Row (UFMStandard 40dp frosted badge + sans-serif-black title) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:importantForAccessibility="no"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/music_tag_diff_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/music_tag_diff_subtitle"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close"
            app:tint="@color/mobile_text_secondary" />

    </LinearLayout>

    <!-- Glass Divider (UFMStandard) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp" />

    <!-- Toggle All Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/music_tag_select_all"
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold" />

    </LinearLayout>

    <!-- Fields RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDiffFields"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:clipToPadding="false"
        android:paddingVertical="4dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_tag_diff_field" />

    <!-- Bottom Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyDiff"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/music_tag_diff_apply"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold"
            app:icon="@drawable/ic_check"
            app:iconSize="20dp"
            app:cornerRadius="16dp" />

    </LinearLayout>

</LinearLayout>

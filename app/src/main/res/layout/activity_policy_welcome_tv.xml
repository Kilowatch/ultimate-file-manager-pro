<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_premium_dark"
    tools:context=".onboarding.PolicyWelcomeActivity">

    <!-- Premium TV Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="#26000000"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/icon" />

        <View
            android:layout_width="3dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/tv_accent"
            android:alpha="0.8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_to_ultimate_file_manager"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- SECTION HEADING -->
    <TextView
        android:id="@+id/txtSectionHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/legal_requirements"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="32dp"
        android:layout_marginStart="@dimen/tv_safe_horizontal"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/please_review_and_accept_our"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="@dimen/tv_safe_horizontal"
        app:layout_constraintTop_toBottomOf="@id/txtSectionHeading"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/viewAccentLine"
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:background="@color/tv_accent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="@dimen/tv_safe_horizontal"
        app:layout_constraintTop_toBottomOf="@id/txtSub"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- TV Focusable Component Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/viewAccentLine"
        app:layout_constraintBottom_toTopOf="@id/layoutFooter">

        <!-- Terms Card -->
        <LinearLayout
            android:id="@+id/cardTerms"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="140dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/selector_tv_policy_button"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true">
            
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_policy"
                android:layout_marginBottom="8dp"
                app:tint="@color/selector_tv_policy_icon"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/tvTermsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terms_amp_conditions"
                android:textColor="@color/selector_tv_policy_text"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:duplicateParentState="true" />
                
            <TextView
                android:id="@+id/tvTermsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/required"
                android:textColor="@color/tv_accent"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true" />
        </LinearLayout>

        <!-- Privacy Card -->
        <LinearLayout
            android:id="@+id/cardPrivacy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="140dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_tv_policy_button"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true">
            
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_lock"
                android:layout_marginBottom="8dp"
                app:tint="@color/selector_tv_policy_icon"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/tvPrivacyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                android:textColor="@color/selector_tv_policy_text"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:duplicateParentState="true" />
                
            <TextView
                android:id="@+id/tvPrivacyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/required"
                android:textColor="@color/tv_accent"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- FOOTER -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingVertical="16dp"
        android:background="#26000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/read_and_approve_the_policies"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/TvContinueButton"
            android:layout_width="220dp"
            android:layout_height="@dimen/tv_button_height"
            android:text="@string/btn_continue"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

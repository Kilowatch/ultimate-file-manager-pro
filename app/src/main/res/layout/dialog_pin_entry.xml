<?xml version="1.0" encoding="utf-8"?>
<!-- 4-Digit PIN Entry — Premium Glassmorphic Dialog -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="@dimen/margin_xl"
    android:background="@drawable/bg_dialog_glass">

    <!-- Hero Lock Icon -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/txtPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/set_access_pin"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtPinSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/enter_a_4digit_pin"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="20dp" />

    <!-- 4 PIN Digit Boxes Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_reindex_option_card"
        android:padding="20dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/pin1"
                android:layout_width="52dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:textSize="24sp"
                android:textColor="@color/mobile_text_primary"
                android:textStyle="bold"
                android:background="@drawable/bg_pin_box"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/pin2"
                android:layout_width="52dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:textSize="24sp"
                android:textColor="@color/mobile_text_primary"
                android:textStyle="bold"
                android:background="@drawable/bg_pin_box"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/pin3"
                android:layout_width="52dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:textSize="24sp"
                android:textColor="@color/mobile_text_primary"
                android:textStyle="bold"
                android:background="@drawable/bg_pin_box"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/pin4"
                android:layout_width="52dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:textSize="24sp"
                android:textColor="@color/mobile_text_primary"
                android:textStyle="bold"
                android:background="@drawable/bg_pin_box" />

        </LinearLayout>

        <!-- Hidden Input for keyboard handling -->
        <EditText
            android:id="@+id/pinHiddenInput"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <!-- Error Message -->
        <TextView
            android:id="@+id/txtPinError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ufm_denied"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            tools:text="Please enter all 4 digits" />

        <!-- Change PIN Link -->
        <TextView
            android:id="@+id/txtChangePin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_pin"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:layout_marginTop="12dp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />

        <!-- Recovery Code Link -->
        <TextView
            android:id="@+id/txtRecoveryCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/use_recovery_code"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Confirm / Start Server Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPinConfirm"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/start_server"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_check_circle"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/white" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPinCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:textAllCaps="false" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/tv_bg_gradient_end">

    <TextView
        android:id="@+id/txtPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/set_access_pin"
        android:textColor="@color/tv_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/txtPinSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_a_4digit_pin"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- 4 visual PIN digit boxes (TextViews — display only) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/pin1"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:textSize="22sp"
            android:textColor="@color/tv_text_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_pin_box"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/pin2"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:textSize="22sp"
            android:textColor="@color/tv_text_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_pin_box"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/pin3"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:textSize="22sp"
            android:textColor="@color/tv_text_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_pin_box"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/pin4"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:textSize="22sp"
            android:textColor="@color/tv_text_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_pin_box" />

    </LinearLayout>

    <!--
        Single invisible EditText that captures all 4 digits.
        Focus stays here permanently — the keyboard never has a reason to reset.
    -->
    <EditText
        android:id="@+id/pinHiddenInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:singleLine="true"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/txtPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ufm_denied"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- Change PIN Link -->
    <TextView
        android:id="@+id/txtChangePin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/change_pin"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

    <!-- Recovery Code Link -->
    <TextView
        android:id="@+id/txtRecoveryCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/use_recovery_code"
        android:textColor="@color/tv_text_hint"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    android:fillViewport="true"
    tools:context=".server.DlnaServerSettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/margin_md"
            android:paddingVertical="14dp"
            android:background="@color/mobile_glass_header">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle_accent">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/cd_back"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/mobile_icon_tint" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlna_server_settings"
                android:textColor="@color/mobile_text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginStart="@dimen/margin_md" />
        </LinearLayout>

        <!-- Form Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_md">

            <!-- Server Name Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card_dark"
                android:padding="@dimen/margin_md"
                android:layout_marginBottom="@dimen/margin_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_server_name_label"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_sm"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/mobile_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editServerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mobile_text_primary"
                        android:inputType="text"
                        android:maxLines="1"
                        android:hint="@string/dlna_server_name_default" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Renderer Name Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card_dark"
                android:padding="@dimen/margin_md"
                android:layout_marginBottom="@dimen/margin_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_renderer_name_label"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_sm"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/mobile_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editRendererName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mobile_text_primary"
                        android:inputType="text"
                        android:maxLines="1"
                        android:hint="@string/dlna_renderer_name_default" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Shared Folders Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card_dark"
                android:padding="@dimen/margin_md"
                android:layout_marginBottom="@dimen/margin_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_shared_folders_label"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Empty state -->
                <TextView
                    android:id="@+id/txtNoFolders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_no_folders_configured"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="@dimen/margin_sm"
                    android:visibility="visible" />

                <!-- Folder list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSharedFolders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_sm"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFolder"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_add_folder"
                    android:layout_marginTop="@dimen/margin_sm"
                    app:icon="@drawable/ic_folder" />
            </LinearLayout>

            <!-- Security Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dlna_security_warning"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:alpha="0.7"
                android:layout_marginBottom="@dimen/margin_md" />

            <!-- Port Display -->
            <TextView
                android:id="@+id/txtPortInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="@dimen/margin_md" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/save"
                android:textSize="16sp"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>

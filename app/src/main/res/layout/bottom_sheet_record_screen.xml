<?xml version="1.0" encoding="utf-8"?>
<!-- Record TV Screen — Premium Mobile Bottom Sheet (Re-Index Glassmorphic Standard) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:paddingHorizontal="@dimen/margin_xl"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Hero Icon Header -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/imgHeaderIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_record_screen"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/record_screen"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <!-- Subtitle / Save Location -->
    <TextView
        android:id="@+id/tvSaveLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="Saves to: Movies/Recordings"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="20dp" />

    <!-- Pre-recording Config Container -->
    <LinearLayout
        android:id="@+id/layoutConfigContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Audio Mic Toggle Card -->
        <LinearLayout
            android:id="@+id/cardMicToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_reindex_option_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icon_frosted"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/imgMicIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_screen_audio_title"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tvMicDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/record_screen_audio_enabled"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMicAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Max Duration Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAX RECORDING DURATION"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <!-- Segmented Duration Chips Row -->
        <LinearLayout
            android:id="@+id/layoutDurationChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/chip1Min"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/record_screen_1min"
                android:textColor="@color/mobile_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip3Min"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="@string/record_screen_3min"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip5Min"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/record_screen_5min"
                android:textColor="@color/mobile_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip10Min"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/record_screen_10min"
                android:textColor="@color/mobile_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active Recording Display Card (Shown during recording) -->
    <LinearLayout
        android:id="@+id/cardActiveRecording"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_reindex_option_card"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Pulsing Red REC Pill Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_badge_step_pill"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot"
                android:backgroundTint="#FFEF5350"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECORDING LIVE"
                android:textColor="#FFEF5350"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <!-- Large Countdown Clock -->
        <TextView
            android:id="@+id/tvCountdownClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/record_screen_preparing"
            android:textColor="@color/mobile_text_primary"
            android:textSize="36sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvRecordingStatusDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Start / Stop Recording Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartStop"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/record_screen_start"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_record_screen"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/white" />

    <!-- Exit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExit"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/record_screen_exit"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:textAllCaps="false" />

</LinearLayout>

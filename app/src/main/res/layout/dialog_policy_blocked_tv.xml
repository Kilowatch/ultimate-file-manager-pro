<?xml version="1.0" encoding="utf-8"?>
<!-- Premium TV Policy Blocked dialog.
     Uses yellow-focused indicators for interactive elements. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_dialog_surface"
    android:padding="28dp">

    <!-- Header Icon -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_tv_card_glass"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/imgPolicyIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            app:tint="@color/tv_button_focused_yellow"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/policy_blocked_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/policy_blocked_subtitle"
        android:textColor="@color/tv_button_focused_yellow"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="4dp" />

    <!-- Body text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/policy_blocked_message"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="2dp" />

    <!-- Technical Details (Optional) -->
    <TextView
        android:id="@+id/txtPolicyDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="10dp"
        android:background="#20FFFFFF"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- OK Button (TV focusable) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPolicyOk"
        style="@style/TvContinueButton"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:text="@string/btn_ok"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:focusable="true" />

</LinearLayout>

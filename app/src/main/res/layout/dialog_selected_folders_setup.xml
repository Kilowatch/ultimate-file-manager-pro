<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_xl"
    android:background="@drawable/bg_dialog_glass">

    <!-- Header: Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_setup_folders_title"
            android:textColor="@color/mobile_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:textAlignment="center"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_setup_folders_desc"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"
            android:textAlignment="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Count badge / status indicator -->
    <TextView
        android:id="@+id/txtSelectedCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        tools:text="2 folders selected" />

    <!-- Scrollable container for selected folders (bounded height) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <!-- Scrollable RecyclerView with bounded max height -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSelectedFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="260dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:clipToPadding="false"
            android:overScrollMode="always"
            tools:listitem="@layout/item_selected_folder" />

        <!-- Empty state hint -->
        <TextView
            android:id="@+id/txtNoFoldersHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="20dp"
            android:text="@string/no_folders_selected_hint"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"
            android:textAlignment="center"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Primary Action: + Add Folder / File Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddFolder"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:text="@string/btn_add_another_folder"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:cornerRadius="12dp"
        app:strokeColor="?attr/colorPrimary"
        android:textColor="?attr/colorPrimary"
        app:iconTint="?attr/colorPrimary" />

    <!-- Footer Buttons: Done & Fallback -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDoneSetup"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/btn_done"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@android:color/white"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAllFilesFallback"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:text="@string/perm_choice_all_files_title"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp" />

</LinearLayout>

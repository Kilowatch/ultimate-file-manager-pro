<?xml version="1.0" encoding="utf-8"?>
<!-- Paired TVs — Premium Mobile Screen (Material 3 Expressive & Glassmorphic Standard) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".ui.DevicePairingActivity">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mobile_glass_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_md"
        android:paddingVertical="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle_accent"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/mobile_icon_tint" />

        <!-- Title + Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="@string/paired_tvs"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/manage_tv_connections"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Add / Link TV Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddDevice"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/link_tv"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:textAllCaps="false"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp"
            app:iconTint="@color/white"
            android:paddingHorizontal="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

    <!-- Paired Devices List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPairedDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        tools:listitem="@layout/item_paired_device" />

    <!-- Premium Empty State & Onboarding Guide -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/margin_xl"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <!-- Hero TV Circle -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_badge_step_pill"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tv"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <!-- Empty Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paired_tvs_empty_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textAlignment="center" />

            <!-- Empty Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="320dp"
                android:text="@string/paired_tvs_empty_subtitle"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:textAlignment="center"
                android:layout_marginBottom="24dp" />

            <!-- 3-Step Setup Guide Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_reindex_option_card"
                android:layout_marginBottom="24dp">

                <!-- Guide Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_pairing_guide_title"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="16dp" />

                <!-- Step 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge_step_pill"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tv_pairing_guide_step1"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Step 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge_step_pill"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tv_pairing_guide_step2"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Step 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge_step_pill"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tv_pairing_guide_step3"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

            </LinearLayout>

            <!-- Hero Link Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinkTvEmpty"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/link_tv_button"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold"
                android:textAllCaps="false"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

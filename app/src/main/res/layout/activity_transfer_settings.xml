<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:elevation="4dp"
        android:background="?attr/colorSurfaceVariant">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/transfer_settings"
            android:textSize="18sp"
            android:textColor="@color/mobile_text_primary"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/txtSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/transfer_settings_select_all"
            android:textSize="14sp"
            android:textColor="@color/tv_button_focused_yellow"
            android:fontFamily="sans-serif-medium"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:textSize="13sp"
        android:textColor="@color/mobile_text_secondary" />

    <!-- Settings list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="80dp" />

    <!-- Transfer button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTransfer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="@string/transfer_to_tv"
        android:textSize="15sp"
        android:backgroundTint="@color/tv_button_focused_yellow"
        android:textColor="@color/tv_button_focused_yellow_text"
        style="@style/Widget.Material3.Button" />

</LinearLayout>

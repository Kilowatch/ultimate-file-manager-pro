<?xml version="1.0" encoding="utf-8"?>
<!--
    Local Network Protection Rationale Dialog — Android TV 10-Foot Layout
    Strictly adheres to UFMStandard:
    - Root background: @drawable/bg_dialog_glass (frosted glass)
    - Fixed TV width: 650dp
    - Title 22sp sans-serif-black, Subtitle 13sp
    - D-pad focusable buttons with selector_tv_button_yellow (primary) and selector_tv_button (secondary)
    - Embedded XML buttons stacked vertically
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="28dp">

    <!-- Header row: Icon + Title & Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="16dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cloud"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtLocalNetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/local_network_rationale_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/txtLocalNetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/local_network_rationale_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Frosted Message Box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_reindex_option_card"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/txtLocalNetMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/local_network_rationale_message"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />
    </FrameLayout>

    <!-- TV D-pad Action Buttons — Vertically stacked -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocalNetPrimary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/local_network_btn_continue"
            android:background="@drawable/selector_tv_button_yellow"
            app:backgroundTint="@null"
            android:textColor="@color/tv_button_focused_yellow_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:focusable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocalNetSecondary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="@string/local_network_btn_not_now"
            android:background="@drawable/selector_tv_button"
            app:backgroundTint="@null"
            android:textColor="@color/tv_button_text_selector"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Unpair Device Confirmation — Premium Mobile Dialog (Re-Index Glassmorphic Standard) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_xl"
    android:background="@drawable/bg_dialog_glass">

    <!-- Hero Trash Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_delete"
        app:tint="#FFEF5350"
        android:layout_marginBottom="@dimen/margin_md" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/remove_device"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <!-- Message -->
    <TextView
        android:id="@+id/txtConfirmMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/margin_sm"
        android:text="@string/are_you_sure_you_want_to_remove_devicename_from_paired_devices"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        android:textAlignment="center"
        android:layout_marginBottom="@dimen/margin_lg" />

    <!-- Unpair Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnpairConfirm"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/network_delete_confirm_yes"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        app:backgroundTint="#FFD32F2F"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_delete"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/white" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelUnpair"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:textAllCaps="false" />

</LinearLayout>

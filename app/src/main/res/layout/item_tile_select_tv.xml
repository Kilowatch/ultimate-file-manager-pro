<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="32dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/selector_tv_button_yellow">

    <!-- Checkbox -->
    <CheckBox
        android:id="@+id/chkTile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:clickable="false"
        android:focusable="false"
        android:scaleX="1.3"
        android:scaleY="1.3" />

    <!-- Icon circle -->
    <FrameLayout
        android:id="@+id/tileIconContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_icon_circle_accent">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/tv_accent" />
    </FrameLayout>

    <!-- Tile name -->
    <TextView
        android:id="@+id/tileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/selector_tv_button_text"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Source colour dots (5 dots showing what will be applied) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/dotRing"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_color_swatch" />

        <View
            android:id="@+id/dotTileBg"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_color_swatch" />

        <View
            android:id="@+id/dotIconColor"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_color_swatch" />

        <View
            android:id="@+id/dotIconBg"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_color_swatch" />

        <View
            android:id="@+id/dotLabel"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_color_swatch" />

    </LinearLayout>

</LinearLayout>

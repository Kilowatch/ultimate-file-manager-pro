<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile Text Viewer — premium dark glassmorphism design -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".viewer.TextViewerActivity">

    <!-- Glass Header Bar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle_accent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnConvertToPdf"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_icon_circle_accent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_file_pdf"
                android:contentDescription="@string/pdf_convert_title"
                app:tint="@android:color/white" />
        </FrameLayout>

        <!-- Search in document button -->
        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/search_in_document"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_icon_circle_accent"
            app:tint="@color/mobile_icon_tint" />

        <!-- Edit button -->
        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="@string/btn_edit_toggle"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_icon_circle_accent"
            app:tint="@android:color/white" />

        <!-- Save button (hidden by default) -->
        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_save"
            android:contentDescription="@string/btn_save"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:background="@drawable/bg_icon_circle_accent"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_md"
            android:textColor="@color/mobile_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            android:singleLine="true"
            android:ellipsize="middle"
            tools:text="document.txt" />
    </LinearLayout>

    <!-- Search Bar — hidden by default, toggled by btnSearch -->
    <LinearLayout
        android:id="@+id/layoutSearchBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/mobile_glass_header"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgSearchIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/mobile_text_secondary" />

        <EditText
            android:id="@+id/edtSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@null"
            android:singleLine="true"
            android:gravity="center_vertical"
            android:imeOptions="actionSearch"
            android:inputType="textNoSuggestions"
            android:textColor="@color/mobile_text_primary"
            android:textColorHint="@color/ufm_text_hint"
            android:hint="@string/search_in_document_hint" />

        <TextView
            android:id="@+id/txtSearchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/mobile_text_secondary"
            tools:text="0 of 0" />

        <ImageView
            android:id="@+id/btnSearchUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_up"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/mobile_text_secondary" />

        <ImageView
            android:id="@+id/btnSearchDown"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_down"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/mobile_text_secondary" />

        <ImageView
            android:id="@+id/btnSearchClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/mobile_text_secondary" />
    </LinearLayout>

    <!-- Loading progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="#FF0284C7"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchBar" />

    <!-- Content area: line numbers + scrollable text -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/paginationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <HorizontalScrollView
            android:id="@+id/hScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Line numbers gutter -->
                <TextView
                    android:id="@+id/txtLineNumbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingVertical="12dp"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textColor="#55FFFFFF"
                    android:gravity="end"
                    android:background="#10FFFFFF"
                    android:visibility="gone" />

                <!-- File content (EditText for editing) -->
                <EditText
                    android:id="@+id/txtContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textColor="@color/mobile_text_primary"
                    android:background="@null"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:enabled="false"
                    android:focusable="false"
                    android:visibility="gone" />

            </LinearLayout>
        </HorizontalScrollView>
    </ScrollView>

    <!-- Pagination bar — hidden when file fits in one page -->
    <LinearLayout
        android:id="@+id/paginationBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:background="@color/mobile_glass_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnPrevPage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/mobile_text_secondary" />

        <TextView
            android:id="@+id/txtPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="14sp"
            tools:text="Page 1 / 5" />

        <ImageView
            android:id="@+id/btnNextPage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/mobile_text_secondary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Authorize Elevated Access — Premium TV Dialog -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/bg_dialog_glass">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_shield_protected"
        app:tint="?attr/colorPrimary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/shizuku_auth_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/txtDialogMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:text="@string/shizuku_auth_msg"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnAuthorize"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="180dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/selector_tv_button_yellow"
            android:textColor="@color/tv_button_focused_yellow_text"
            android:textSize="16sp"
            android:fontFamily="sans-serif-black"
            android:text="@string/shizuku_btn_authorize"
            android:focusable="true" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="140dp"
            android:background="@drawable/selector_tv_button"
            android:textColor="@color/tv_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/cancel"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>

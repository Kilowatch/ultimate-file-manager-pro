<?xml version="1.0" encoding="utf-8"?>
<!-- Premium TV VPN warning dialog.
     Uses solid surface background matching TV design language.
     Close button supports D-pad focus with yellow highlight. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_surface"
    android:clipToOutline="true"
    android:padding="0dp">

    <!-- Amber accent top bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:background="#FFFFA726" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Icon + Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Amber warning circle icon -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_warning_circle"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_vpn_warning"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVpnTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vpn_warning_title"
                    android:textColor="@color/ufm_text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/txtVpnSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/vpn_warning_subtitle"
                    android:textColor="@color/ufm_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginBottom="16dp" />

        <!-- Body text -->
        <TextView
            android:id="@+id/txtVpnMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vpn_warning_message"
            android:textColor="@color/ufm_text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />

        <!-- Action buttons — right-aligned, focusable for D-pad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVpnContinue"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/vpn_warning_continue"
                android:textColor="#FFFFA726"
                android:textSize="14sp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:layout_marginEnd="12dp"
                app:strokeColor="#FFFFA726"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVpnClose"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/vpn_warning_close"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                app:backgroundTint="#FFFFA726"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

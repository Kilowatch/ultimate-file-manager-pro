<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke"
    app:cardBackgroundColor="@color/mobile_glass_card"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- File Type Icon Badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_file"
                app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Information Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp">

            <!-- Extension Header -->
            <TextView
                android:id="@+id/txtExtension"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=".MP4"
                android:textColor="@color/mobile_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold" />

            <!-- Context and Action -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/txtContextBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Local"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold"
                    android:background="@drawable/bg_btn_icon_frosted"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/txtDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UFM Player"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="12.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Delete Action Button -->
        <FrameLayout
            android:id="@+id/btnRemoveContainer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_icon_danger">

            <ImageView
                android:id="@+id/btnRemove"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_error"
                android:contentDescription="@string/action_clear" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

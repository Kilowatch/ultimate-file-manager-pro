<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tipJarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Toolbar: back button + coffee icon + title/subtitle -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_coffee"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_jar_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loyalty_card_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable content below toolbar -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_horizontal">

            <!-- Transparency blurb -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_jar_transparency"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.3"
                    android:padding="10dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Loyalty Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Progress labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_amount_tipped_label"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.8"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtGoalTarget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_goal_static"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Progress bar -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:max="15"
                        android:progressTint="?attr/colorPrimary"
                        android:progressBackgroundTint="?attr/colorOnPrimaryContainer"
                        android:layout_marginBottom="6dp" />

                    <!-- Tipped / to-go -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/txtTippedTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_tipped_format"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtToGoTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_to_go_format"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Stamps Grid (5 x 3) -->
                    <GridLayout
                        android:id="@+id/gridStamps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:rowCount="3"
                        android:columnCount="5"
                        android:alignmentMode="alignBounds"
                        android:useDefaultMargins="true" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="10dp"
                        android:background="?attr/colorOnPrimaryContainer"
                        android:alpha="0.2" />

                    <!-- Member status + tier badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/loyalty_status_label"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:alpha="0.7"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/txtMemberTier"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/loyalty_tier_free"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtTierBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_tier_badge_format"
                            android:background="@drawable/bg_icon_circle_accent"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnPrimary"
                            android:backgroundTint="?attr/colorPrimary"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Global Progress Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGlobalProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtGlobalTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tip_jar_global_title"
                        android:textColor="@color/tile_tip_jar_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/txtGlobalDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tip_jar_global_desc"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="10sp"
                        android:alpha="0.7" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <ProgressBar
                            android:id="@+id/progressGlobal"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progressDrawable="@drawable/bg_tip_jar_progress" />

                        <TextView
                            android:id="@+id/txtGlobalPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/tile_tip_jar_accent"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stat Tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    android:layout_marginEnd="5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_stat_total_label"
                            android:textSize="10sp"
                            android:alpha="0.7" />
                        <TextView
                            android:id="@+id/txtStatTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_currency_format"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    android:layout_marginHorizontal="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_stat_coffees_label"
                            android:textSize="10sp"
                            android:alpha="0.7" />
                        <TextView
                            android:id="@+id/txtStatCoffees"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_value_format"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    android:layout_marginStart="5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/txtStatGoalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_stat_to_goal_label"
                            android:textSize="10sp"
                            android:alpha="0.7" />
                        <TextView
                            android:id="@+id/txtStatGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_currency_format"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Loading indicator -->
            <TextView
                android:id="@+id/txtTipLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tip_jar_loading"
                android:gravity="center"
                android:layout_marginBottom="6dp"
                android:alpha="0.6"
                android:textSize="12sp" />

            <!-- Tip buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEspresso"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/tip_jar_espresso_title"
                    android:layout_marginBottom="5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLatte"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/tip_jar_latte_title"
                    android:layout_marginBottom="5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBeans"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/tip_jar_beans_title" />
            </LinearLayout>

            <!-- Thank you message -->
            <TextView
                android:id="@+id/txtThankYou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tip_jar_thanks"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <!-- Footer disclaimer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/loyalty_disclaimer"
                android:textSize="10sp"
                android:alpha="0.5"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

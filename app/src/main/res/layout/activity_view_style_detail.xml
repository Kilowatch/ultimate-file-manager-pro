<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient">

    <!-- Glass Header Bar (56dp standard) -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button in Frosted Squircle -->
        <FrameLayout
            android:id="@+id/btnBackContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

        <!-- Title + Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/txtToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_appearance_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                tools:text="Customize List: Medium" />

            <TextView
                android:id="@+id/txtToolbarSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_appearance_subtitle"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/btn_save_settings"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="20dp"
            android:backgroundTint="?attr/colorPrimary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <!-- Pinned Live Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Live Preview Header Tag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_preview_label"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/txtPreviewDimensions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="48 dp · 16 sp" />
            </LinearLayout>

            <!-- Embedded List Item Preview -->
            <FrameLayout
                android:id="@+id/containerListPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_reindex_option_card">

                <include
                    android:id="@+id/previewItemFile"
                    layout="@layout/item_file" />
            </FrameLayout>

            <!-- Embedded Grid Row Preview -->
            <LinearLayout
                android:id="@+id/containerGridPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scrollable Steppers Section -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardPreviewContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Steppers for List Mode -->
            <LinearLayout
                android:id="@+id/layoutListSteppers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperThumbSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperPadH"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperPadV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperSpacing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperTextPri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperTextSec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperCornerRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Steppers for Grid Mode -->
            <LinearLayout
                android:id="@+id/layoutGridSteppers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperGridColWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperGridMargin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperGridCorner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperGridTextPri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <za.kilowatch.ultimatefilemanager.ui.NumberStepperView
                    android:id="@+id/stepperGridIconPadding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Reset to Default Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetDefault"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/view_reset_to_default"
                android:textAllCaps="false"
                android:textColor="@color/status_error"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="14dp"
                app:strokeColor="@color/status_error"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

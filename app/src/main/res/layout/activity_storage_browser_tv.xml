<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".storage.StorageBrowserActivity">

    <!-- Header Section — strictly above the list -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingTop="@dimen/margin_xxl"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_storage_browser_logo"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/txtStorageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/storage_title"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="30sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.02" />

                    <!-- Cyan accent underline -->
                    <View
                        android:layout_width="60dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/tv_accent" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- View Mode Toggle Container for TV -->
                <LinearLayout
                    android:id="@+id/layoutToggleViewMode"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_view_toggle_container"
                    android:padding="4dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btnToggleGrid"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_grid_view_custom"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@android:color/transparent"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/btnToggleList"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_list_view_custom"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@android:color/transparent"
                        app:tint="@color/white" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnManageTiles"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_tune"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selector_tv_button_yellow"
                    app:tint="@color/selector_tv_button_text"
                    android:visibility="gone"
                    android:layout_marginEnd="12dp" />

                <!-- Palette button — visible in edit mode only -->
                <ImageView
                    android:id="@+id/btnColorTile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_palette"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selector_tv_button_yellow"
                    app:tint="@color/selector_tv_button_text"
                    android:visibility="gone"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/tile_color_title" />

                <!-- Import Code button — visible in edit mode only -->
                <ImageView
                    android:id="@+id/btnImportColorCode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_import_code"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selector_tv_button_yellow"
                    app:tint="@color/selector_tv_button_text"
                    android:visibility="gone"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/tile_color_import" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDone"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/done"
                    android:textColor="@color/selector_tv_button_text"
                    android:fontFamily="sans-serif-black"
                    android:textSize="16sp"
                    app:backgroundTint="@color/selector_tv_button_yellow"
                    app:cornerRadius="16dp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/txtStorageSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════
         TIP JAR TV NOTIFICATION BAR
         ══════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tipJarTvNotification"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="@dimen/tv_safe_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        android:focusable="false"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/tv_glass_white_10"
        app:strokeWidth="1dp"
        app:strokeColor="@color/tv_glass_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <!-- Icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tip_jar_glow"
                android:contentDescription="@null"
                android:focusable="false"
                android:layout_marginEnd="10dp" />

            <!-- Title (month) -->
            <TextView
                android:id="@+id/txtTvTipJarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textColor="@color/tile_tip_jar_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginEnd="12dp" />

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/progressTvTipJar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:focusable="false"
                android:progressDrawable="@drawable/bg_tip_jar_progress" />

            <!-- Percentage -->
            <TextView
                android:id="@+id/txtTvTipJarPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textColor="@color/tile_tip_jar_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginStart="12dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════ -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <!-- Storage List and Scrollbar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:clipChildren="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStorage"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:clipToPadding="true"
                android:paddingTop="16dp"
                android:paddingHorizontal="@dimen/tv_safe_horizontal"
                android:descendantFocusability="afterDescendants"
                tools:listitem="@layout/item_storage_card_tv" />



        </LinearLayout>

        <!-- Empty State overlay -->
        <LinearLayout
            android:id="@+id/layoutEmptyStorage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieEmptyStorage"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:contentDescription="@null"
                app:lottie_rawRes="@raw/anim_empty_storage"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <TextView
                android:id="@+id/txtEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/storage_no_storages"
                android:textColor="@color/tv_text_hint"
                android:textSize="@dimen/tv_text_body"
                android:textAlignment="center" />

        </LinearLayout>
    </FrameLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Security Required — Premium Glassmorphic Dialog -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_xl"
    android:background="@drawable/bg_dialog_glass">

    <!-- Hero Lock Icon -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/security_required_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <!-- Subtitle / Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:text="@string/security_required_desc"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <!-- Open Settings Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenSettings"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/open_picker"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="?attr/colorOnPrimary" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:textAllCaps="false" />

</LinearLayout>

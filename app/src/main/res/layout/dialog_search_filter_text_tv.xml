<?xml version="1.0" encoding="utf-8"?>
<!-- TV: Shared text-input filter dialog (Extension) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/bg_tv_dialog_surface">

    <TextView
        android:id="@+id/txtFilterTextTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editFilterText"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_hint"
        android:textSize="16sp"
        android:background="@drawable/selector_tv_button_yellow"
        android:paddingHorizontal="16dp"
        android:inputType="text"
        android:singleLine="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_marginBottom="28dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnTextCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/cancel"
            android:paddingHorizontal="24dp"
            android:textColor="@color/tv_text_primary"
            android:background="@drawable/selector_tv_button_yellow"
            android:focusable="true"
            android:focusableInTouchMode="false" />

        <Button
            android:id="@+id/btnTextApply"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:text="@string/search_filter_apply"
            android:paddingHorizontal="24dp"
            android:textColor="@color/tv_text_primary"
            android:background="@drawable/selector_tv_button_yellow"
            android:focusable="true"
            android:focusableInTouchMode="false" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- TV Prominent Disclosure dialog.
     Glass background, fixed width, yellow focus on interactive elements. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="600dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Header Icon -->
    <ImageView
        android:id="@+id/imgPdIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_lock"
        app:tint="@color/tv_button_focused_yellow"
        android:contentDescription="@null"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/txtPdTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/pd_dialog_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Body Text -->
    <TextView
        android:id="@+id/txtPdBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="@string/pd_dialog_body"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Cancel button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPdCancel"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:text="@string/cancel"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/tv_glass_white_10"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:focusable="true" />

        <!-- I Understand button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPdAccept"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:text="@string/pd_accept"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/tv_glass_white_10"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>

                            android:layout_height="36dp"
                            android:src="@drawable/ic_photo_video"
                            android:layout_marginEnd="@dimen/margin_lg"
                            app:tint="@color/tv_icon_tint"
                            android:contentDescription="@null" />

                        <LinearLayout

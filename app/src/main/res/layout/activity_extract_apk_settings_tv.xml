                                android:layout_height="wrap_content"
                                android:text="@string/apk_extract_icon_summary"
                                android:textColor="@color/tv_text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial

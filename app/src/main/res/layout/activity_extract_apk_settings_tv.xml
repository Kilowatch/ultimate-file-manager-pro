                    app:cardCornerRadius="@dimen/card_radius_lg"
                    app:cardElevation="0dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/tv_glass_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/margin_xl"
                        android:background="@drawable/bg_glass_card">

                        <CheckBox
                            android:id="@+id/checkFieldHasObb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/field_has_obb"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="20sp"
                            android:layout_marginStart="@dimen/margin_lg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFieldPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:foreground="@drawable/selector_tv_card"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/card_radius_lg"
                    app:cardElevation="0dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/tv_glass_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/margin_xl"
                        android:background="@drawable/bg_glass_card">

                        <CheckBox
                            android:id="@+id/checkFieldPermissions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/field_permissions"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="20sp"
                            android:layout_marginStart="@dimen/margin_lg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Manage Tiles bottom sheet — lists ONLY hidden tiles with Restore chips.
    Each row is tappable to open the tile directly.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tune"
                app:tint="@color/ufm_primary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/manage_tiles_title"
                android:textColor="@color/ufm_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:background="@color/ufm_surface_variant" />

        <!-- ════════════════════════ HIDDEN TILES SECTION ════════════════════════ -->
        <TextView
            android:id="@+id/txtHiddenSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:text="@string/manage_tiles_hidden_section"
            android:textColor="@color/ufm_primary"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium" />

        <!-- Hint: tap row to open, tap Restore chip to show on main screen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:text="@string/tap_a_tile_to_open"
            android:textColor="@color/ufm_text_secondary"
            android:textSize="11sp" />

        <!-- "No hidden tiles" empty state -->
        <TextView
            android:id="@+id/txtNoHiddenTiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/manage_tiles_no_hidden"
            android:textColor="@color/ufm_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Hidden tile rows -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHiddenTiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Restore All button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreAll"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:text="@string/manage_tiles_restore_all"
            android:textColor="@color/ufm_primary"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

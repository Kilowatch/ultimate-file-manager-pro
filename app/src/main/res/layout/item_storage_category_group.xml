<?xml version="1.0" encoding="utf-8"?>
<!--
    Modern Categorized Outer Card Group for Mobile Main Menu.
    Matches images/expanded.jpg:
    - 24dp corner radius, mobile_glass_card background, 1dp mobile_glass_stroke.
    - Category header with squircle icon badge, title with inline count (collapsed)
      or subtitle count (expanded), and chevron.
    - Summary capacity metrics and progress bar on Storage when collapsed.
    - Highlighted header when expanded (with rounded top corners).
    - Seamless nested items container for child tiles (paddingHorizontal=0dp).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategoryGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:rippleColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Category Header Row -->
        <LinearLayout
            android:id="@+id/layoutCategoryHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Category Squircle Icon Badge -->
            <FrameLayout
                android:id="@+id/iconContainerCategory"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_squircle_category_icon">

                <ImageView
                    android:id="@+id/imgCategoryIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_storage_internal"
                    app:tint="@color/mobile_icon_tint"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- Title & Subtitle column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp">

                <!-- Title Row: category title + inline item count (when collapsed) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtCategoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mobile_card_text_primary"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.01"
                        tools:text="Storage" />

                    <TextView
                        android:id="@+id/txtCategoryInlineCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="7 items" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCategorySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/mobile_card_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone"
                    tools:text="4 items" />

                <!-- Summary progress bar for collapsed Storage category -->
                <ProgressBar
                    android:id="@+id/progressCategoryStorage"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="6dp"
                    android:progressDrawable="@drawable/bg_storage_progress_cyan"
                    android:visibility="gone"
                    tools:progress="55"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Edit Mode Delete Button (for custom categories) -->
            <ImageView
                android:id="@+id/btnDeleteCategoryHeader"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:background="@drawable/bg_btn_icon_frosted"
                android:src="@drawable/ic_close"
                app:tint="@color/mobile_icon_tint"
                android:contentDescription="@string/custom_header_delete_title"
                android:visibility="gone"
                android:layout_marginEnd="8dp" />

            <!-- Expand / Collapse Chevron Indicator -->
            <ImageView
                android:id="@+id/imgCategoryChevron"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/mobile_card_text_secondary"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- Seamless Nested Items Container -->
        <LinearLayout
            android:id="@+id/layoutCategoryItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Storage Analyzer Activity — Language & Grouped Glass Card Standard
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".storage.StorageAnalyzerActivity">

    <!-- TV Fixed 72dp Glass Header Bar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:background="@color/tv_glass_white_10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_icon_btn"
            android:nextFocusDown="@id/tabLayout"
            app:tint="@color/selector_tv_icon_tint_yellow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analyzer_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analyzer_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Drive spinner inline in header on TV -->
        <Spinner
            android:id="@+id/spinnerDrive"
            android:layout_width="220dp"
            android:layout_height="44dp"
            android:background="@drawable/selector_tv_button_yellow"
            android:paddingHorizontal="12dp"
            android:popupBackground="@color/tv_dialog_background"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@id/tabLayout" />
    </LinearLayout>

    <!-- Loading progress -->
    <ProgressBar
        android:id="@+id/progressScanning"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/tv_accent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Not indexed banner -->
    <TextView
        android:id="@+id/txtNotIndexedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="6dp"
        android:text="@string/analyzer_not_indexed_banner"
        android:textColor="@color/ufm_risk_moderate"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressScanning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tab Bar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tv_glass_white_10"
        app:tabTextColor="@color/tv_text_secondary"
        app:tabSelectedTextColor="@color/tv_accent"
        app:tabIndicatorColor="@color/tv_accent"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabBackground="@drawable/selector_tv_button_yellow"
        app:tabPaddingStart="24dp"
        app:tabPaddingEnd="24dp"
        app:tabMinWidth="120dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:nextFocusDown="@id/viewPager"
        app:layout_constraintTop_toBottomOf="@id/txtNotIndexedBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:nextFocusUp="@id/tabLayout"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Delete FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabDeleteDuplicates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/analyzer_delete_selected"
        android:textColor="@color/selector_tv_fab_text"
        app:icon="@drawable/ic_delete"
        app:iconTint="@color/selector_tv_fab_text"
        app:backgroundTint="@color/selector_tv_fab_bg"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

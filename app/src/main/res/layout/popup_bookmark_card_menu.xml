<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="215dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_dropdown_glass"
    android:elevation="12dp"
    android:padding="6dp">

    <!-- Read Article -->
    <LinearLayout
        android:id="@+id/menuItemReadArticle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_file_ebook"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/bookmark_action_open_reader"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Open in Browser -->
    <LinearLayout
        android:id="@+id/menuItemOpenBrowser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_link"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/bookmark_action_open_browser"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Copy Link / Content -->
    <LinearLayout
        android:id="@+id/menuItemCopy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_copy"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtCopyLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/copy_link"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Save to Storage -->
    <LinearLayout
        android:id="@+id/menuItemSaveToStorage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_download"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/bookmark_action_save_to_storage"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Move to Collection -->
    <LinearLayout
        android:id="@+id/menuItemMoveGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_folder"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/bookmark_action_move_group"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- View Note (visible if item has note) -->
    <LinearLayout
        android:id="@+id/menuItemViewNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notepad"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/bookmark_view_note"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="4dp"
        android:background="@color/mobile_glass_stroke" />

    <!-- Delete -->
    <LinearLayout
        android:id="@+id/menuItemDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_header_action_ripple">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_delete"
            app:tint="#EF4444"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/delete"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</LinearLayout>

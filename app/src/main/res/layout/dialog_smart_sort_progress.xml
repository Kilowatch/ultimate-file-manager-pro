<?xml version="1.0" encoding="utf-8"?>
<!--
    Smart Sort Progress Dialog — Mobile (Language & Grouped Glass Card Standard)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/imgHeroIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/smart_sort_start"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:indeterminate="false"
        android:progressTint="?attr/colorPrimary"
        android:progressBackgroundTint="@color/mobile_glass_stroke"
        android:layout_marginBottom="12dp"
        tools:progress="45" />

    <!-- Progress Status Text -->
    <TextView
        android:id="@+id/txtProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"
        tools:text="Sorting file 14 of 50…" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/cancel"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        android:textColor="@color/mobile_text_secondary" />

</LinearLayout>

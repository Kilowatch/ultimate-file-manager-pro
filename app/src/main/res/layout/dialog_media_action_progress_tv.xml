<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="@drawable/bg_dialog_glass">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="24dp">

        <ProgressBar
            android:id="@+id/progressBarCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/bg_premium_progress" />

        <ImageView
            android:id="@+id/imgMediaProgressIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_convert_video"
            app:tint="@color/tv_accent"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtProgressTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/extracting_subtitles"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        tools:text="Extracting subtitle track…" />

    <TextView
        android:id="@+id/txtProgressSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp"
        android:textAlignment="center"
        android:singleLine="true"
        android:ellipsize="middle"
        tools:text="video_sample.mkv" />
</LinearLayout>

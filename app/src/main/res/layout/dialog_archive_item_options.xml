<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile Archive Item Options BottomSheet -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@color/ufm_text_secondary"
        android:alpha="0.3"
        android:clipToOutline="true" />

    <TextView
        android:id="@+id/txtItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ufm_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:ellipsize="middle"
        android:layout_marginBottom="20dp"
        tools:text="sample_file.pdf" />

    <!-- Action 1: Extract / Copy Out -->
    <LinearLayout
        android:id="@+id/btnExtractTo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_export"
            app:tint="@color/ufm_text_primary"
            android:contentDescription="@string/action_copy_out" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/action_copy_out"
            android:textColor="@color/ufm_text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Action 2: Move Out of Archive -->
    <LinearLayout
        android:id="@+id/btnMoveOut"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_move"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@string/action_move_out" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/action_move_out"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Action 3: Delete from Archive -->
    <LinearLayout
        android:id="@+id/btnDeleteFromArchive"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/ufm_error"
            android:contentDescription="@string/action_delete_from_archive" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/action_delete_from_archive"
            android:textColor="@color/ufm_error"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Download Manager & P2P Notice Dialog — Android TV Layout (UFMStandard)
    Widescreen 16:9 layout with 3-column disclosure cards and horizontal action buttons
    designed to fit completely on TV screens (540dp / 480dp) without vertical clipping.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="720dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingVertical="16dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- Header with Icon & Title (Horizontal for TV height efficiency) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/tv_accent"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_legal_gate_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_legal_gate_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable content area for edge cases / low screen heights -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Frosted Notice Card containing 3 structured disclosure points side-by-side -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tv_glass_white_10"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/tv_glass_border_strong"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <!-- Section 1: P2P Swarm & IP Visibility -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_network"
                                app:tint="@color/tv_accent"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/download_legal_p2p_swarm_title"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/download_legal_p2p_swarm_desc"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="11sp"
                            android:lineSpacingExtra="1.5dp"
                            android:layout_marginTop="5dp" />
                    </LinearLayout>

                    <!-- Divider 1 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/tv_divider"
                        android:layout_marginHorizontal="10dp" />

                    <!-- Section 2: Zero-Seeding Privacy -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_shield_check"
                                app:tint="@color/tv_accent"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/download_legal_zero_seeding_title"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/download_legal_zero_seeding_desc"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="11sp"
                            android:lineSpacingExtra="1.5dp"
                            android:layout_marginTop="5dp" />
                    </LinearLayout>

                    <!-- Divider 2 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/tv_divider"
                        android:layout_marginHorizontal="10dp" />

                    <!-- Section 3: Lawful Use Only -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/tv_accent"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/download_legal_lawful_use_title"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/download_legal_lawful_use_desc"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="11sp"
                            android:lineSpacingExtra="1.5dp"
                            android:layout_marginTop="5dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Interactive Agreement Checkbox Row Card -->
            <LinearLayout
                android:id="@+id/cardLegalAgree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_tv_reindex_option_card"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/btnLegalContinue"
                android:layout_marginBottom="12dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkLegalAgree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    app:buttonTint="@color/selector_tv_button_text_yellow" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/download_legal_gate_agree_check"
                    android:textColor="@color/selector_tv_button_text_yellow"
                    android:duplicateParentState="true"
                    android:textSize="12sp"
                    android:lineSpacingExtra="1.5dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- TV Action Buttons (Horizontal: Cancel on left, Agree & Continue on right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLegalCancel"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:background="@drawable/selector_tv_button"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/tv_button_text_selector"
            android:textSize="14sp"
            android:focusable="true"
            android:nextFocusUp="@id/cardLegalAgree"
            android:nextFocusRight="@id/btnLegalContinue"
            android:textAllCaps="false"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLegalContinue"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/download_legal_continue"
            android:background="@drawable/selector_tv_button_yellow"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/tv_button_text_selector"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:focusable="true"
            android:nextFocusUp="@id/cardLegalAgree"
            android:nextFocusLeft="@id/btnLegalCancel"
            android:enabled="false"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>

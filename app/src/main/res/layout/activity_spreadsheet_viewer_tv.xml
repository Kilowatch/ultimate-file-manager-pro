<?xml version="1.0" encoding="utf-8"?>
<!-- TV Spreadsheet Viewer — premium dark theme with D-pad focus grid support -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".viewer.SpreadsheetViewerActivity">

    <!-- TV Header Bar -->
    <LinearLayout
        android:id="@+id/layoutTvHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="48dp"
        android:background="@color/tv_glass_white_10"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_icon_btn" />

        <!-- Rotate Button for TV -->
        <ImageView
            android:id="@+id/btnRotate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_rotate_right"
            android:contentDescription="@string/spreadsheet_rotate_screen"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            app:tint="@color/tv_text_primary"
            android:background="@drawable/selector_tv_icon_btn" />

        <!-- Convert to PDF Button -->
        <ImageView
            android:id="@+id/btnConvertToPdf"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_file_pdf"
            android:contentDescription="@string/pdf_convert_title"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            app:tint="@color/tv_text_primary"
            android:background="@drawable/selector_tv_icon_btn" />

        <!-- Search in document button (TV) -->
        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/search_in_document"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            app:tint="@color/tv_text_primary"
            android:background="@drawable/selector_tv_icon_btn" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:textColor="@color/tv_text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:singleLine="true"
            android:ellipsize="middle"
            tools:text="spreadsheet.xlsx" />
    </LinearLayout>

    <!-- Search Bar — hidden by default, toggled by btnSearch -->
    <LinearLayout
        android:id="@+id/layoutSearchBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="48dp"
        android:background="@color/tv_glass_white_10"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSearchIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            app:tint="@color/tv_text_secondary" />

        <EditText
            android:id="@+id/edtSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:background="@null"
            android:singleLine="true"
            android:gravity="center_vertical"
            android:imeOptions="actionSearch"
            android:inputType="textNoSuggestions"
            android:textColor="@color/tv_text_primary"
            android:textColorHint="@color/tv_text_hint"
            android:hint="@string/search_in_document_hint" />

        <TextView
            android:id="@+id/txtSearchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/tv_text_secondary"
            tools:text="0 of 0" />

        <ImageView
            android:id="@+id/btnSearchUp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_up"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            app:tint="@color/tv_text_primary"
            android:background="@drawable/selector_tv_icon_btn" />

        <ImageView
            android:id="@+id/btnSearchDown"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_down"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            app:tint="@color/tv_text_primary"
            android:background="@drawable/selector_tv_icon_btn" />

        <ImageView
            android:id="@+id/btnSearchClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            app:tint="@color/tv_text_primary"
            android:background="@drawable/selector_tv_icon_btn" />
    </LinearLayout>

    <!-- Loading progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:progressTint="@color/tv_accent"
        android:visibility="gone" />

    <!-- Sheet Tabs Bar -->
    <HorizontalScrollView
        android:id="@+id/sheetTabsScroll"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#15FFFFFF"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        android:focusable="false">

        <LinearLayout
            android:id="@+id/sheetTabsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="48dp"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Scrollable Content with Focus Border -->
    <FrameLayout
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="16dp"
        android:padding="4dp"
        android:background="@drawable/selector_tv_policy_scroll"
        android:focusable="false">

        <ScrollView
            android:id="@+id/tableScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="48dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@color/tv_button_focused_yellow"
            android:focusable="false">

            <HorizontalScrollView
                android:id="@+id/tableHScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:focusable="false">

                <TableLayout
                    android:id="@+id/tableLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp" />
            </HorizontalScrollView>
        </ScrollView>
    </FrameLayout>

</LinearLayout>

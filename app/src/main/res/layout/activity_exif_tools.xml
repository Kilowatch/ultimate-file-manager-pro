<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:elevation="0dp">

        <!-- Top Header Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="?android:attr/textColorPrimary"
                android:contentDescription="@string/back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exif_tools_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPhotoCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    tools:text="3 Photos Selected" />

            </LinearLayout>

        </LinearLayout>

        <!-- Selected Photos Horizontal Carousel -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerThumbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_exif_photo_thumb" />

        <!-- Tab Selector: Inspect | Clean | Rename -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_bottom_sheet"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextColor="?android:attr/textColorSecondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exif_tab_inspect" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exif_tab_clean" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exif_tab_rename" />

        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- ══════════════════ TAB 1: INSPECT ══════════════════ -->
            <LinearLayout
                android:id="@+id/layoutInspect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp">

                <!-- 📍 Location & Geotags Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_card_location"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCoordinates"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp"
                            tools:text="37.77490, -122.41940 (Alt: 15.2m)" />

                        <LinearLayout
                            android:id="@+id/layoutLocationActions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnViewMap"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/exif_btn_view_map"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRemoveGpsSingle"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/exif_btn_remove_gps_single"
                                app:cornerRadius="10dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 📷 Camera & Optics Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_card_camera"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCameraMakeModel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Sony ILCE-7M4" />

                        <TextView
                            android:id="@+id/txtLensModel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp"
                            tools:text="FE 24-70mm F2.8 GM II" />

                        <TextView
                            android:id="@+id/txtExposureSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp"
                            tools:text="50mm · f/2.8 · 1/500s · ISO 100" />

                        <TextView
                            android:id="@+id/txtOpticsExtra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"
                            tools:text="Flash: Off · White Balance: Auto" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 🕒 Date & Timestamps Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_card_date"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDateTaken"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            tools:text="Taken: 2026-08-19 14:30:22" />

                        <TextView
                            android:id="@+id/txtDateDigitized"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp"
                            tools:text="Digitized: 2026-08-19 14:30:22" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 📄 Device & Personal Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_card_file"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDimensions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp"
                            tools:text="Dimensions: 6000 × 4000 (24.0 MP)" />

                        <TextView
                            android:id="@+id/txtSoftware"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp"
                            tools:text="Software: Adobe Lightroom v14.2" />

                        <TextView
                            android:id="@+id/txtAuthorCopyright"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp"
                            tools:text="Artist: John Doe" />

                        <TextView
                            android:id="@+id/txtUserComment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp"
                            tools:text="Comment: HDR Portrait" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Single Photo Wipe Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWipeSingle"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/exif_btn_wipe_all_single"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_exif_cleaner" />

            </LinearLayout>

            <!-- ══════════════════ TAB 2: PRIVACY CLEANER ══════════════════ -->
            <LinearLayout
                android:id="@+id/layoutClean"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:visibility="gone">

                <!-- Preset Radio Group -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exif_clean_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgCleanPresets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbCleanFull"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/exif_clean_preset_full"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/exif_clean_preset_full_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbCleanGpsOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/exif_clean_preset_gps_only"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/exif_clean_preset_gps_only_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbCleanCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/exif_clean_preset_custom"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </RadioGroup>

                <!-- Custom Checkbox Options -->
                <LinearLayout
                    android:id="@+id/layoutCustomCleanOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/chkCleanGps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/exif_clean_opt_gps" />

                    <CheckBox
                        android:id="@+id/chkCleanDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/exif_clean_opt_device" />

                    <CheckBox
                        android:id="@+id/chkCleanAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/exif_clean_opt_author" />

                    <CheckBox
                        android:id="@+id/chkCleanDates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/exif_clean_opt_date" />

                    <CheckBox
                        android:id="@+id/chkCleanCamera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/exif_clean_opt_camera" />

                </LinearLayout>

                <!-- Output Destination -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/compress_image_output"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbDestOverwrite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/exif_destination_overwrite" />

                    <RadioButton
                        android:id="@+id/rbDestCopy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/exif_destination_copy" />

                    <RadioButton
                        android:id="@+id/rbDestFolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/exif_destination_folder" />

                </RadioGroup>

                <LinearLayout
                    android:id="@+id/layoutOutputFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtOutputFolderPath"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        tools:text="/storage/emulated/0/Pictures/Cleaned" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickOutputFolder"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/change"
                        app:cornerRadius="8dp" />

                </LinearLayout>

                <!-- Clean Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartClean"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/exif_btn_start_cleaning"
                    android:textSize="15sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_exif_cleaner" />

            </LinearLayout>

            <!-- ══════════════════ TAB 3: BATCH RENAMER ══════════════════ -->
            <LinearLayout
                android:id="@+id/layoutRename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:visibility="gone">

                <!-- Pattern Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPattern"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/exif_rename_pattern_label"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPattern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="{YYYY}-{MM}-{DD}_{hh}-{mm}-{ss}_{ORIGINAL}"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Quick Presets -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPresetDateOriginal"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_preset_date_original" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPresetDateOnly"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_preset_date_only" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPresetCameraDate"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_preset_camera_date" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <!-- Token Insert Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTokenYear"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_token_year" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTokenMonth"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_token_month" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTokenDay"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_token_day" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTokenTime"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_token_time" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTokenModel"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_token_model" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTokenOriginal"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_token_original" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTokenSeq"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exif_rename_token_seq" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <!-- Live Rename Preview Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/exif_rename_preview_header"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Live Preview RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRenamePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_exif_preview" />

                <!-- Execute Rename Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartRename"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/exif_btn_start_rename"
                    android:textSize="15sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_edit" />

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

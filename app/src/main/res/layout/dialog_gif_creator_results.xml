<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_glass">

    <TextView
        android:id="@+id/txtResultsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gif_creator_complete"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/mobile_text_primary" />

    <TextView
        android:id="@+id/txtResultsDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/close" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewGif"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="12dp"
            android:text="@string/gif_creator_view" />
    </LinearLayout>

</LinearLayout>

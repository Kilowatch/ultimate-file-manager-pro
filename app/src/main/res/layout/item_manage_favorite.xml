<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardFavorite"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke"
    app:rippleColor="@color/mobile_glass_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Hero Icon Badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@string/favorite_icon" />
        </FrameLayout>

        <!-- Label & Path -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/txtLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="15.5sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Downloads Folder" />

            <TextView
                android:id="@+id/txtPath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:layout_marginTop="2dp"
                tools:text="/storage/emulated/0/Download" />
        </LinearLayout>

        <!-- Frosted Danger Delete Action Button -->
        <FrameLayout
            android:id="@+id/btnDeleteContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_icon_danger"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_error"
                android:contentDescription="@string/remove_favorite" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

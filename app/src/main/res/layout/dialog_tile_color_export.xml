<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tile_color_export_desc_mobile"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvExportCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textIsSelectable="true"
        android:letterSpacing="0.04"
        android:background="@drawable/bg_dialog_code_surface"
        android:layout_marginBottom="20dp" />

    <!-- 5-row colour summary -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginBottom="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <View android:id="@+id/dotExportIcon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/tile_color_code_icon" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
            <TextView android:id="@+id/hexExportIcon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <View android:id="@+id/dotExportTileBg" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/tile_color_code_tile_bg" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
            <TextView android:id="@+id/hexExportTileBg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <View android:id="@+id/dotExportRing" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/tile_color_code_ring" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
            <TextView android:id="@+id/hexExportRing" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <View android:id="@+id/dotExportIconBg" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/tile_color_code_icon_bg" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
            <TextView android:id="@+id/hexExportIconBg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <View android:id="@+id/dotExportLabel" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="12dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/tile_color_code_label" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
            <TextView android:id="@+id/hexExportLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExportCopy"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/tile_color_export_copy"
        style="@style/Widget.Material3.Button" />

</LinearLayout>

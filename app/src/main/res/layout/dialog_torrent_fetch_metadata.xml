<?xml version="1.0" encoding="utf-8"?>
<!--
    BitTorrent Swarm Metadata Fetch Progress Dialog — UFMStandard Glass (Mobile)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge (Frosted Circle with Magnet Icon) -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_magnet"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/torrent_fetching_metadata"
        android:textColor="@color/mobile_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="6dp" />

    <!-- Subtitle / Swarm Status Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/torrent_fetching_metadata_desc"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="22dp" />

    <!-- Indeterminate Circular Progress Spinner -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorSize="42dp"
        app:trackThickness="4dp"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="@color/mobile_glass_stroke"
        android:layout_marginBottom="22dp" />

    <!-- Cancel Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelFetch"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13.5sp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp" />

</LinearLayout>

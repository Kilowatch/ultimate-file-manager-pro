<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Transfer Conflict Dialog - UFM Glass Standard
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- Title -->
    <TextView
        android:id="@+id/txtConflictTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/conflict_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="8dp" />

    <!-- Filename -->
    <TextView
        android:id="@+id/txtConflictFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="filename.txt"
        android:textStyle="bold"
        android:textColor="@color/tv_text_primary"
        android:textSize="16sp"
        android:maxLines="2"
        android:ellipsize="middle"
        android:layout_marginBottom="4dp" />

    <!-- Info line -->
    <TextView
        android:id="@+id/txtConflictInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/conflict_message_file"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <!-- 0-byte warning (hidden by default) -->
    <TextView
        android:id="@+id/txtZeroByteWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/conflict_zero_byte_warning"
        android:textColor="@color/ufm_denied"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginBottom="20dp" />

    <!-- Overwrite -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConflictOverwrite"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/conflict_overwrite"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@color/ufm_denied"
        app:cornerRadius="12dp"
        style="@style/Widget.Material3.Button" />

    <!-- Skip -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConflictSkip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/conflict_skip"
        android:textColor="@color/tv_button_text_selector"
        android:textSize="15sp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/selector_tv_button"
        app:backgroundTint="@null"
        style="@style/Widget.Material3.Button" />

    <!-- Keep Both -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConflictKeepBoth"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/conflict_keep_both"
        android:textColor="@color/tv_button_text_selector"
        android:textSize="15sp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/selector_tv_button"
        app:backgroundTint="@null"
        style="@style/Widget.Material3.Button" />

    <!-- Cancel -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConflictCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/cancel"
        android:textColor="@color/tv_button_text_selector"
        android:textSize="15sp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_marginBottom="12dp"
        android:background="@drawable/selector_tv_button"
        app:backgroundTint="@null"
        style="@style/Widget.Material3.Button" />

    <!-- Apply to all toggle -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyToAll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/conflict_apply_to_all"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:backgroundTint="#0AFFFFFF"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:cornerRadius="10dp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

</LinearLayout>

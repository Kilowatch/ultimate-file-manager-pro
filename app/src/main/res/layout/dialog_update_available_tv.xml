<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV Update Available Dialog - TV glass card with yellow focus adhering to UFMStandard
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp"
    android:gravity="center_horizontal">

    <!-- Icon Badge in Frosted Container -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_tv_card_glass">

        <ImageView
            android:id="@+id/imgUpdateIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_install"
            app:tint="@color/tv_icon_tint"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/txtUpdateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Version Badge Pill -->
    <TextView
        android:id="@+id/txtVersionDiff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp" />

    <!-- Release Notes / Changelog Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginBottom="14dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/txtChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_tv_code_surface"
            android:padding="10dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- TV Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Primary Action Button (Download APK) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadUpdate"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/selector_tv_button_yellow"
            android:textColor="@color/selector_tv_button_text_yellow"
            app:cornerRadius="22dp"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:focusable="true"
            android:clickable="true" />

        <!-- Secondary & Dismiss Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewRelease"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/selector_tv_button_yellow"
                android:textColor="@color/selector_tv_button_text_yellow"
                app:cornerRadius="21dp"
                android:text="@string/update_btn_view_release"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:focusable="true"
                android:clickable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemindLater"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/selector_tv_button_yellow"
                android:textColor="@color/selector_tv_button_text_yellow"
                app:cornerRadius="21dp"
                android:text="@string/update_btn_remind_later"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Modern Glass Header Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Modern Back Button -->
        <!-- Normal Header Content (visible when NOT in selection mode) -->
        <LinearLayout
            android:id="@+id/layoutHeaderNormal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_header_action_ripple"
                app:tint="@color/mobile_icon_tint" />

            <!-- Storage Badge Pill -->
            <TextView
                android:id="@+id/badgeStorageType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_storage_badge"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:visibility="gone"
                tools:text="SMB"
                tools:visibility="visible" />

            <!-- Spacer pushes action buttons to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Modern Action Buttons Group -->
            <LinearLayout
                android:id="@+id/headerActionsGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnSearchToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnViewToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_view_list"
                    android:contentDescription="@string/cd_view_toggle"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnSort"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_sort"
                    android:contentDescription="@string/sort_and_filter"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnCreateNew"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_create_new"
                    android:contentDescription="@string/cd_create_new"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnRefresh"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_refresh_custom"
                    android:contentDescription="@string/refresh"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnDrivePicker"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_storage_internal"
                    android:contentDescription="@string/select_storage"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnCloseTwin"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_twin_window_off"
                    android:contentDescription="@string/close_twin_window"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

            </LinearLayout>

        </LinearLayout>

        <!-- Contextual Selection Header (revealed in selection mode on mobile) -->
        <LinearLayout
            android:id="@+id/layoutHeaderSelection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Close Selection Button (X) -->
            <ImageView
                android:id="@+id/btnCloseSelection"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/action_clear_selection"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_header_action_ripple"
                app:tint="@color/mobile_icon_tint" />

            <!-- Dynamic Selection Count -->
            <TextView
                android:id="@+id/txtSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="@color/mobile_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                tools:text="1 selected" />

            <!-- Select All / Deselect All Toggle Icon -->
            <ImageView
                android:id="@+id/btnSelectAll"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_select_all"
                android:contentDescription="@string/action_select_all"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_header_action_ripple"
                app:tint="@color/mobile_icon_tint" />

        </LinearLayout>

        <!-- Hidden compat stubs -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/btnOptionsToggle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/spacerOptions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/dividerOptions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/divider_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Compat Options Row stub -->
    <LinearLayout
        android:id="@+id/layoutOptionsRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerLayout" />

    <!-- Modern Search Row -->
    <LinearLayout
        android:id="@+id/layoutSearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp"
        android:background="@color/mobile_glass_header"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutOptionsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_modern_search_box">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/mobile_text_secondary"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/type_here_to_search"
                android:textColor="@color/mobile_text_primary"
                android:textColorHint="@color/mobile_text_secondary"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/btnSearchClear"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_header_action_ripple"
                app:tint="@color/mobile_text_secondary"
                android:visibility="gone"
                android:contentDescription="@string/cd_clear_search"
                tools:visibility="visible" />

        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="headerLayout,layoutOptionsRow,layoutSearchRow" />

    <!-- Hidden compat stubs for action views -->
    <LinearLayout
        android:id="@+id/layoutSelectionBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView android:id="@+id/btnCopy" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnMove" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnRename" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnFavorite" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnShare" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnImageCompress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnCopyEncrypt" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnMoveEncrypt" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnProtect" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnUnprotect" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/btnCompress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/btnExtract" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Twin Window Action Pills -->
    <HorizontalScrollView
        android:id="@+id/layoutActionPillsScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="8dp"
        android:background="@drawable/bg_dialog_glass"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/layoutActionPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPillSelectAll"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_select_all"
                app:icon="@drawable/ic_check"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPillCopy"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/action_copy"
                app:icon="@drawable/ic_copy"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPillMove"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/action_move"
                app:icon="@drawable/ic_move"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPillDelete"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_delete"
                app:icon="@drawable/ic_delete"
                app:iconSize="18dp"
                app:iconTint="@color/ufm_denied"
                android:textColor="@color/ufm_denied" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- File List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/margin_xs"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_file" />

    <!-- Select All FAB (Twin Window) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabSelectAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_md"
        android:text="@string/action_select_all"
        android:textColor="?attr/colorOnPrimary"
        app:icon="@drawable/ic_check"
        app:iconTint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/fabTools"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_bias="0.5" />

    <!-- Paste FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabPaste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_md"
        android:text="@string/action_paste"
        android:textColor="?attr/colorOnPrimary"
        app:icon="@drawable/ic_paste"
        app:iconTint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tools FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_md"
        android:text="@string/action_tools"
        android:textColor="?attr/colorOnPrimary"
        app:icon="@drawable/ic_settings"
        app:iconTint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="@dimen/icon_size_xl"
            android:layout_height="@dimen/icon_size_xl"
            android:src="@drawable/ic_folder"
            android:alpha="0.3"
            app:tint="@color/mobile_text_secondary"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_md"
            android:text="@string/file_empty_folder"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

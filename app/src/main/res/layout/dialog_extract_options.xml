<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile Extract Options Dialog - UFM Standard -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_bottom_sheet_glass">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/mobile_glass_stroke"
        android:clipToOutline="true" />

    <!-- 56dp Frosted Extract Badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_extract"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/extract_options_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- Subtitle / Archive Name -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13.5sp"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        tools:text="archive.zip" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Option 1: Extract to Current Folder -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtractHere"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/extract_to_current_folder"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_folder"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:backgroundTint="?attr/colorPrimary"
            android:layout_marginBottom="10dp" />

        <!-- Option 2: Extract to New Folder -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtractToNewFolder"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/extract_to_new_folder"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_folder"
            app:iconTint="?attr/colorPrimary"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            android:layout_marginBottom="10dp" />

        <!-- Option 3: Extract & Select Folder -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtractAndSelectFolder"
            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/extract_select_folder"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_extract"
            app:iconTint="?attr/colorPrimary"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            android:layout_marginBottom="10dp" />

        <!-- Cancel -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/cancel"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>

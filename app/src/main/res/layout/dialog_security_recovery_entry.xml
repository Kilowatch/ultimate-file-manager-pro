<?xml version="1.0" encoding="utf-8"?>
<!-- Security Recovery Key Entry Dialog — UFMStandard Glass -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- 56dp Frosted Lock Badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_security_lock"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/security_recovery_entry_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:text="@string/security_recovery_entry_subtitle" />

    <!-- Monospace Input Field Card -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRecoveryKey"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/security_recovery_code_hint"
        app:boxStrokeColor="?attr/colorPrimary"
        app:hintTextColor="?attr/colorPrimary"
        app:counterEnabled="true"
        app:counterMaxLength="16"
        android:layout_marginBottom="6dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRecoveryKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:textColor="@color/mobile_text_primary"
            android:textSize="15sp"
            android:singleLine="true"
            android:imeOptions="actionDone" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Error Text -->
    <TextView
        android:id="@+id/txtRecoveryKeyError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ufm_denied"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        tools:text="Invalid recovery key" />

    <!-- Vertically Stacked Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmRecoveryKey"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelRecoveryKey"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp" />
</LinearLayout>

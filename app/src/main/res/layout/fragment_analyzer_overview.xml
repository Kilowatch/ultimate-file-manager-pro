<?xml version="1.0" encoding="utf-8"?>
<!--
    Overview Tab Fragment Layout — Language & Grouped Glass Card Standard
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Guidance Notice Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_icon_frosted">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_about"
                        app:tint="?attr/colorPrimary"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="@string/analyzer_info_notice"
                    android:textColor="@color/mobile_card_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Disk Usage Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUsageSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke">

            <LinearLayout
                android:id="@+id/layoutUsageSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Total disk usage -->
                <TextView
                    android:id="@+id/txtAnalyzerTotalUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mobile_card_text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginBottom="14dp"
                    tools:text="45.2 GB used of 128 GB" />

                <!-- Segmented storage bar -->
                <za.kilowatch.ultimatefilemanager.ui.StorageBarView
                    android:id="@+id/storageBar"
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 1 Header: Storage Breakdown -->
        <TextView
            android:id="@+id/labelSectionBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/analyzer_section_storage_breakdown"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <!-- Category breakdown Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke">

            <LinearLayout
                android:id="@+id/layoutOverviewCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2 Header: Top Folders -->
        <TextView
            android:id="@+id/labelSectionTopFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/analyzer_section_top_folders"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Top Folders Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTopFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke">

            <LinearLayout
                android:id="@+id/layoutTopFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 3 Header: App Usage -->
        <TextView
            android:id="@+id/labelSectionAppUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/analyzer_section_app_usage"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- App Usage Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAppUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke">

            <LinearLayout
                android:id="@+id/layoutAppUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile Download Manager — Premium Dark Glassmorphic Standard -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".download.DownloadManagerActivity">

    <!-- 56dp Fixed Glass Header Bar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button in 40dp Frosted Squircle -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

        <!-- Title + Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_manager_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="0 active downloads" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Action Cards: Direct Downloads vs Torrent Downloads (Fixed) -->
    <LinearLayout
        android:id="@+id/layoutTopCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:baselineAligned="false"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Direct Downloads Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDirectDownloads"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_icon_frosted">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_link"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/download_direct_downloads" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/download_direct_downloads"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold"
                    android:textAlignment="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Torrent Downloads Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTorrentDownloads"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_icon_frosted">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_magnet"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/download_torrent_downloads" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/download_torrent_downloads"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold"
                    android:textAlignment="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Transfers Section Header (Fixed) -->
    <TextView
        android:id="@+id/txtTransfersHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:text="Transfers"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toBottomOf="@id/layoutTopCards"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Transfers Content (Scrollable Recycler + Empty State Container) -->
    <FrameLayout
        android:id="@+id/containerTransfers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtTransfersHeader"
        app:layout_constraintBottom_toTopOf="@id/rowDownloadLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDownloads"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Empty State Container matching Document Scanner -->
        <LinearLayout
            android:id="@+id/layoutEmptyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_btn_icon_frosted"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_download"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtEmptyTransfers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No active downloads"
                android:textColor="@color/mobile_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:textAlignment="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Direct Downloads or Torrent Downloads above to start downloading."
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:textAlignment="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom: Download Location Card (Fixed at bottom) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rowDownloadLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_icon_frosted">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_folder"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/download_location_label" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/download_location_label"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/txtDownloadLocationPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="/storage/emulated/0/Download"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="middle" />
                </LinearLayout>
            </LinearLayout>

            <!-- Change button below current location -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeLocation"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginTop="12dp"
                android:text="@string/download_change_location"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium"
                app:icon="@drawable/ic_folder"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconGravity="textStart"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

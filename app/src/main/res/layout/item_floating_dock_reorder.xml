<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReorderSlot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- Position Badge -->
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/txtTilePosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                tools:text="1" />
        </FrameLayout>

        <!-- Icon Container -->
        <FrameLayout
            android:id="@+id/containerTileIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imgTileIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                app:tint="@color/mobile_icon_tint"
                tools:src="@drawable/ic_cloud" />
        </FrameLayout>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/txtTileTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="14.5sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Google Drive" />

            <TextView
                android:id="@+id/txtTileSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                tools:text="user@gmail.com" />
        </LinearLayout>

        <!-- Remove Action Button -->
        <FrameLayout
            android:id="@+id/btnRemoveTile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/floating_bar_remove">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                android:importantForAccessibility="no"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

        <!-- Drag Handle -->
        <FrameLayout
            android:id="@+id/btnDragHandle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/dpad_moves_tile_ok_saves_back_cancels">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_drag_handle"
                android:importantForAccessibility="no"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

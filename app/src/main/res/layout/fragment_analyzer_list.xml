<?xml version="1.0" encoding="utf-8"?>
<!--
    Generic List Tab Fragment Layout — Language & Grouped Glass Card Standard
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- "Not indexed" guidance card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutNotIndexed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icon_frosted">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_about"
                    app:tint="?attr/ufmRiskModerate"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtListNotIndexed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="13.5sp"
                android:lineSpacingExtra="2dp"
                tools:text="Index this storage to unlock advanced analysis for this category." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Empty state card -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtListEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-bold"
            android:textAlignment="center"
            tools:text="No duplicates found" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/analyzer_empty_state_desc"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- "Verifying content…" progress card (Duplicates tab) -->
    <LinearLayout
        android:id="@+id/layoutVerifying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/mobile_glass_card"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/progressBarVerifying"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/txtVerifying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/analyzer_dup_verifying"
            android:textColor="@color/mobile_card_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Duplicate Bulk Controls Header Card (Duplicates Tab only) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutDuplicateControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <!-- Line 1: Hero Badge + Title & Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Hero Duplicate Icon Badge -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_icon_frosted">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_duplicate"
                        app:tint="?attr/colorPrimary"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <!-- Title & Summary Text -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analyzer_tab_duplicates"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/txtDuplicateSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp"
                        tools:text="45 duplicate groups · saves 1.2 GB" />
                </LinearLayout>
            </LinearLayout>

            <!-- Line 2: Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <!-- Clear Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearSelection"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="19dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/mobile_glass_stroke"
                    app:backgroundTint="@color/mobile_glass_card"
                    app:icon="@drawable/ic_deselect_all"
                    app:iconSize="16dp"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/ufmDenied"
                    android:text="@string/analyzer_clear_selection"
                    android:textColor="?attr/ufmDenied"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp"
                    tools:visibility="visible" />

                <!-- Select All Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAllDuplicates"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="19dp"
                    app:icon="@drawable/ic_select_all"
                    app:iconSize="16dp"
                    app:iconPadding="6dp"
                    app:iconTint="@android:color/white"
                    app:backgroundTint="?attr/colorPrimary"
                    android:text="@string/analyzer_select_all_duplicates"
                    android:textColor="@android:color/white"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAnalyzerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layoutDuplicateControls"
        app:layout_constraintBottom_toTopOf="@id/layoutVerifying"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

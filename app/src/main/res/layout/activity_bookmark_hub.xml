<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- UFMStandard Mobile Toolbar (56dp) -->
        <LinearLayout
            android:id="@+id/toolbarContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/mobile_glass_header"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icon_frosted">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/cd_back"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/mobile_icon_tint" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bookmark_hub_title"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtToolbarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bookmark_hub_subtitle"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Search Action -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_icon_frosted">

                <ImageView
                    android:id="@+id/btnSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search_title"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/mobile_icon_tint" />
            </FrameLayout>

            <!-- Consolidated 3-Dot Options Action (UFMStandard) -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icon_frosted">

                <ImageView
                    android:id="@+id/btnOptionsToggle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    android:contentDescription="@string/toggle_options"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/mobile_icon_tint" />
            </FrameLayout>
        </LinearLayout>

        <!-- Search Bar (Collapsible) -->
        <FrameLayout
            android:id="@+id/layoutSearchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_reindex_option_card"
            android:visibility="gone">

            <EditText
                android:id="@+id/editSearchQuery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:paddingHorizontal="16dp"
                android:hint="@string/bookmark_search_hint"
                android:textColor="@color/mobile_text_primary"
                android:textColorHint="@color/mobile_text_hint"
                android:textSize="14sp"
                android:singleLine="true" />
        </FrameLayout>

        <!-- Tabs Row: All | Starred (UFMStandard matching a1.jpeg) -->
        <LinearLayout
            android:id="@+id/layoutTabsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Tab: All -->
                <LinearLayout
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/txtTabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/bookmark_filter_all"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-black" />

                    <View
                        android:id="@+id/indicatorTabAll"
                        android:layout_width="32dp"
                        android:layout_height="3dp"
                        android:background="?attr/colorPrimary" />
                </LinearLayout>

                <!-- Tab: Starred -->
                <LinearLayout
                    android:id="@+id/tabStarred"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="20dp"
                    android:paddingHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/txtTabStarred"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/bookmark_filter_starred"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium" />

                    <View
                        android:id="@+id/indicatorTabStarred"
                        android:layout_width="32dp"
                        android:layout_height="3dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>
            </LinearLayout>

            <!-- Subtle Horizontal Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:background="#1AFFFFFF" />
        </LinearLayout>

        <!-- Groups Section Header -->
        <LinearLayout
            android:id="@+id/layoutGroupsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bookmark_groups_header"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/btnViewAllGroups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookmark_view_all_groups"
                android:textColor="?attr/colorPrimary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="4dp"
                android:paddingStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Groups Pills Container (Wraps across lines matching a1.jpeg) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:singleLine="false"
            app:chipSpacing="8dp"
            app:singleSelection="true" />

        <!-- Bookmarks List & Empty State Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBookmarks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="88dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_bookmark_hub"
                    android:alpha="0.4"
                    app:tint="@color/mobile_icon_tint"
                    android:contentDescription="@string/bookmark_empty_title" />

                <TextView
                    android:id="@+id/txtEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/bookmark_empty_title"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/txtEmptyDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/bookmark_empty_desc"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Delete Empty Collection Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteEmptyGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/bookmark_delete_collection"
                    android:textColor="#EF4444"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="#EF4444"
                    app:strokeColor="#4DEE4444"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@color/mobile_glass_card"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Floating Batch Selection Action Bar (UFMStandard Glass) -->
    <LinearLayout
        android:id="@+id/layoutSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/bg_dialog_glass"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Move -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatchMove"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/bookmark_batch_move"
            android:textColor="?attr/colorPrimary" />

        <!-- Export -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatchExport"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/bookmark_batch_export"
            android:textColor="@color/mobile_text_primary" />

        <!-- Delete -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatchDelete"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/bookmark_batch_delete"
            android:textColor="#EF4444" />

        <!-- Close Selection -->
        <ImageView
            android:id="@+id/btnCloseSelection"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/mobile_icon_tint" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- Header: Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_remove_folders_title"
            android:textColor="@color/mobile_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:textAlignment="center"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_remove_folders_desc"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"
            android:textAlignment="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Scrollable container for mounted folders -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMountedFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:clipToPadding="false"
            android:overScrollMode="always"
            tools:listitem="@layout/item_selected_folder" />

        <TextView
            android:id="@+id/txtNoMountedFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="20dp"
            android:text="@string/no_mounted_folders_hint"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"
            android:textAlignment="center"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Footer: Done Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDoneRemove"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/btn_done"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@android:color/white"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp" />

</LinearLayout>

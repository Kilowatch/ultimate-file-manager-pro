<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notepad"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Note Title -->
    <TextView
        android:id="@+id/txtNoteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="12dp" />

    <!-- Note Content (Scrollable) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="240dp"
        android:layout_marginBottom="20dp"
        android:padding="12dp"
        android:background="@drawable/bg_btn_icon_frosted">

        <TextView
            android:id="@+id/txtNoteBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3" />
    </ScrollView>

    <!-- Copy Text Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyText"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/bookmark_action_copy_text"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        app:cornerRadius="12dp"
        app:backgroundTint="?attr/colorPrimary"
        android:layout_marginBottom="6dp" />

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/close"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        app:cornerRadius="12dp" />

</LinearLayout>

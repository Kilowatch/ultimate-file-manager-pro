<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile Notepad — Premium Dark Glassmorphic Standard -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".notepad.NotepadActivity">

    <!-- 56dp Fixed Glass Header Bar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button in 40dp Frosted Squircle -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/mobile_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-bold"
            android:singleLine="true"
            android:ellipsize="middle"
            tools:text="Notepad.txt" />

        <!-- New Document button -->
        <ImageView
            android:id="@+id/btnNewDoc"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_file_text"
            android:contentDescription="@string/new_document"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            app:tint="@color/mobile_icon_tint" />

        <!-- Save button -->
        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_save"
            android:contentDescription="@string/save_note"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            app:tint="?attr/colorPrimary" />

        <!-- Clear text button -->
        <ImageView
            android:id="@+id/btnClear"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/clear_text"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            app:tint="@color/ufm_denied" />
    </LinearLayout>

    <!-- Loading progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Word/Character count stats pill bar -->
    <LinearLayout
        android:id="@+id/countBar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#0AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtWordCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            tools:text="0 words" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:background="#26FFFFFF" />

        <TextView
            android:id="@+id/txtCharCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            tools:text="0 characters" />
    </LinearLayout>

    <!-- Scrollable editor area -->
    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:background="@null"
        android:fontFamily="monospace"
        android:textSize="14sp"
        android:textColor="@color/mobile_text_primary"
        android:textColorHint="@color/mobile_text_secondary"
        android:inputType="textMultiLine|textNoSuggestions"
        android:gravity="start|top"
        android:scrollbars="vertical"
        android:scrollbarStyle="insideOverlay"
        app:layout_constraintTop_toBottomOf="@id/countBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

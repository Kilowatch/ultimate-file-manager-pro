<?xml version="1.0" encoding="utf-8"?>
<!--
    Loyalty Pass Credentials Modal — Mobile UFMStandard Frosted Glass
    Displays newly generated Loyalty ID and Passkey.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Hero Badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_btn_icon_frosted">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_security_lock"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtCredsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/dialog_pass_creds_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtCredsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="@string/dialog_pass_creds_subtitle"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp" />

    <!-- Frosted Credentials Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Loyalty ID Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_pass_creds_id_label"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/txtCredsLoyaltyId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_badge_bubble"
                android:paddingVertical="10dp"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="17sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:textIsSelectable="true" />

            <!-- Passkey Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_pass_creds_passkey_label"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/txtCredsPasskey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_bubble"
                android:paddingVertical="10dp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:textIsSelectable="true" />

            <!-- Privacy & Security Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/dialog_pass_creds_notice"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp"
                android:gravity="center" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Vertically stacked action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyCreds"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/dialog_pass_creds_btn_copy"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            app:cornerRadius="12dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDoneCreds"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/dialog_pass_creds_btn_done"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</LinearLayout>

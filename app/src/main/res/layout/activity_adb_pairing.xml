<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile Wireless ADB Pairing — Premium Glassmorphic Standard -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient">

    <!-- Modern Glass Header Bar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            app:tint="@color/mobile_icon_tint" />

        <!-- Title + Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_pairing"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_terminal_subtitle"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 3-Step Quick Guide Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_circle_accent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_terminal"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/adb_pairing_guide_title"
                            android:textColor="@color/mobile_text_primary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-bold"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <!-- Step 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:text="1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorPrimary"
                            android:background="@drawable/bg_badge_step_pill"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/adb_pairing_guide_step1"
                            android:textColor="@color/mobile_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Step 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:text="2"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorPrimary"
                            android:background="@drawable/bg_badge_step_pill"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/adb_pairing_guide_step2"
                            android:textColor="@color/mobile_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Step 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:text="3"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorPrimary"
                            android:background="@drawable/bg_badge_step_pill"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/adb_pairing_guide_step3"
                            android:textColor="@color/mobile_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Auto-Discovery Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adb_discovery_title"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Scan Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanDevices"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/adb_scan_devices"
                        app:icon="@drawable/ic_search"
                        app:iconGravity="textStart"
                        style="@style/Widget.Material3Expressive.Button"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="12dp" />

                    <!-- Scan Progress -->
                    <LinearLayout
                        android:id="@+id/scanProgressContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <ProgressBar
                            android:id="@+id/scanProgressBar"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginBottom="8dp"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:indeterminate="true" />

                        <TextView
                            android:id="@+id/scanProgressText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/scanning"
                            android:textColor="@color/mobile_text_secondary"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/devicesDetectedText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/devices_detected_0"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Device Spinner -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_device"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_reindex_option_card"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp">

                        <Spinner
                            android:id="@+id/spinnerDevices"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Target IP & Port Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adb_manual_title"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Host / IP Input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adb_host_label"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editAdbHost"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/adb_host_hint"
                        android:background="@drawable/bg_reindex_option_card"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/mobile_text_primary"
                        android:textColorHint="@color/mobile_text_secondary"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:layout_marginBottom="12dp" />

                    <!-- Port Input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adb_port_label"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editAdbPort"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/s_5555"
                        android:background="@drawable/bg_reindex_option_card"
                        android:paddingHorizontal="14dp"
                        android:inputType="number"
                        android:maxLength="5"
                        android:textColor="@color/mobile_text_primary"
                        android:textColorHint="@color/mobile_text_secondary"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:singleLine="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6-Digit PIN Pairing Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pinContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adb_pin_title"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adb_pin_label"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <!-- 6 PIN Digits -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="12dp">

                        <EditText android:id="@+id/pin_1" style="@style/AdbPinBox" />
                        <EditText android:id="@+id/pin_2" style="@style/AdbPinBox" />
                        <EditText android:id="@+id/pin_3" style="@style/AdbPinBox" />
                        <EditText android:id="@+id/pin_4" style="@style/AdbPinBox" />
                        <EditText android:id="@+id/pin_5" style="@style/AdbPinBox" />
                        <EditText android:id="@+id/pin_6" style="@style/AdbPinBox" />
                    </LinearLayout>

                    <!-- Status Message -->
                    <TextView
                        android:id="@+id/txtAdbStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:textColor="@color/ufm_error"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginBottom="12dp" />

                    <!-- Action Buttons -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnectWithPin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/pair_and_connect"
                        app:icon="@drawable/ic_lock"
                        app:iconGravity="textStart"
                        style="@style/Widget.Material3Expressive.Button"
                        app:backgroundTint="?attr/colorPrimary"
                        android:layout_marginBottom="10dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnectNoPIN"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/connect_without_pin"
                        style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                        android:textColor="@color/mobile_text_primary"
                        app:strokeColor="@color/mobile_glass_stroke"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
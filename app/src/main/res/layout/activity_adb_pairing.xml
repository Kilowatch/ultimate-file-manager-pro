<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_icon_circle_accent"
            android:contentDescription="@string/back"
            app:tint="@color/mobile_icon_tint" />

        <View
            android:layout_width="1.5dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="14dp"
            android:background="?attr/colorPrimary"
            android:alpha="0.6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_pairing"
                android:textColor="@color/mobile_text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/txtHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_pairing_title"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Device Scan Section -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanDevices"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/adb_scan_devices"
                style="@style/Widget.Material3Expressive.Button"
                app:backgroundTint="?attr/colorPrimary"
                android:layout_marginBottom="20dp"
                app:cornerRadius="16dp" />

            <!-- Scan Progress -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/scanProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ProgressBar
                        android:id="@+id/scanProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginBottom="12dp"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/scanProgressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scanning"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/devicesDetectedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/devices_detected_0"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Device Spinner -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_device"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_url_box"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp">

                        <Spinner
                            android:id="@+id/spinnerDevices"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null" />
                    </LinearLayout>

                    <!-- Port Input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adb_port_label"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:boxBackgroundMode="none">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editAdbPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:hint="@string/s_5555"
                            android:background="@drawable/bg_url_box"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:inputType="number"
                            android:maxLength="5"
                            android:textColor="@color/mobile_text_primary"
                            android:textColorHint="@color/mobile_text_secondary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Status Message -->
                    <TextView
                        android:id="@+id/txtAdbStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:textColor="@color/ufm_error"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginTop="12dp" />

                    <!-- Connection Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="20dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnectNoPIN"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/connect_without_pin"
                            style="@style/Widget.Material3Expressive.Button"
                            app:backgroundTint="?attr/colorPrimary"
                            android:layout_marginBottom="12dp"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTogglePIN"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/use_pin_pairing"
                            style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                            android:textColor="@color/mobile_text_primary"
                            app:strokeColor="@color/mobile_glass_stroke"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                                        
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PIN Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pinContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adb_pin_label"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <EditText
                            android:id="@+id/pin_1"
                            style="@style/AdbPinBox" />
                        <EditText
                            android:id="@+id/pin_2"
                            style="@style/AdbPinBox" />
                        <EditText
                            android:id="@+id/pin_3"
                            style="@style/AdbPinBox" />
                        <EditText
                            android:id="@+id/pin_4"
                            style="@style/AdbPinBox" />
                        <EditText
                            android:id="@+id/pin_5"
                            style="@style/AdbPinBox" />
                        <EditText
                            android:id="@+id/pin_6"
                            style="@style/AdbPinBox" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnectWithPin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/pair_and_connect"
                        style="@style/Widget.Material3Expressive.Button"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
    Mobile File Browser — premium dark glassmorphism design
    Same dark-navy theme as activity_welcome: bg_mobile_gradient background,
    glass header bar with back button, title, new folder, and sort.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".storage.FileBrowserActivity">

    <!-- Modern Glass Header Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Normal Header Content (visible when NOT in selection mode) -->
        <LinearLayout
            android:id="@+id/layoutHeaderNormal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Back Button in 40dp Frosted Squircle -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icon_frosted">

                <ImageView
                    android:id="@+id/btnTvBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/cd_back"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/mobile_icon_tint" />
            </FrameLayout>

            <!-- Storage Badge Pill -->
            <TextView
                android:id="@+id/badgeStorageType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_storage_badge"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:visibility="gone"
                tools:text="LOCAL"
                tools:visibility="visible" />

            <!-- Spacer pushes action buttons to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Modern Action Buttons Group -->
            <LinearLayout
                android:id="@+id/headerActionsGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnSearchToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnViewToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_view_list"
                    android:contentDescription="@string/cd_view_toggle"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnSort"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_sort"
                    android:contentDescription="@string/sort_and_filter"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnCreateNew"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_create_new"
                    android:contentDescription="@string/cd_create_new"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnRefreshIndex"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_refresh_custom"
                    android:contentDescription="@string/refresh"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnOptionsToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    android:contentDescription="@string/toggle_options"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

            </LinearLayout>

        </LinearLayout>

        <!-- Contextual Selection Header (revealed in selection mode on mobile) -->
        <LinearLayout
            android:id="@+id/layoutHeaderSelection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Close Selection Button (X) -->
            <ImageView
                android:id="@+id/btnCloseSelection"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/action_clear_selection"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_header_action_ripple"
                app:tint="@color/mobile_icon_tint" />

            <!-- Dynamic Selection Count -->
            <TextView
                android:id="@+id/txtSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="@color/mobile_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                tools:text="1 selected" />

            <!-- Select All / Deselect All Toggle Icon -->
            <ImageView
                android:id="@+id/btnSelectAll"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_select_all"
                android:contentDescription="@string/action_select_all"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_header_action_ripple"
                app:tint="@color/mobile_icon_tint" />

        </LinearLayout>

        <!-- Hidden compat stubs -->
        <TextView
            android:id="@+id/txtTvTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/txtTvSubtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/spacerOptions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/dividerOptions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/btnTwinWindow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Compat Options Row stub -->
    <LinearLayout
        android:id="@+id/layoutOptionsRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerLayout" />

    <!-- Modern Search Row -->
    <LinearLayout
        android:id="@+id/layoutSearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp"
        android:background="@color/mobile_glass_header"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutOptionsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_modern_search_box">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/mobile_text_secondary"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/type_here_to_search"
                android:textColor="@color/mobile_text_primary"
                android:textColorHint="@color/mobile_text_secondary"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/btnSearchClear"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_header_action_ripple"
                app:tint="@color/mobile_text_secondary"
                android:visibility="gone"
                android:contentDescription="@string/cd_clear_search"
                tools:visibility="visible" />

        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="headerLayout,layoutOptionsRow,layoutSearchRow" />

    <!-- Toolbar stub kept for code compatibility -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/menu_file_browser" />

    <!-- Path Breadcrumbs Navigation Bar -->
    <HorizontalScrollView
        android:id="@+id/layoutBreadcrumbsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="16dp"
        android:background="@color/mobile_glass_header"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutBreadcrumbs"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp" />
    </HorizontalScrollView>

    <!-- Hidden compat stubs for action views -->
    <LinearLayout
        android:id="@+id/layoutSelectionBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutBreadcrumbsScroll"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView android:id="@+id/btnCopy" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnMove" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnRename" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnShare" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnImageCompress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnCopyEncrypt" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnMoveEncrypt" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnFavorite" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnHide" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnUnhide" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnProtect" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <ImageView android:id="@+id/btnUnprotect" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/btnCompress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/btnExtract" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>

    <!-- File List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/margin_xs"
        app:layout_constraintTop_toBottomOf="@id/layoutBreadcrumbsScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_file" />

    <!-- Paste FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabPaste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_md"
        android:text="@string/action_paste"
        android:textColor="?attr/colorOnPrimary"
        app:icon="@drawable/ic_paste"
        app:iconTint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tools FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_md"
        android:text="@string/action_tools"
        android:textColor="?attr/colorOnPrimary"
        app:icon="@drawable/ic_settings"
        app:iconTint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Quick Action Bar (Mobile Selection) -->
    <za.kilowatch.ultimatefilemanager.ui.FloatingQuickActionBar
        android:id="@+id/floatingQuickBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State — Lottie animation + label -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutBreadcrumbsScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
            LottieAnimationView — plays anim_empty_folder.json on loop.
            autoPlay + loop keep it subtly alive without being distracting.
        -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieEmptyFolder"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="@null"
            app:lottie_rawRes="@raw/anim_empty_folder"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:id="@+id/txtEmptyFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_sm"
            android:text="@string/file_empty_folder"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            android:textAlignment="center" />

        <LinearLayout
            android:id="@+id/layoutProtectedPrompt"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_md"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtProtectedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/protected_folder_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/txtProtectedDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/protected_folder_desc"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnableElevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/protected_folder_btn_shizuku"
                app:icon="@drawable/ic_shield_protected" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantSaf"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/protected_folder_btn_saf" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

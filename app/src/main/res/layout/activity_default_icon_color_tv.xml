<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_gradient">

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Header bar                                      -->
    <!-- ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingTop="@dimen/margin_xxl"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_tune"
            app:tint="@color/tv_accent"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_default_icon_colors_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTvResetAll"
            style="@style/TvContinueButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:text="@string/default_icon_color_reset_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTvDone"
            style="@style/TvGrantButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/default_icon_color_done" />

    </LinearLayout>

    <!-- Accent underline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_border" />

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Body: Left panel + Right preview                -->
    <!-- ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- LEFT: scrollable theme section list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerThemeSections"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="32dp"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants" />

        <!-- Vertical divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="32dp"
            android:background="@color/tv_glass_border" />

        <!-- RIGHT: icon preview -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Preview card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tvPreviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:focusable="false"
                android:clickable="false"
                android:focusableInTouchMode="false"
                app:cardBackgroundColor="@color/tv_glass_white_10"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/tvPreviewIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_folder"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvPreviewHex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="22sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/default_icon_color_preview_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>

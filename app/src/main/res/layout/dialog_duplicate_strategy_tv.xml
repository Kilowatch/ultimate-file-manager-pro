<?xml version="1.0" encoding="utf-8"?>
<!--
    Duplicate Retention Strategy Selection Dialog — TV (UFMStandard)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="26dp">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_duplicate"
            app:tint="@color/tv_button_focused_yellow_text"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/analyzer_strategy_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="18dp" />

    <!-- Radio Options Container -->
    <RadioGroup
        android:id="@+id/radioGroupStrategy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp">

        <!-- Option: Keep Oldest (Original) -->
        <LinearLayout
            android:id="@+id/cardKeepOldest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_tv_reindex_option_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusDown="@id/cardKeepNewest"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/radioKeepOldest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:clickable="false"
                android:focusable="false"
                app:buttonTint="@color/selector_tv_button_yellow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analyzer_strategy_oldest"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analyzer_strategy_oldest_desc"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="12.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Option: Keep Newest -->
        <LinearLayout
            android:id="@+id/cardKeepNewest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_tv_reindex_option_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/cardKeepOldest"
            android:nextFocusDown="@id/checkRememberStrategy">

            <RadioButton
                android:id="@+id/radioKeepNewest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:clickable="false"
                android:focusable="false"
                app:buttonTint="@color/selector_tv_button_yellow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analyzer_strategy_newest"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analyzer_strategy_newest_desc"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="12.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </RadioGroup>

    <!-- Remember Choice Checkbox -->
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/checkRememberStrategy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/analyzer_strategy_remember"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13.5sp"
        android:focusable="true"
        android:nextFocusUp="@id/cardKeepNewest"
        android:nextFocusDown="@id/btnConfirmStrategy"
        app:buttonTint="@color/selector_tv_button_yellow"
        android:layout_marginBottom="22dp" />

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmStrategy"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/btn_continue"
        android:textColor="@color/tv_button_focused_yellow_text"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        android:background="@drawable/selector_tv_button_yellow"
        android:focusable="true"
        android:nextFocusUp="@id/checkRememberStrategy"
        android:nextFocusDown="@id/btnCancelStrategy"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelStrategy"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/cancel"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        android:focusable="true"
        android:nextFocusUp="@id/btnConfirmStrategy"
        android:textColor="@color/tv_text_secondary" />

</LinearLayout>

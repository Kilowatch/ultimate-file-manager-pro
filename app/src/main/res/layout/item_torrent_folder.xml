<?xml version="1.0" encoding="utf-8"?>
<!--
    Torrent Content Inspector — Folder Row Item
    Professional flat tree row with clean margins and no bulky card outlines.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="1dp"
    android:paddingVertical="3dp"
    android:paddingEnd="10dp"
    android:background="@drawable/selector_torrent_tree_item"
    android:clickable="true"
    android:focusable="true">

    <!-- Depth Indentation Spacer -->
    <View
        android:id="@+id/viewIndent"
        android:layout_width="0dp"
        android:layout_height="1dp" />

    <!-- Expand / Collapse Arrow -->
    <ImageView
        android:id="@+id/btnExpandCollapse"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="4dp"
        android:src="@drawable/ic_expand_more"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="?attr/colorPrimary"
        android:contentDescription="Expand or collapse folder" />

    <!-- Checkbox -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkFolder"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:layout_marginEnd="6dp"
        android:clickable="false"
        android:focusable="false"
        app:buttonTint="?attr/colorPrimary" />

    <!-- Folder Icon -->
    <ImageView
        android:id="@+id/imgFolderIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_folder"
        app:tint="?attr/colorPrimary"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no" />

    <!-- Folder Name & Summary -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtFolderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/txtFolderStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_player_bottom_sheet_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- Header: Icon, Title & Meta summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/imgHeaderIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_file_video"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMediaTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    tools:text="Big_Buck_Bunny_4K.mkv" />

                <TextView
                    android:id="@+id/txtMediaSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    tools:text="MKV (Matroska) · 2.45 GB · 01:45:23" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- ── SECTION 1: VIDEO STREAM ───────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutVideoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_info_section_video"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_player_glass_card"
                android:padding="14dp">

                <!-- Video Codec -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_codec"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtVideoCodec"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="HEVC / H.265 (Main 10)" />
                </TableRow>

                <!-- Resolution -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_resolution"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtResolution"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        tools:text="3840 × 2160 (4K UHD · 16:9)" />
                </TableRow>

                <!-- Frame Rate -->
                <TableRow
                    android:id="@+id/rowFrameRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_framerate"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtFrameRate"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        tools:text="23.976 fps" />
                </TableRow>

                <!-- Video Bitrate -->
                <TableRow
                    android:id="@+id/rowVideoBitrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_bitrate"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtVideoBitrate"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        tools:text="14.2 Mbps" />
                </TableRow>

                <!-- Dynamic Range (HDR) -->
                <TableRow
                    android:id="@+id/rowHdr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_hdr"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtHdr"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        tools:text="HDR10 (PQ / SMPTE ST 2084)" />
                </TableRow>

                <!-- Color Space & Range -->
                <TableRow
                    android:id="@+id/rowColorSpace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_color_space"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtColorSpace"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        tools:text="BT.2020 (Limited Range)" />
                </TableRow>

                <!-- Bit Depth -->
                <TableRow
                    android:id="@+id/rowBitDepth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_bit_depth"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtBitDepth"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        tools:text="10-bit (YUV 4:2:0)" />
                </TableRow>
            </LinearLayout>
        </LinearLayout>

        <!-- ── SECTION 2: AUDIO TRACKS ───────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/lblAudioSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_info_section_audio"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutAudioTracksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtNoAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_info_no_audio"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:fontStyle="italic"
                android:padding="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── SECTION 3: SUBTITLE TRACKS ────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/lblSubtitlesSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_info_section_subtitles"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutSubtitleTracksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtNoSubtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_info_no_subtitles"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:fontStyle="italic"
                android:padding="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── SECTION 4: FILE & CONTAINER DETAILS ────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_info_section_general"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_player_glass_card"
                android:padding="14dp">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_container"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtContainer"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        tools:text="MKV (Matroska)" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_size"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtFileSize"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        tools:text="2.45 GB (2,631,234,567 bytes)" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_duration"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtDuration"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        tools:text="01:45:23" />
                </TableRow>

                <TableRow
                    android:id="@+id/rowOverallBitrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_overall_bitrate"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtOverallBitrate"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        tools:text="15.6 Mbps (Estimated)" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/video_info_path"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/txtLocation"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:ellipsize="start"
                        android:singleLine="true"
                        tools:text="/storage/emulated/0/Movies/film.mkv" />
                </TableRow>
            </LinearLayout>
        </LinearLayout>

        <!-- ── BUTTONS ───────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopySpecs"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/video_info_copy"
                app:icon="@drawable/ic_copy"
                app:iconSize="18dp"
                app:backgroundTint="#33FFFFFF"
                android:textColor="@android:color/white"
                app:iconTint="@android:color/white"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="90dp"
                android:text="@string/close"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_support_dialog_card"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- Success Badge Circle -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_icon_circle_accent"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_success"
            app:tint="@color/ufm_progress_fill" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/support_success_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Message Body -->
    <TextView
        android:id="@+id/txtDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="@string/support_success_message"
        android:textColor="@color/tv_text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <!-- TV OK Button -->
    <Button
        android:id="@+id/btnDialogOk"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@android:string/ok"
        android:textColor="@color/tv_text_primary"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:focusable="true"
        android:background="@drawable/selector_tv_button" />

</LinearLayout>

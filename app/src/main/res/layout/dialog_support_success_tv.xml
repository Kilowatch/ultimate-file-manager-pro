<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Support Success Dialog - TV glass card with yellow focus
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Success Badge in Frosted Squircle -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_tv_card_glass">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_success"
            app:tint="@color/ufm_progress_fill"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/support_success_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Message Body -->
    <TextView
        android:id="@+id/txtDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="24dp"
        android:text="@string/support_success_message"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp" />

    <!-- TV OK Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogOk"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/selector_tv_button_yellow"
        android:textColor="@color/selector_tv_button_text_yellow"
        app:cornerRadius="24dp"
        android:text="@android:string/ok"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:focusable="true"
        android:clickable="true" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Support Success Dialog - TV glass card with yellow focus
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_glass_card"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Success Badge -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_success"
        app:tint="@color/ufm_progress_fill"
        android:layout_marginBottom="12dp"
        android:contentDescription="@null" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/support_success_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Message Body -->
    <TextView
        android:id="@+id/txtDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="22dp"
        android:text="@string/support_success_message"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp" />

    <!-- TV OK Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogOk"
        style="@style/TvContinueButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@android:string/ok"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:focusable="true"
        android:clickable="true"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="700dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="32dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="18dp">

        <ImageView
            android:id="@+id/imgHeroIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_edit"
            app:tint="@color/tv_accent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rename_drive_dialog_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="6dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_secondary"
        android:textSize="15sp"
        android:textAlignment="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="24dp" />

    <!-- Text Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutDriveName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/custom_name_hint"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/tv_accent"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDriveName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/tv_text_primary"
            android:textSize="18sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveRename"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/storage_rename_save_btn"
        android:background="@drawable/tv_button_selector"
        android:textColor="@color/tv_text_primary"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <!-- Reset to Default Button -->
    <Button
        android:id="@+id/btnResetRename"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/storage_rename_reset_btn"
        android:background="@drawable/bg_tv_btn_delete_selector"
        android:textColor="@android:color/white"
        android:focusable="true"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/cancel"
        android:background="@drawable/selector_tv_button"
        android:textColor="@color/tv_text_primary"
        android:focusable="true" />

</LinearLayout>

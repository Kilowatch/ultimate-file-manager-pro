<?xml version="1.0" encoding="utf-8"?>
<!--
    FR-09 "Drive Still in Use" confirmation (TV) — UFMStandard glass dialog.
    Shown instead of unmounting when the release phase still finds claims on the volume.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="26dp">

    <!-- Hero Warning Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_danger"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/imgHeroIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_warning"
            app:tint="?attr/ufmDenied"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/volume_still_in_use_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <!-- Explanation -->
    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="14dp"
        tools:text="The app still has SD Card open. Unmounting now may leave data unwritten or cause errors." />

    <!-- What is still holding the volume, one label:count per line -->
    <TextView
        android:id="@+id/txtDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="viewStart"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="20dp"
        tools:text="Open files: 2\nWatched folders: 3" />

    <!-- Primary: proceed anyway. Plain Button, not MaterialButton: the D-pad focus state
         comes from @drawable/selector_tv_button_danger (white stroke + ufmDenied fill when
         focused), and MaterialButton ignores android:background. Same form as the sibling
         destructive confirm, dialog_apk_extract_reset_confirm_tv.xml. White text reads on
         both states — the default fill is glass, the focused fill is danger red. -->
    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/volume_still_in_use_continue"
        android:background="@drawable/selector_tv_button_danger"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:drawableStart="@drawable/ic_warning"
        android:drawablePadding="8dp"
        android:drawableTint="@android:color/white"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <!-- Secondary: the safe exit, and what Back does. This is the initially-focused button
         (VolumeStillInUseDialog requestFocus), so its focus state is the one that matters
         most — @color/tv_button_text_selector keeps the label legible on the yellow fill. -->
    <Button
        android:id="@+id/btnKeepMounted"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/volume_still_in_use_keep"
        android:background="@drawable/selector_tv_button"
        android:textColor="@color/tv_button_text_selector"
        android:textSize="14sp"
        android:focusable="true" />

</LinearLayout>

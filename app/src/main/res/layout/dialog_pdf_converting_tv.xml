<?xml version="1.0" encoding="utf-8"?>
<!-- Premium non-cancellable PDF conversion progress dialog (TV) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/bg_dialog_glass"
    android:gravity="center"
    android:layout_gravity="center">

    <!-- Spinning ring with PDF icon centred inside -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="24dp">

        <ProgressBar
            android:id="@+id/progressPremium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/bg_premium_progress" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_file_pdf"
            app:tint="@color/tv_accent" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pdf_converting_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <!-- Filename being converted -->
    <TextView
        android:id="@+id/txtFilename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp"
        android:textAlignment="center"
        android:singleLine="true"
        android:ellipsize="middle" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="850dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/batch_rename_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:focusable="false"
        android:layout_marginBottom="16dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Pattern EditText -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextColor="@color/tv_text_hint"
                app:boxStrokeColor="@color/tv_button_focused_yellow"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/batch_rename_hint"
                    android:singleLine="true"
                    android:textColor="@color/tv_text_primary"
                    android:textColorHint="@color/tv_text_hint"
                    android:textSize="18sp"
                    android:paddingVertical="16dp"
                    android:focusable="true"
                    android:nextFocusDown="@id/btnToggleOriginal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Inline error text -->
            <TextView
                android:id="@+id/txtPatternError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_button_focused_yellow"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:focusable="false" />

            <!-- Option toggle buttons -->
            <LinearLayout
                android:id="@+id/layoutOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleOriginal"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:text="@string/batch_rename_option_original"
                    android:textSize="15sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:checkable="true"
                    app:backgroundTint="@color/selector_tv_toggle_btn_bg"
                    android:textColor="@color/selector_tv_toggle_btn_text"
                    app:strokeColor="@color/tv_button_stroke"
                    app:strokeWidth="1dp"
                    app:cornerRadius="28dp"
                    android:nextFocusRight="@id/btnTogglePadding"
                    android:nextFocusDown="@id/edtPaddingLength"
                    style="@style/Widget.Material3.Button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTogglePadding"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/batch_rename_option_padding"
                    android:textSize="15sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:focusable="true"
                    android:checkable="true"
                    app:backgroundTint="@color/selector_tv_toggle_btn_bg"
                    android:textColor="@color/selector_tv_toggle_btn_text"
                    app:strokeColor="@color/tv_button_stroke"
                    app:strokeWidth="1dp"
                    app:cornerRadius="28dp"
                    android:nextFocusLeft="@id/btnToggleOriginal"
                    android:nextFocusDown="@id/edtPaddingLength"
                    style="@style/Widget.Material3.Button" />
            </LinearLayout>

            <!-- Padding controls row (initially GONE) -->
            <LinearLayout
                android:id="@+id/layoutPaddingControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <!-- Padding Length Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/txtPaddingLengthLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/batch_rename_padding_length_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"
                        android:focusable="false" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/tv_button_focused_yellow"
                        app:hintEnabled="false"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPaddingLength"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="1"
                            android:text="3"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="16sp"
                            android:paddingVertical="14dp"
                            android:gravity="center"
                            android:focusable="true"
                            android:nextFocusUp="@id/btnToggleOriginal"
                            android:nextFocusRight="@id/edtPaddingStart"
                            android:nextFocusDown="@id/recyclerPreview" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Starting Number Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/txtPaddingStartLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/batch_rename_padding_start_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"
                        android:focusable="false" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/tv_button_focused_yellow"
                        app:hintEnabled="false"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPaddingStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="1"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="16sp"
                            android:paddingVertical="14dp"
                            android:gravity="center"
                            android:focusable="true"
                            android:nextFocusUp="@id/btnToggleOriginal"
                            android:nextFocusLeft="@id/edtPaddingLength"
                            android:nextFocusDown="@id/recyclerPreview" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Preview header -->
            <TextView
                android:id="@+id/txtPreviewHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/batch_rename_preview_header"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:focusable="false" />

            <!-- Preview list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:padding="12dp"
                android:background="@drawable/selector_tv_card"
                android:focusable="true"
                android:nextFocusUp="@id/edtPaddingStart"
                android:nextFocusDown="@id/btnCancel" />
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Action buttons -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/batch_rename_cancel"
            android:textSize="15sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:focusable="true"
            android:nextFocusRight="@id/btnRename"
            android:nextFocusUp="@id/recyclerPreview"
            android:textColor="@color/tv_button_text"
            style="@style/TvContinueButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRename"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/batch_rename_confirm"
            android:textSize="15sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnCancel"
            android:nextFocusUp="@id/recyclerPreview"
            android:textColor="@color/tv_button_text"
            style="@style/TvContinueButton" />
    </LinearLayout>

</LinearLayout>

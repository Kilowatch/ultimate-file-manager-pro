<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".storage.FolderDuplicateFinderActivity">

    <!-- Glass Header Bar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_md">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/folder_duplicate_finder_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="/storage/emulated/0/Download" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scope Filter Bar -->
    <LinearLayout
        android:id="@+id/layoutScopeToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_md"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_view_toggle_container"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnScopeThisFolder"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/duplicate_scope_this_folder"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_view_toggle_item_active"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnScopeAcrossStorage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/duplicate_scope_across_storage"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scope Description Glass Card -->
    <LinearLayout
        android:id="@+id/layoutScopeDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:layout_marginHorizontal="@dimen/margin_md"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_glass_card"
        app:layout_constraintTop_toBottomOf="@id/layoutScopeToggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgScopeDescIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_duplicate_finder"
            android:contentDescription="@null"
            app:tint="?attr/colorSecondaryContainer" />

        <TextView
            android:id="@+id/txtScopeDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12.5sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/duplicate_scope_desc_this_folder" />
    </LinearLayout>

    <!-- Initial Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBarLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutScopeDesc"
        app:layout_constraintBottom_toTopOf="@id/layoutVerifying"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/margin_lg"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutScopeDesc"
        app:layout_constraintBottom_toTopOf="@id/layoutVerifying"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_circle_accent"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_duplicate_finder"
                android:contentDescription="@null"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_duplicates_found_title"
            android:textColor="@color/mobile_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_duplicates_found_message"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Main List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDuplicates"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/margin_md"
        android:paddingVertical="@dimen/margin_sm"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layoutScopeDesc"
        app:layout_constraintBottom_toTopOf="@id/layoutVerifying"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "Verifying content…" progress row -->
    <LinearLayout
        android:id="@+id/layoutVerifying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/margin_md"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fabDeleteDuplicates"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/progressBarVerifying"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txtVerifying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/analyzer_dup_verifying"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Delete FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabDeleteDuplicates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="@string/analyzer_delete_selected"
        android:textColor="@color/white"
        app:icon="@drawable/ic_delete"
        app:iconTint="@color/white"
        app:backgroundTint="@color/ufm_risk_manual"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

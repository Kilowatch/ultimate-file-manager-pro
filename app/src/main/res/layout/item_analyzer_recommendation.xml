<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleanup Recommendation Card — Language & Grouped Glass Card Standard
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke"
    app:rippleColor="@color/mobile_glass_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon Badge + Risk Pill + Savings Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 40dp Frosted Squircle Hero Badge -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icon_frosted"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/imgRecIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_junk"
                    app:tint="@color/ufm_risk_safe"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- Risk Badge Pill -->
            <TextView
                android:id="@+id/txtRecRisk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_badge_risk_safe"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                tools:text="SAFE"
                tools:textColor="@color/ufm_risk_safe" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Savings Pill Badge -->
            <TextView
                android:id="@+id/txtRecSavings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_btn_icon_frosted"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                tools:text="Save 1.2 GB" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/txtRecTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/mobile_card_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-bold"
            tools:text="Clear Cache &amp; Temp Files" />

        <!-- Description -->
        <TextView
            android:id="@+id/txtRecDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/mobile_card_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2.5dp"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Found 247 cache and temporary files in application cache directories that can be safely removed." />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mobile_glass_stroke"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp" />

        <!-- Action Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/analyzer_action_review"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

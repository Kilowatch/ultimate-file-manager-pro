<?xml version="1.0" encoding="utf-8"?>
<!-- WiFi Remote Authorization Guide — Premium Glassmorphic Dialog -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_xl"
    android:background="@drawable/bg_dialog_glass">

    <!-- Hero Remote Icon -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_tv_remote"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/use_remote_disabled"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <!-- Target TV Subtitle -->
    <TextView
        android:id="@+id/tvRemoteTargetTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="18dp"
        tools:text="Connect directly to Living Room TV using ADB" />

    <!-- 3-Step Setup Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_reindex_option_card"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTHORIZATION STEPS"
            android:textSize="11sp"
            android:textColor="@color/mobile_text_secondary"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Make sure your TV is turned on and on the same WiFi network."
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. Tap Allow on the ADB authorization prompt on your TV screen."
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3. Check &quot;Always allow from this computer&quot; to stay connected."
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.2" />

    </LinearLayout>

    <!-- Connect & Enable Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Connect &amp; Enable"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_tv_remote"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="?attr/colorOnPrimary" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:textAllCaps="false" />

</LinearLayout>

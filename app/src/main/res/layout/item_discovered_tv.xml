<?xml version="1.0" encoding="utf-8"?>
<!-- Discovered TV Item Card — Premium Re-Index Standard -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_reindex_option_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical">

    <!-- TV Icon Frame -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_badge_step_pill"
        android:layout_marginEnd="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_tv"
            app:tint="?attr/colorPrimary" />
    </FrameLayout>

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtDiscoveredTvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/mobile_text_primary"
            android:textSize="15sp"
            tools:text="Living Room TV" />

        <TextView
            android:id="@+id/txtDiscoveredTvIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp"
            tools:text="192.168.1.100" />
    </LinearLayout>

    <!-- Arrow Forward -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_arrow_forward"
        app:tint="?attr/colorPrimary"
        android:layout_marginStart="8dp" />

</LinearLayout>

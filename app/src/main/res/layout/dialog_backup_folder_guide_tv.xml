<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup Folder Guidance Dialog — TV Standard
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_dialog_surface"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_tv_card_glass"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_folder"
            app:tint="@color/tv_button_focused_yellow"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_backup_folder_guide_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="10dp" />

    <!-- Current Location Preview Box -->
    <LinearLayout
        android:id="@+id/cardCurrentLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_backup_folder_guide_current"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtCurrentPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:ellipsize="middle"
            tools:text="/storage/emulated/0/Documents/UFM/backups" />
    </LinearLayout>

    <!-- Message / Guidance -->
    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_backup_folder_guide_msg"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="20dp" />

    <!-- Choose Folder Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBrowse"
        style="@style/TvGrantButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/auto_backup_folder_guide_btn_choose"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:focusable="true"
        android:layout_marginBottom="10dp" />

    <!-- Reset to Default Button (Visible if custom path configured) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetDefault"
        style="@style/TvContinueButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/auto_backup_reset_default"
        android:textSize="14sp"
        android:focusable="true"
        android:layout_marginBottom="10dp" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/TvContinueButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/cancel"
        android:textSize="14sp"
        android:focusable="true" />

</LinearLayout>

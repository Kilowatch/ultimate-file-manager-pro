<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_mobile_gradient">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/mobile_icon_tint"
        android:alpha="0.4" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_remote_select_device"
        android:textColor="@color/mobile_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp" />

    <!-- Device list -->
    <ListView
        android:id="@+id/listDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@color/mobile_glass_header"
        android:dividerHeight="1dp"
        android:maxHeight="360dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_remote_cancel"
            android:textColor="@color/mobile_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetAdd"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_remote_add_tv"
            android:textColor="?attr/colorPrimary" />

    </LinearLayout>

</LinearLayout>

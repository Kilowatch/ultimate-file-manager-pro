<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Playback Speed Dialog — UFMStandard Glass
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- Header Icon Badge -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_speed"
        app:tint="@color/tv_accent"
        android:layout_marginBottom="10dp"
        android:importantForAccessibility="no" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/svg_playback_speed"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />

    <!-- RecyclerView for Speeds -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSpeeds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:overScrollMode="never"
        android:layout_marginBottom="20dp" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="@string/cancel"
        android:background="@drawable/selector_tv_button"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textColor="@color/tv_button_text_selector"
        android:textSize="15sp"
        android:focusable="true"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/tv_safe_horizontal"
    android:paddingTop="22dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageButton
            android:id="@+id/btnOnboardingBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/selector_tv_icon_btn"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/onboarding_btn_back"
            android:focusable="true"
            app:tint="@color/tv_icon_tint" />

        <TextView
            android:id="@+id/txtOnboardingStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_pill_selected"
            android:textColor="@color/tv_accent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            tools:text="STEP 1 OF 8" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtStepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        tools:text="Step Title" />

    <TextView
        android:id="@+id/txtStepDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        tools:text="Step Description" />

</LinearLayout>

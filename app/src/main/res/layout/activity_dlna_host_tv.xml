<?xml version="1.0" encoding="utf-8"?>
<!--
    TV DLNA Host — same structure as TV Server Host but with DLNA cards only.
    Key fix: "DLNA Settings" is a separate focusable row so D-pad can select it.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".server.DlnaHostActivity">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:background="@drawable/selector_tv_icon_btn" />

        <View
            android:layout_width="1.5dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="14dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlna_host_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlna_host_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- ═══ DLNA Media Server Toggle Row ═══ -->
            <LinearLayout
                android:id="@+id/layoutDlnaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/selector_tv_list_item"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:duplicateParentState="true"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dlna_server_title"
                        android:textColor="@color/selector_tv_button_text_yellow"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:duplicateParentState="true" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDlna"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="false"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_port_info"
                    android:textColor="@color/selector_tv_btn_secondary_text"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true" />

                <TextView
                    android:id="@+id/txtDlnaUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_url_box"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ═══ DLNA Settings Row (separate focusable row — fixes TV D-pad selection) ═══ -->
            <LinearLayout
                android:id="@+id/layoutDlnaSettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/selector_tv_list_item"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    app:tint="@color/selector_tv_button_text_yellow" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dlna_settings_row_label"
                        android:textColor="@color/selector_tv_button_text_yellow"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:duplicateParentState="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dlna_settings_row_subtitle"
                        android:textColor="@color/selector_tv_btn_secondary_text"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    android:rotation="-90"
                    android:duplicateParentState="true"
                    app:tint="@color/selector_tv_btn_secondary_text"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- ═══ DLNA Renderer Toggle Row ═══ -->
            <LinearLayout
                android:id="@+id/layoutDlnaRendererCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/selector_tv_list_item"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:duplicateParentState="true"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dlna_renderer_title"
                        android:textColor="@color/selector_tv_button_text_yellow"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:duplicateParentState="true" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDlnaRenderer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="false"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_renderer_description"
                    android:textColor="@color/selector_tv_btn_secondary_text"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true" />

                <TextView
                    android:id="@+id/txtDlnaRendererUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_url_box"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    SAF Picked File Action Dialog — Android TV Layout (UFMStandard)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_dialog_glass">

    <!-- Header with Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:src="@drawable/ic_folder"
            android:background="@drawable/bg_btn_icon_frosted"
            app:tint="@color/tv_accent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/txtDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/saf_file_action_dialog_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Remember Checkbox -->
    <CheckBox
        android:id="@+id/chkRemember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/saf_file_action_remember"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"
        android:focusable="true" />

    <!-- Action Buttons (TV Standard) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Primary Action: Open in Viewer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenViewer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/saf_file_action_open_viewer"
            android:textColor="@color/tv_button_focused_yellow_text"
            android:background="@drawable/selector_tv_button_yellow"
            app:backgroundTint="@null"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Secondary Action: Copy to Local Storage -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyLocal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/saf_file_action_copy_local"
            android:textColor="@color/tv_button_text_selector"
            android:background="@drawable/selector_tv_button"
            app:backgroundTint="@null"
            android:focusable="true"
            android:layout_marginBottom="4dp" />

        <!-- Destination Info & Change Action -->
        <LinearLayout
            android:id="@+id/layoutDestinationInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtDestinationPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeDestination"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/saf_copy_destination_change"
                android:textColor="@color/tv_button_text_selector"
                android:background="@drawable/selector_tv_button"
                app:backgroundTint="@null"
                android:focusable="true"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/cancel"
            android:textColor="@color/tv_button_text_selector"
            android:background="@drawable/selector_tv_button"
            app:backgroundTint="@null"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>

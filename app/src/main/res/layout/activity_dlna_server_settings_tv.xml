<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".server.DlnaServerSettingsActivity">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:background="@drawable/selector_tv_icon_btn"
            app:tint="@color/tv_text_primary" />

        <View
            android:layout_width="1.5dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="14dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dlna_server_settings"
            android:textColor="@color/tv_text_primary"
            android:textSize="17sp"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Server Name Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/selector_tv_list_item"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_server_name_label"
                    android:textColor="@color/selector_tv_button_text_yellow"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_sm"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/tv_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editServerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tv_text_primary"
                        android:inputType="text"
                        android:maxLines="1"
                        android:hint="@string/dlna_server_name_default" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Renderer Name Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/selector_tv_list_item"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_renderer_name_label"
                    android:textColor="@color/selector_tv_button_text_yellow"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_sm"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/tv_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editRendererName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tv_text_primary"
                        android:inputType="text"
                        android:maxLines="1"
                        android:hint="@string/dlna_renderer_name_default" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Shared Folders Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/selector_tv_list_item"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_shared_folders_label"
                    android:textColor="@color/selector_tv_button_text_yellow"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Empty state -->
                <TextView
                    android:id="@+id/txtNoFolders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_no_folders_configured"
                    android:textColor="@color/selector_tv_btn_secondary_text"
                    android:textSize="14sp"
                    android:layout_marginTop="@dimen/margin_sm"
                    android:visibility="visible" />

                <!-- Folder list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSharedFolders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_sm"
                    android:visibility="gone"
                    android:focusable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFolder"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_add_folder"
                    android:layout_marginTop="@dimen/margin_sm"
                    android:focusable="true"
                    app:icon="@drawable/ic_folder" />
            </LinearLayout>

            <!-- Security Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dlna_security_warning"
                android:textColor="@color/selector_tv_btn_secondary_text"
                android:textSize="14sp"
                android:gravity="center"
                android:alpha="0.7"
                android:layout_marginBottom="12dp" />

            <!-- Port Display -->
            <TextView
                android:id="@+id/txtPortInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/save"
                android:textSize="16sp"
                app:cornerRadius="26dp"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

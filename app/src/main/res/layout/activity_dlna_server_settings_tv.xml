<?xml version="1.0" encoding="utf-8"?>
<!--
    TV DLNA Server Settings Activity — Language & Grouped Glass Card Standard
    Configuration: Server Name, Renderer Name, and Shared Directory List
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".server.DlnaServerSettingsActivity">

    <!-- 72dp Fixed Glass Header Bar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:background="@color/tv_glass_white_10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:background="@drawable/selector_tv_icon_btn"
            app:tint="@color/tv_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dlna_server_settings"
            android:textColor="@color/tv_text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginStart="20dp" />
    </LinearLayout>

    <!-- Scrollable Form Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp">

            <!-- Top Guidance Notice Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/tv_glass_white_10"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_icon_circle_accent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_about"
                            app:tint="@color/white"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dlna_settings_info_notice"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TV Section 1 Header: Identification -->
            <TextView
                android:id="@+id/labelSectionIdentification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlna_section_identification"
                android:textColor="@color/tv_accent"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:paddingStart="4dp"
                android:paddingBottom="10dp" />

            <!-- TV Card 1: Identification -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/tv_glass_white_10"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Server Name Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dlna_server_name_label"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/tv_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editServerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tv_text_primary"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:hint="@string/dlna_server_name_default"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/tv_glass_border" />

                    <!-- Renderer Name Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dlna_renderer_name_label"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/tv_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editRendererName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tv_text_primary"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:hint="@string/dlna_renderer_name_default"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TV Section 2 Header: Shared Directories -->
            <TextView
                android:id="@+id/labelSectionSharedFolders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dlna_section_shared_folders"
                android:textColor="@color/tv_accent"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:paddingStart="4dp"
                android:paddingBottom="10dp" />

            <!-- TV Card 2: Shared Folders -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/tv_glass_white_10"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Empty State Container -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyFolders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingVertical="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtNoFolders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dlna_no_folders_configured"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dlna_empty_shared_folders_desc"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Folders RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSharedFolders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="visible" />

                    <!-- Add Folder Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddFolder"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/dlna_add_folder"
                        android:focusable="true"
                        app:icon="@drawable/ic_folder" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Port & Security Warning -->
            <TextView
                android:id="@+id/txtPortInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="4dp"
                tools:text="Port 8200 • Unencrypted media streaming" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dlna_security_warning"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:alpha="0.7"
                android:layout_marginBottom="16dp" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/save"
                android:textSize="16sp"
                app:cornerRadius="26dp"
                android:focusable="true" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

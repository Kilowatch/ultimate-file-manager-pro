<?xml version="1.0" encoding="utf-8"?>
<!-- One-Time Security Recovery Key Display — UFMStandard Glass Dialog -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- 56dp Frosted Lock Badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_security_lock"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/security_recovery_code_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle / Warning -->
    <TextView
        android:id="@+id/txtRecoveryBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/security_recovery_code_body"
        android:layout_marginBottom="18dp" />

    <!-- Monospace Key Display Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke"
        android:layout_marginBottom="18dp">

        <TextView
            android:id="@+id/txtSecurityRecoveryKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="19sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingVertical="14dp"
            android:paddingHorizontal="8dp"
            tools:text="K9vP-7xLm-2qRt-W8bN" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Copy Button (Stacked) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyRecoveryKey"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/security_recovery_code_copy"
        android:textColor="@color/white"
        android:textSize="14.5sp"
        android:fontFamily="sans-serif-bold"
        app:icon="@drawable/ic_copy"
        app:iconTint="@color/white"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Done Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecoveryDone"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/done"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient">

    <!-- TV Header -->
    <LinearLayout
        android:id="@+id/layerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/selector_tv_icon_btn"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:clickable="true"
            app:tint="@color/tv_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/online_storages_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/online_storages_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAddStorage"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="14dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/selector_tv_icon_btn"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:clickable="true"
            android:nextFocusDown="@+id/rvStorages"
            app:tint="@color/tv_text_primary" />
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="60dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layerHeader"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_cloud"
            android:alpha="0.4"
            app:tint="@color/tv_text_secondary" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/online_storages_empty_title"
            android:textColor="@color/tv_text_secondary"
            android:textSize="22sp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/online_storages_empty_subtitle"
            android:textColor="@color/tv_text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:alpha="0.7"
            android:lineSpacingMultiplier="1.4" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStorages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="32dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/layerHeader"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReorderSlot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- Position Badge -->
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/txtSlotPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-black"
                tools:text="1" />
        </FrameLayout>

        <!-- Icon Badge -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imgSlotIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/colorPrimary"
                tools:src="@drawable/ic_delete" />
        </FrameLayout>

        <!-- Name & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/txtSlotName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="14.5sp"
                android:fontFamily="sans-serif-bold"
                tools:text="Delete" />

            <TextView
                android:id="@+id/txtSlotSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="11.5sp"
                android:visibility="gone"
                tools:text="Action description" />
        </LinearLayout>

        <!-- Remove Action Button -->
        <FrameLayout
            android:id="@+id/btnRemoveSlot"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/cd_remove_action">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="@color/mobile_icon_tint"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Drag Handle -->
        <FrameLayout
            android:id="@+id/btnDragHandle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="@string/cd_drag_handle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_drag_handle"
                app:tint="@color/mobile_icon_tint"
                android:importantForAccessibility="no" />
        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

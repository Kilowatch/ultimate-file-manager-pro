<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/mobile_glass_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Protocol icon -->
        <ImageView
            android:id="@+id/imgShareType"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_network"
            app:tint="@color/mobile_icon_tint" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">
            <TextView
                android:id="@+id/txtShareName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Main NAS"
                xmlns:tools="http://schemas.android.com/tools" />
            <TextView
                android:id="@+id/txtShareHost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="SMB • 192.168.1.100" />
            <LinearLayout
                android:id="@+id/layoutWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                tools:visibility="visible">
                <ImageView
                    android:id="@+id/imgWarning"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/status_error" />
                <TextView
                    android:id="@+id/txtWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_action_required_warning"
                    android:textColor="@color/status_error"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Edit button -->
        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/mobile_text_secondary" />

        <!-- Delete button -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_delete"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/status_error" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

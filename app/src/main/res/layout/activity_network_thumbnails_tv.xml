<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_white_10"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/selector_tv_icon_btn" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/margin_md">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_network_thumbnails_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_network_thumbnails_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/tv_safe_horizontal"
            android:paddingTop="@dimen/margin_xl"
            android:paddingBottom="48dp">

            <!-- Enable Toggle -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEnable"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_tv_button_yellow"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_tune"
                        android:layout_marginEnd="@dimen/margin_lg"
                        app:tint="@color/selector_tv_icon_tint_yellow" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nt_enable_title"
                            android:textColor="@color/selector_tv_button_text_yellow"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nt_enable_desc"
                            android:textColor="@color/selector_tv_button_text_yellow"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEnable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cache Folder Selector -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCacheFolder"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_tv_button_yellow"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_folder"
                        android:layout_marginEnd="@dimen/margin_lg"
                        app:tint="@color/selector_tv_icon_tint_yellow" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nt_cache_folder_title"
                            android:textColor="@color/selector_tv_button_text_yellow"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:id="@+id/txtCacheFolder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nt_folder_not_selected"
                            android:textColor="@color/selector_tv_button_text_yellow"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_down"
                        android:rotation="-90"
                        app:tint="@color/selector_tv_button_text_yellow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cache Limit Selector -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCacheLimit"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_tv_button_yellow"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_storage_internal"
                        android:layout_marginEnd="@dimen/margin_lg"
                        app:tint="@color/selector_tv_icon_tint_yellow" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nt_cache_limit_title"
                            android:textColor="@color/selector_tv_button_text_yellow"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:id="@+id/txtCacheLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="500 MB"
                            android:textColor="@color/selector_tv_button_text_yellow"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_down"
                        android:rotation="-90"
                        app:tint="@color/selector_tv_button_text_yellow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stats -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="12dp"
                android:foreground="@drawable/bg_tv_glass_normal"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nt_stats_title"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:id="@+id/txtStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current usage: 0 MB / 500 MB"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Clear Cache -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnClearCache"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_tv_button_yellow"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_delete"
                        android:layout_marginEnd="@dimen/margin_lg"
                        app:tint="@color/tv_error_red" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nt_clear_cache_title"
                            android:textColor="@color/tv_error_red"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nt_clear_cache_desc"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

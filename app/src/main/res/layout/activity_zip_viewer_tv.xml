<?xml version="1.0" encoding="utf-8"?>
<!-- TV ZIP Viewer — D-pad scrollable RecyclerView with focus border -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".viewer.ZipViewerActivity">

    <!-- TV Header Bar -->
    <LinearLayout
        android:id="@+id/layoutTvHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_white_10"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_icon_btn" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/margin_md">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:ellipsize="middle"
                tools:text="archive.zip" />

            <TextView
                android:id="@+id/txtBreadcrumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:singleLine="true"
                android:visibility="gone"
                tools:text="/path/inside/zip/" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExtractAll"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/extract_all"
            android:textSize="12sp"
            android:focusable="true"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- Loading progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:progressTint="@color/tv_accent"
        android:visibility="gone" />

    <!-- Scrollable Content with Focus Border -->
    <FrameLayout
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/tv_safe_horizontal"
        android:layout_marginBottom="16dp"
        android:padding="4dp"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:background="@drawable/selector_tv_policy_scroll">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerEntries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/margin_xs"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@color/tv_button_focused_yellow"
            android:focusable="false" />
    </FrameLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_folder"
            android:textColor="@color/tv_text_hint"
            android:textSize="@dimen/text_md" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Badge Locked Info Dialog — Mobile Layout (UFMStandard)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- Header with Frosted Squircle Lock Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/badge_locked_dialog_title"
            android:textColor="@color/mobile_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:textAlignment="center"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/txtDialogBadgeLockedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            android:layout_marginTop="4dp"
            tools:text="50 Points Gold Supporter" />
    </LinearLayout>

    <!-- Glass Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/mobile_glass_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- Elevated Icon Container - Clear, Bright Preview -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="88dp"
                android:layout_height="88dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <ImageView
                    android:id="@+id/imgDialogBadgeLockedSquare"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_coffee" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtDialogBadgeLockedMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="13sp"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginTop="14dp"
                tools:text="This custom milestone icon unlocks at 50 points.\n\nYou currently have 0 points (need 50 more points).\n\nEvery $1 in the Tip Jar earns 10 points ($10 = 100 points, $25 = 250 points). Support development above to unlock this icon!" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Primary Action Button: Fuel to Unlock (UFMStandard) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogLockedFuel"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/badge_locked_dialog_btn"
        app:icon="@drawable/ic_coffee"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp" />

    <!-- Secondary Action Button: Cancel (UFMStandard) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogLockedCancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<!-- Premium non-cancellable saving progress dialog (Mobile) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_glass"
    android:gravity="center">

    <!-- Spinning ring with save icon centred inside -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginBottom="16dp">

        <ProgressBar
            android:id="@+id/progressPremium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/bg_premium_progress" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_save"
            app:tint="?attr/colorSecondary" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scanner_saving_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <!-- Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/scanner_saving_message"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center" />

</LinearLayout>

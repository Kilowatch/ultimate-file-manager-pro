<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_glass"
    android:paddingBottom="16dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- File Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/imgFileIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_file_generic"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:singleLine="true"
                android:ellipsize="middle"
                tools:text="sample_video.mkv" />

            <TextView
                android:id="@+id/txtFileDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                tools:text="1.4 GB • video/x-matroska" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search Input (Shown only when > 12 apps) -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/mobile_text_secondary"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:hint="@string/open_with_search_hint"
                android:textColor="@color/mobile_text_primary"
                android:textColorHint="@color/mobile_text_secondary"
                android:textSize="14sp"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Content Area: Loading, Grid, or Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp">

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="visible" />

        <!-- App Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/open_with_no_apps"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchPlayStore"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/open_with_search_store"
                app:icon="@drawable/ic_search"
                app:iconTint="@android:color/white" />
        </LinearLayout>
    </FrameLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp" />

    <!-- Footer Controls (Separated vertical blocks for clean, uncrowded layout) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- "Always use this app" Option Card -->
        <LinearLayout
            android:id="@+id/cardAlways"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_reindex_option_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_icon_frosted"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAlwaysTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/open_with_always_title"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/txtAlwaysSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/open_with_always"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="12sp"
                    tools:text="Remember default for .mp4 files" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAlways"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- Use Android System Chooser Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSystemChooser"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="16dp"
            android:text="@string/open_with_system_chooser"
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            app:icon="@drawable/ic_apps"
            app:iconTint="@color/mobile_icon_tint"
            app:iconGravity="textStart"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>

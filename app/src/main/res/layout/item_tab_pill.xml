<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tabPillContainer"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:layout_marginEnd="4dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_tab_pill_inactive">

    <ImageView
        android:id="@+id/imgTabIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_storage_internal"
        android:contentDescription="@null"
        app:tint="@color/mobile_icon_tint" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtTabTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="160dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            tools:text="Internal Storage" />

        <EditText
            android:id="@+id/edtTabTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:maxWidth="160dp"
            android:singleLine="true"
            android:maxLines="1"
            android:lines="1"
            android:background="@drawable/bg_tab_rename_edit"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textNoSuggestions|text"
            android:visibility="gone"
            tools:text="Tab 1" />
    </FrameLayout>

</LinearLayout>

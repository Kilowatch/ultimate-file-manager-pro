<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/selector_tv_card"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="0dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/tv_glass_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_glass_card">

        <TextView
            android:id="@+id/txtFilename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="middle"
            android:singleLine="true"
            tools:text="example_file.mp4" />

        <TextView
            android:id="@+id/txtPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp"
            android:ellipsize="start"
            android:singleLine="true"
            android:layout_marginTop="4dp"
            tools:text="/storage/emulated/0/Movies/example_file.mp4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/txtSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_button_focused_yellow"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                tools:text="1.2 GB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/extracted_str"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                tools:text="video/mp4" />
                
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
                
            <TextView
                android:id="@+id/txtStorage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:gravity="end"
                tools:text="internal" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

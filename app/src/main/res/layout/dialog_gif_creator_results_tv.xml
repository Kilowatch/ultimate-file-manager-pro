<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/bg_dialog_glass">

    <TextView
        android:id="@+id/txtResultsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gif_creator_complete"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/tv_text_primary" />

    <TextView
        android:id="@+id/txtResultsDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="28dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/selector_tv_button"
            android:focusable="true"
            android:text="@string/close"
            android:textColor="@color/tv_text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewGif"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/selector_tv_button_yellow"
            android:textColor="@color/selector_tv_button_text_yellow"
            app:cornerRadius="12dp"
            android:focusable="true"
            android:text="@string/gif_creator_view" />
    </LinearLayout>

</LinearLayout>

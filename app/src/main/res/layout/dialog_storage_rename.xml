<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/imgHeroIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_edit"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/rename_drive_dialog_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="4dp" />

    <!-- Subtitle / Original Drive Name -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="20dp" />

    <!-- Text Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutDriveName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/custom_name_hint"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="?attr/colorPrimary"
        android:layout_marginBottom="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDriveName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/mobile_text_primary"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveRename"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/storage_rename_save_btn"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:backgroundTint="?attr/colorPrimary"
        android:layout_marginBottom="6dp" />

    <!-- Reset to Default Button (Visible when customized) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetRename"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/storage_rename_reset_btn"
        android:textColor="@color/status_error"
        android:textSize="13.5sp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_undo"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconTint="@color/status_error"
        app:strokeColor="@color/status_error"
        app:strokeWidth="1dp"
        app:backgroundTint="@android:color/transparent"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/cancel"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        android:textColor="@color/mobile_text_secondary" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Smart Sort Storage / Drive Row — TV (Language & Grouped Glass Card Standard)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:cardBackgroundColor="@color/tv_glass_white_10"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/tv_glass_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:duplicateParentState="true">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:duplicateParentState="true">

            <ImageView
                android:id="@+id/imgFolderIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                android:contentDescription="@string/cd_storage_icon"
                app:tint="@color/selector_tv_storage_category_icon_tint"
                android:duplicateParentState="true" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:duplicateParentState="true">

            <TextView
                android:id="@+id/txtFolderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/selector_tv_storage_category_text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="middle"
                android:duplicateParentState="true"
                tools:text="Internal Storage" />

            <TextView
                android:id="@+id/txtFolderPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/selector_tv_storage_category_text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="middle"
                android:duplicateParentState="true"
                tools:text="/storage/emulated/0" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/selector_tv_storage_category_icon_tint"
            android:duplicateParentState="true"
            android:importantForAccessibility="no" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

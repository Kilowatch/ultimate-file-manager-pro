<?xml version="1.0" encoding="utf-8"?>
<!--
    Bulk Duplicate Cleanup Completion Dialog — TV (UFMStandard)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="26dp">

    <!-- Hero Success Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            app:tint="@color/tv_button_focused_yellow_text"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtCompletionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/analyzer_delete_completion_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <!-- Summary Message -->
    <TextView
        android:id="@+id/txtCompletionMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="16dp"
        tools:text="Successfully deleted 45 duplicate files and reclaimed 350 MB of storage space." />

    <!-- Optional Failure Warning -->
    <TextView
        android:id="@+id/txtCompletionFailure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="?attr/ufmDenied"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        tools:text="2 files could not be deleted due to permissions." />

    <!-- Done Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCompletionDone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/done"
        android:textColor="@color/tv_button_focused_yellow_text"
        android:textSize="15sp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        android:background="@drawable/selector_tv_button_yellow"
        android:focusable="true" />

</LinearLayout>

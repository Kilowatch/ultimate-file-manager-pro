<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tipJarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Toolbar: back + coffee icon + title/subtitle -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="28dp"
        android:background="@color/tv_glass_white_10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_icon_circle_accent"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/cd_back"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_coffee"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tip_jar_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loyalty_card_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Centred content card -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="8dp"
            android:paddingHorizontal="100dp">

            <!-- Transparency blurb -->
            <!-- Transparency blurb -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_jar_transparency"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    android:lineSpacingMultiplier="1.2"
                    android:padding="6dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Loyalty progress card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Progress labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_amount_tipped_label"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.8"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtGoalTarget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_goal_static"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Progress bar -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="15"
                        android:progressTint="?attr/colorPrimary"
                        android:progressBackgroundTint="?attr/colorOnPrimaryContainer"
                        android:layout_marginBottom="4dp" />

                    <!-- Tipped / to-go -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/txtTippedTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_tipped_format"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtToGoTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_to_go_format"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Stamps Grid -->
                    <GridLayout
                        android:id="@+id/gridStamps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:rowCount="1"
                        android:columnCount="15"
                        android:alignmentMode="alignBounds"
                        android:useDefaultMargins="true" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="?attr/colorOnPrimaryContainer"
                        android:alpha="0.2" />

                    <!-- Member status + tier badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/loyalty_status_label"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:alpha="0.7"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/txtMemberTier"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/loyalty_tier_free"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtTierBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_tier_badge_format"
                            android:background="@drawable/bg_icon_circle_accent"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnPrimary"
                            android:backgroundTint="?attr/colorPrimary"
                            android:layout_gravity="center_vertical" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Global Progress Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGlobalProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/txtGlobalTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tip_jar_global_title"
                        android:textColor="@color/tile_tip_jar_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:focusable="false" />

                    <TextView
                        android:id="@+id/txtGlobalDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tip_jar_global_desc"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="9sp"
                        android:alpha="0.7"
                        android:focusable="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:focusable="false">

                        <ProgressBar
                            android:id="@+id/progressGlobal"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:focusable="false"
                            android:progressDrawable="@drawable/bg_tip_jar_progress" />

                        <TextView
                            android:id="@+id/txtGlobalPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/tile_tip_jar_accent"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:focusable="false" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stat Tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:baselineAligned="false">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    android:layout_marginEnd="5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_stat_total_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="9sp" />
                        <TextView
                            android:id="@+id/txtStatTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_currency_format"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    android:layout_marginHorizontal="3dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_stat_coffees_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="9sp" />
                        <TextView
                            android:id="@+id/txtStatCoffees"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_value_format"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    android:layout_marginStart="5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/txtStatGoalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_stat_to_goal_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="9sp" />
                        <TextView
                            android:id="@+id/txtStatGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_currency_format"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Loading indicator -->
            <TextView
                android:id="@+id/txtTipLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tip_jar_loading"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:layout_marginBottom="4dp"
                android:visibility="visible" />

            <!-- Tip buttons (horizontal on TV) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEspresso"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="@string/tip_jar_espresso_title"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="4dp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="8dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLatte"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="@string/tip_jar_latte_title"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginHorizontal="4dp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="8dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBeans"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="@string/tip_jar_beans_title"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginStart="4dp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="8dp"
                    app:elevation="0dp" />
            </LinearLayout>

            <!-- Thank You message -->
            <TextView
                android:id="@+id/txtThankYou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tip_jar_thanks"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/loyalty_disclaimer"
                android:textSize="9sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:alpha="0.6" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Hidden coffee icon for celebration animation -->
    <ImageView
        android:id="@+id/imgCoffeeTv"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_coffee"
        android:visibility="invisible"
        android:tag="coffeeIcon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

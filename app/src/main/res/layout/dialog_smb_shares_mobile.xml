<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile: Share browser dialog — shows all top-level SMB shares -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_glass_card_dark">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_folder"
            app:tint="@color/ufm_primary"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:id="@+id/txtSharesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/smb_shares_title_generic"
            android:textColor="@color/mobile_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <!-- Loading -->
    <LinearLayout
        android:id="@+id/layerLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">
        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smb_shares_loading"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Shares list -->
    <LinearLayout
        android:id="@+id/layerSharesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtNoShares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/smb_shares_none"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="240dp"
            android:nestedScrollingEnabled="true"/>
    </LinearLayout>

    <!-- Cancel -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharesCancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/cancel"/>
</LinearLayout>

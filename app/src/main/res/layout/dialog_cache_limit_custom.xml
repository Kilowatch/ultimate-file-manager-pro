<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ufm_surface"
    android:paddingBottom="20dp">

    <!-- Premium Header with Gradient -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cache_limit_header"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/labelCustomLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadline5"
                android:text="@string/nt_cache_limit_title"
                android:textColor="@color/ufm_text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:text="@string/nt_custom_value_hint"
                android:textColor="@color/ufm_text_secondary"
                android:alpha="0.8" />

        </LinearLayout>

    </FrameLayout>

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp">

        <!-- Preset Options Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Presets"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/ufm_text_secondary"
            android:textAllCaps="true"
            android:alpha="0.7"
            android:layout_marginBottom="12dp" />

        <!-- Preset Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipPresetsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="false"
            android:paddingBottom="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPreset500"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500 MB"
                app:chipIcon="@android:drawable/ic_dialog_info"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPreset1gb"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 GB"
                app:chipIcon="@android:drawable/ic_dialog_info"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPreset2gb"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 GB"
                app:chipIcon="@android:drawable/ic_dialog_info"
                android:layout_margin="4dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPreset5gb"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 GB"
                app:chipIcon="@android:drawable/ic_dialog_info"
                android:layout_margin="4dp" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Custom Value Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Custom Size"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/ufm_text_secondary"
                android:textAllCaps="true"
                android:alpha="0.7"
                android:layout_marginBottom="12dp" />

            <!-- Input with better styling -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/ufm_primary_light"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCacheValue"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="numberDecimal"
                    android:hint="e.g. 3.5"
                    android:importantForAutofill="no"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Unit Selection -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipUnitGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacing="12dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMb"
                    style="?attr/chipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MB"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGb"
                    style="?attr/chipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GB"
                    android:checkable="true" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:spacing="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/delete_cancel"
                style="?attr/materialButtonOutlinedStyle"
                app:cornerRadius="12dp"
                android:paddingHorizontal="24dp"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/network_btn_save"
                style="?attr/materialButtonStyle"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

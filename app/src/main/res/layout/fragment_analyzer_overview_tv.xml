<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Overview Tab Fragment Layout — Language & Grouped Glass Card Standard
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:descendantFocusability="afterDescendants"
        android:padding="24dp">

        <!-- Top TV Guidance Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/tv_glass_white_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tv_glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_circle_accent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_about"
                        app:tint="@color/white"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/analyzer_info_notice"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TV Usage Summary Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUsageSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/tv_glass_white_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tv_glass_border">

            <LinearLayout
                android:id="@+id/layoutUsageSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:background="?android:attr/selectableItemBackground"
                android:padding="20dp">

                <!-- Total disk usage -->
                <TextView
                    android:id="@+id/txtAnalyzerTotalUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="16dp"
                    tools:text="45.2 GB used of 128 GB" />

                <!-- Segmented storage bar -->
                <za.kilowatch.ultimatefilemanager.ui.StorageBarView
                    android:id="@+id/storageBar"
                    android:layout_width="match_parent"
                    android:layout_height="26dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 1 Header: Breakdown -->
        <TextView
            android:id="@+id/labelSectionBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/analyzer_section_storage_breakdown"
            android:textColor="@color/tv_accent"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <!-- Category breakdown Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/tv_glass_white_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tv_glass_border">

            <LinearLayout
                android:id="@+id/layoutOverviewCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2 Header: Top Folders -->
        <TextView
            android:id="@+id/labelSectionTopFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/analyzer_section_top_folders"
            android:textColor="@color/tv_accent"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Top Folders Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTopFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:cardBackgroundColor="@color/tv_glass_white_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tv_glass_border">

            <LinearLayout
                android:id="@+id/layoutTopFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 3 Header: App Usage -->
        <TextView
            android:id="@+id/labelSectionAppUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/analyzer_section_app_usage"
            android:textColor="@color/tv_accent"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- App Usage Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAppUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:cardBackgroundColor="@color/tv_glass_white_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/tv_glass_border">

            <LinearLayout
                android:id="@+id/layoutAppUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

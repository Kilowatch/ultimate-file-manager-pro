<?xml version="1.0" encoding="utf-8"?>
<!--
    Overview Tab Fragment Layout — TV only
    Optimized for DPAD navigation with NestedScrollView for better behavior
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:descendantFocusability="afterDescendants"
        android:paddingHorizontal="@dimen/margin_md"
        android:paddingVertical="@dimen/margin_md">

    <!-- Usage summary container, focusable for D-Pad Up -->
    <LinearLayout
        android:id="@+id/layoutUsageSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/margin_sm"
        android:layout_marginBottom="8dp">

        <!-- Total disk usage -->
        <TextView
            android:id="@+id/txtAnalyzerTotalUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/margin_md"
            tools:text="45.2 GB used of 128 GB" />

        <!-- Segmented storage bar -->
        <za.kilowatch.ultimatefilemanager.ui.StorageBarView
            android:id="@+id/storageBar"
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>

    <!-- Category breakdown -->
    <LinearLayout
        android:id="@+id/layoutOverviewCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Top Folders Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTopFolders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_lg"
        android:visibility="gone"
        android:focusable="false"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analyzer_top_folders"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/margin_sm" />

            <LinearLayout
                android:id="@+id/layoutTopFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- App Usage Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAppUsage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_md"
        android:layout_marginBottom="@dimen/margin_lg"
        android:visibility="gone"
        android:focusable="false"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analyzer_app_usage"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/margin_sm" />

            <LinearLayout
                android:id="@+id/layoutAppUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

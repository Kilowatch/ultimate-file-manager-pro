<?xml version="1.0" encoding="utf-8"?>
<!--
    Mobile Tabbed File Browser — premium dark glassmorphism design
    Hosts FileBrowserFragment and NetworkBrowserFragment across tabs.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".tabs.TabbedBrowserActivity">

    <!-- Modern Glass Header Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Normal Header Content -->
        <LinearLayout
            android:id="@+id/layoutHeaderNormal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Back Button in 40dp Frosted Squircle -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icon_frosted">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/cd_back"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/mobile_icon_tint" />
            </FrameLayout>

            <!-- Storage Badge Pill -->
            <TextView
                android:id="@+id/badgeStorageType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_storage_badge"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                tools:text="LOCAL" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Actions Group -->
            <LinearLayout
                android:id="@+id/headerActionsGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnSearchToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnViewToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_view_list"
                    android:contentDescription="@string/cd_view_toggle"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnSort"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_sort"
                    android:contentDescription="@string/sort_and_filter"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnTwinWindow"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_twin_window"
                    android:contentDescription="@string/twin_window"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

                <ImageView
                    android:id="@+id/btnOptionsToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    android:contentDescription="@string/toggle_options"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_header_action_ripple"
                    app:tint="@color/mobile_icon_tint" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Modern Search Row -->
    <LinearLayout
        android:id="@+id/layoutSearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp"
        android:background="@color/mobile_glass_header"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_modern_search_box">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/mobile_text_secondary"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="@string/type_here_to_search"
                android:textColor="@color/mobile_text_primary"
                android:textColorHint="@color/mobile_text_secondary"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/btnSearchClear"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_header_action_ripple"
                app:tint="@color/mobile_text_secondary"
                android:visibility="gone"
                android:contentDescription="@string/cd_clear_search" />
        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="headerLayout,layoutSearchRow" />

    <!-- Chrome Tab Bar: sits directly below header/search and above breadcrumbs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Path Breadcrumbs Navigation Bar (Below tabs) -->
    <HorizontalScrollView
        android:id="@+id/layoutBreadcrumbsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="16dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toBottomOf="@id/recyclerTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutBreadcrumbs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp" />
    </HorizontalScrollView>

    <!-- ViewPager2 for swipeable, modern tab page transitions -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerTabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutBreadcrumbsScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

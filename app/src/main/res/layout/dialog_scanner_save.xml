<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scanner_save"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp" />

    <!-- Filename -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFilename"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/scanner_filename_hint"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtFilename"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textSize="14sp"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save path -->
    <TextView
        android:id="@+id/txtSavePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="12sp"
        android:textColor="#99FFFFFF"
        android:maxLines="2"
        android:ellipsize="middle" />

    <!-- Select folder button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectFolder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/scanner_select_folder"
        app:cornerRadius="12dp"
        style="@style/Widget.Material3Expressive.Button.OutlinedButton" />

    <!-- Format selector as pills -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="13sp"
        android:textColor="#99FFFFFF"
        android:text="@string/export_format" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFormats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFormatJpeg"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scanner_format_jpeg" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFormatPng"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scanner_format_png" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFormatPdf"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scanner_format_pdf" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Page count info -->
    <TextView
        android:id="@+id/txtPageCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="12sp"
        android:textColor="#66FFFFFF" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSave"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@android:string/cancel"
            app:cornerRadius="12dp"
            style="@style/Widget.Material3Expressive.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSave"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/scanner_save"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>

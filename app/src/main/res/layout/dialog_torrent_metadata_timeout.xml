<?xml version="1.0" encoding="utf-8"?>
<!--
    BitTorrent Swarm Metadata Timeout Dialog — UFMStandard Glass (Mobile)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge (Warning Badge) -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_time"
            app:tint="#FFB300"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/torrent_metadata_timeout_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="6dp" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/torrent_metadata_timeout_msg"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="20dp" />

    <!-- Action 1: Download All Direct (Primary) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownloadAllDirect"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/torrent_download_all_direct"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:backgroundTint="?attr/colorPrimary"
        android:layout_marginBottom="8dp" />

    <!-- Action 2: Keep Waiting (Tonal) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeepWaiting"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/torrent_keep_waiting"
        android:textColor="@color/mobile_text_primary"
        android:textSize="13.5sp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/mobile_glass_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke"
        android:layout_marginBottom="6dp" />

    <!-- Action 3: Cancel -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelTimeout"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp" />

</LinearLayout>

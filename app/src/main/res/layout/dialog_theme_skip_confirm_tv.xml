<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="700dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="32dp"
    android:gravity="center_horizontal">

    <!-- Hero Warning Icon Badge -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="18dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_warning"
            app:tint="@color/mobile_note_color"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_password_skip_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="10dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_password_skip_warning"
        android:textColor="@color/tv_text_secondary"
        android:textSize="15sp"
        android:textAlignment="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="28dp" />

    <!-- Save Unencrypted Button -->
    <Button
        android:id="@+id/btnSaveUnencrypted"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/save_unencrypted"
        android:background="@drawable/selector_tv_button_yellow"
        android:textColor="@color/tv_button_focused_yellow_text"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/cancel"
        android:background="@drawable/selector_tv_button"
        android:textColor="@color/tv_text_primary"
        android:focusable="true" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient">

    <!-- Header Area -->
    <LinearLayout
        android:id="@+id/layerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/selector_tv_icon_btn"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:clickable="true"
            android:nextFocusDown="@+id/edtAuthCode"
            android:nextFocusRight="@+id/edtAuthCode"
            app:tint="@color/tv_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="24dp">
            <TextView
                android:id="@+id/txtAuthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_online_storage_auth_dropbox"
                android:textColor="@color/tv_text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dropbox_device_code_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="60dp"
        app:layout_constraintTop_toBottomOf="@id/layerHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Left Side: Instructions and Code -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:padding="32dp"
            android:background="@drawable/bg_tv_card_glass"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dropbox_device_code_step1"
                android:textColor="@color/tv_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/txtVerificationUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generating URL…"
                android:textColor="@color/tv_accent"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:ellipsize="middle"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dropbox_device_code_step2"
                android:textColor="@color/tv_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/edtAuthCode"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:hint="Paste or enter code here"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="@color/tv_text_secondary"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:background="@drawable/selector_tv_button_yellow"
                android:backgroundTint="@color/tv_glass_white_10"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:focusable="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:text="Connect"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/selector_tv_button_yellow"
                android:textColor="@color/selector_tv_button_text_yellow"
                app:elevation="8dp"
                android:focusable="true" />

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="48dp"
            android:layout_height="match_parent" />

        <!-- Right Side: QR Code -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dropbox_device_code_scan_qr"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="240dp"
                android:layout_height="240dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:background="@color/white">

                <ImageView
                    android:id="@+id/imgQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:scaleType="fitCenter" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_glass">

    <TextView
        android:id="@+id/txtTorrentInspectTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Torrent Information"
        android:textColor="@color/mobile_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-bold" />

    <TextView
        android:id="@+id/txtTorrentInspectFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Header Icon -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_checksum"
        app:tint="@color/tv_button_focused_yellow"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtManifestVerifyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/checksum_manifest_verify_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="2dp" />

    <!-- Manifest Meta -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/txtManifestFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:maxWidth="350dp"
            tools:text="checksums.sha256" />

        <TextView
            android:id="@+id/txtManifestAlgoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_storage_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/tv_button_focused_yellow"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            tools:text="SHA-256" />
    </LinearLayout>

    <!-- Summary / Progress Card -->
    <LinearLayout
        android:id="@+id/layoutManifestSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_glass"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/txtManifestStatusSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            tools:text="3 of 5 verified (60%)" />

        <ProgressBar
            android:id="@+id/progressBarManifest"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:max="100" />
    </LinearLayout>

    <!-- Checklist RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerManifestEntries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="280dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="16dp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelManifest"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/selector_tv_button"
            android:text="@android:string/cancel"
            android:textColor="@color/tv_error_red"
            android:textSize="13sp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnCloseManifest"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/selector_tv_button_yellow"
            android:text="@string/close"
            android:textColor="@color/selector_tv_button_text"
            android:textSize="13sp"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>

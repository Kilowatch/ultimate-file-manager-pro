<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Hero Danger Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_danger"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_undo"
            app:tint="@color/status_error"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/reset_all_confirm_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/reset_all_confirm_message"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13.5sp"
        android:textAlignment="center"
        android:lineSpacingExtra="2.5dp"
        android:layout_marginBottom="24dp" />

    <!-- Confirm Reset Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetConfirm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/reset_all_icons"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_undo"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@android:color/white"
        app:backgroundTint="@color/status_error"
        android:layout_marginBottom="6dp" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/cancel"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        android:textColor="@color/mobile_text_secondary" />

</LinearLayout>

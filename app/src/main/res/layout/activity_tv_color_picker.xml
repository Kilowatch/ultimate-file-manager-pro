<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingTop="@dimen/margin_xxl"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_palette"
            app:tint="@color/tv_accent"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tile_color_custom"
            android:textColor="@color/tv_text_primary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black" />

        <!-- Preview swatch + hex input -->
        <View
            android:id="@+id/tvPickerPreviewSwatch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_color_swatch" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/hexInput"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:maxLength="8"
                android:inputType="textFilter"
                android:digits="0123456789abcdefABCDEF"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:textColor="@color/tv_text_primary"
                android:hint="FF6B35"
                android:textColorHint="@color/tv_text_secondary"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/sliderHue"
                android:nextFocusUp="@+id/btnPickerCancel" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tv_glass_border"
        android:layout_marginHorizontal="@dimen/tv_safe_horizontal" />

    <!-- Body: grid + sliders -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="0dp">

        <!-- LEFT: colour swatch grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerColorGrid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:layout_marginEnd="32dp"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants" />

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="32dp"
            android:background="@color/tv_glass_border" />

        <!-- RIGHT: HSV sliders -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- HUE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_color_hue"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/sliderHue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="360"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp" />

            <!-- SATURATION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_color_saturation"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/sliderSat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp" />

            <!-- VALUE / BRIGHTNESS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_color_brightness"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/sliderVal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Bottom action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingVertical="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickerCancel"
            style="@style/TvContinueButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:text="@string/tile_copy_confirm_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickerOk"
            style="@style/TvGrantButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/tile_copy_confirm_apply" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Share Discovery / Host Scan Dialog (TV Standard)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="28dp">

    <!-- Top Row: 52dp Frosted Badge + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_network"
                app:tint="@color/tv_accent"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/txtScanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smb_scan_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/network_shares_title"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scanning Progress Indicator Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layerScanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/tv_glass_white_10"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/tv_glass_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="true"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtScanningLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/smb_scan_searching"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13.5sp"
                android:gravity="center" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Results Area -->
    <LinearLayout
        android:id="@+id/layerResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/txtNoHosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/smb_scan_none_found"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14.5sp"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="260dp"
            android:nestedScrollingEnabled="true" />
    </LinearLayout>

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="@string/cancel"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14.5sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp" />

</LinearLayout>

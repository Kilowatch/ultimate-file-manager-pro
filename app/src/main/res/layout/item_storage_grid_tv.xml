<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/tv_glass_white_10"
    app:cardCornerRadius="@dimen/card_radius_lg"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp"
        android:padding="24dp"
        android:background="@null">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/bg_glass_card"
            android:padding="25dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/txtStorageLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:id="@+id/imgStorageIcon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_storage_internal"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtStorageLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/internal_storage"
            android:textColor="@color/tv_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconContainer"
            app:layout_constraintBottom_toTopOf="@id/txtStorageCapacity" />

        <TextView
            android:id="@+id/txtStorageCapacity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/s_45_gb_128_gb"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtStorageLabel"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressStorage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:indicatorColor="@color/tv_accent"
            app:trackColor="@color/tv_glass_white_10"
            app:trackThickness="6dp"
            app:trackCornerRadius="3dp"
            android:progress="40"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtStorageCapacity" />

        <!-- Circular Progress Chart (not used on TV usually but kept for compatibility) -->
        <za.kilowatch.ultimatefilemanager.ui.CircularProgressView
            android:id="@+id/circularProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- NEW Badge -->
        <TextView
            android:id="@+id/txtNewBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_badge_accent"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/s_new"
            android:textColor="#FF0284C7"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hide Button (X) -->
        <ImageView
            android:id="@+id/btnHideTile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_remove_circle"
            android:visibility="gone"
            android:contentDescription="@string/hide_tile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

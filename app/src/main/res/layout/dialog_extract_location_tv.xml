<?xml version="1.0" encoding="utf-8"?>
<!--
  TV Extract Location Dialog — centered glassmorphism style.
  Matches dialog_archive_options_tv.xml aesthetic: bg_dialog_glass, tv_text_primary colours,
  yellow selector button for the primary action, standard selector for cancel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="32dp">

    <!-- Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_folder"
        android:tint="@color/tv_accent"
        android:contentDescription="@null" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/extract_location_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Body -->
    <TextView
        android:id="@+id/txtBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/extract_location_body"
        android:textColor="@color/tv_text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="28dp" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSetLocation"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/extract_set_location"
            android:background="@drawable/selector_tv_button_yellow"
            android:textColor="@color/tv_button_focused_yellow_text"
            android:focusable="true"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:background="@drawable/selector_tv_button"
            android:textColor="@color/tv_text_primary"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>

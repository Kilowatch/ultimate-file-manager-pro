<?xml version="1.0" encoding="utf-8"?>
<!--
    Duplicate Group Header — TV
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2dp"
    android:clickable="false"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:background="@drawable/selector_tv_storage_category_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/txtDupToggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="@color/selector_tv_storage_category_text_accent"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            android:duplicateParentState="true"
            tools:text="▼" />

        <TextView
            android:id="@+id/txtDupHash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/selector_tv_storage_category_text_primary"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:duplicateParentState="true"
            tools:text="⋯a3f9c12b0d4e" />

        <TextView
            android:id="@+id/txtDupWasted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/selector_tv_storage_category_text_moderate"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:duplicateParentState="true"
            tools:text="3 copies · saves 48 MB" />

    </LinearLayout>
</FrameLayout>

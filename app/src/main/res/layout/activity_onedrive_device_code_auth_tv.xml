<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient">

    <!-- Header Area -->
    <LinearLayout
        android:id="@+id/layerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/selector_tv_icon_btn"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:clickable="true"
            app:tint="@color/tv_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="24dp">
            <TextView
                android:id="@+id/txtAuthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_online_storage_auth_onedrive"
                android:textColor="@color/tv_text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onedrive_device_code_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="60dp"
        app:layout_constraintTop_toBottomOf="@id/layerHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Left Side: Instructions and Code -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:padding="32dp"
            android:background="@drawable/bg_tv_card_glass"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onedrive_device_code_step1"
                android:textColor="@color/tv_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/txtVerificationUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="microsoft.com/devicelogin"
                android:textColor="@color/tv_accent"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onedrive_device_code_step2"
                android:textColor="@color/tv_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/txtUserCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---- ----"
                android:textColor="@color/tv_button_focused_yellow"
                android:textSize="48sp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_tv_card_glass_dark"
                android:padding="16dp"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:id="@+id/layoutPolling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="32dp">

                <ProgressBar
                    android:id="@+id/progressPolling"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminateTint="@color/tv_accent" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onedrive_auth_waiting"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="16sp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="48dp"
            android:layout_height="match_parent" />

        <!-- Right Side: QR Code -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onedrive_device_code_scan_qr"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="240dp"
                android:layout_height="240dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:background="@color/white">

                <ImageView
                    android:id="@+id/imgQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    tools:src="@tools:sample/avatars" />

                <ProgressBar
                    android:id="@+id/progressQr"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/tv_accent" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code expires in --:--"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="24dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

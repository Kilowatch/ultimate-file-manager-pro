<?xml version="1.0" encoding="utf-8"?>
<!--
    FR-09 "Drive Still in Use" confirmation — UFMStandard glass dialog.
    Shown instead of unmounting when the release phase still finds claims on the volume.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Hero Warning Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_danger"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/imgHeroIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_warning"
            app:tint="?attr/ufmDenied"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/volume_still_in_use_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <!-- Explanation -->
    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13.5sp"
        android:textAlignment="center"
        android:lineSpacingExtra="2.5dp"
        android:layout_marginBottom="14dp"
        tools:text="The app still has SD Card open. Unmounting now may leave data unwritten or cause errors." />

    <!-- What is still holding the volume, one label:count per line -->
    <TextView
        android:id="@+id/txtDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="12.5sp"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="viewStart"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="20dp"
        tools:text="Open files: 2\nWatched folders: 3" />

    <!-- Primary: proceed anyway. Deliberate deviation from the UFMStandard primary button,
         which uses app:backgroundTint="?attr/colorPrimary": this is a destructive action, so
         it carries the denied/error colour instead. The icon and white text are chosen for
         that fill. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/volume_still_in_use_continue"
        android:textColor="@android:color/white"
        android:textSize="14.5sp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_warning"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@android:color/white"
        app:backgroundTint="?attr/ufmDenied"
        android:layout_marginBottom="6dp" />

    <!-- Secondary: the safe exit, and what Back / outside-tap do -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeepMounted"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/volume_still_in_use_keep"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        android:textColor="@color/mobile_text_secondary" />

</LinearLayout>

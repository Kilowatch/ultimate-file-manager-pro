<?xml version="1.0" encoding="utf-8"?>
<!--
    Root layout for the Bookmark Launcher widget.
    Uses RemoteViews — only a subset of Views/attributes are allowed here.
    The ListView (id=widget_list_view) is driven by BookmarkWidgetService.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_card"
    android:padding="0dp">

    <!-- ── Header row ───────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_bg_header"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <!-- Star icon: tinted programmatically in updateWidget() -->
        <ImageView
            android:id="@+id/widget_header_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_star"
            android:contentDescription="@string/widget_bookmark_cd_icon" />

        <!-- "Favorites" label -->
        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/widget_bookmark_title"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- "Open" button — tapping launches StorageBrowserActivity -->
        <TextView
            android:id="@+id/widget_btn_open_app"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/widget_bookmark_open_app"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/widget_bg_open_btn" />

    </LinearLayout>

    <!-- ── Separator (View is not supported in RemoteViews — use FrameLayout) ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A4A" />

    <!-- ── Bookmark list ────────────────────────────────────────── -->
    <ListView
        android:id="@+id/widget_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <!-- ── Empty state (shown by RemoteViews when list is empty) ── -->
    <LinearLayout
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_star"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_bookmark_empty"
            android:textColor="#6B6B8E"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>

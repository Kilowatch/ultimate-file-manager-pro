<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_glass"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_refresh_custom"
        app:tint="@color/tv_button_focused_yellow"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reindex_scope_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="@string/reindex_scope_msg"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/btnOptionShallow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="120dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_tv_reindex_option_card"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_folder"
                app:tint="@color/selector_tv_icon_tint_yellow"
                android:duplicateParentState="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reindex_option_shallow"
                android:textColor="@color/selector_tv_button_text_yellow"
                android:duplicateParentState="true"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reindex_option_shallow_desc"
                android:textColor="@color/selector_tv_btn_secondary_text"
                android:duplicateParentState="true"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOptionRecursive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="120dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_tv_reindex_option_card"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_sync"
                app:tint="@color/selector_tv_icon_tint_yellow"
                android:duplicateParentState="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reindex_option_recursive"
                android:textColor="@color/selector_tv_button_text_yellow"
                android:duplicateParentState="true"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reindex_option_recursive_desc"
                android:textColor="@color/selector_tv_btn_secondary_text"
                android:duplicateParentState="true"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="180dp"
        android:layout_height="44dp"
        android:text="@string/cancel"
        android:background="@drawable/selector_tv_button"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textColor="@color/tv_button_text_selector"
        android:focusable="true"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sort"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtSortTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bookmark_sort_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />

    <!-- Option 1: Newest -->
    <LinearLayout
        android:id="@+id/optSortNewest"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_reindex_option_card"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bookmark_sort_newest"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/imgCheckNewest"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Option 2: Oldest -->
    <LinearLayout
        android:id="@+id/optSortOldest"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_reindex_option_card"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bookmark_sort_oldest"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/imgCheckOldest"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Option 3: Title A-Z -->
    <LinearLayout
        android:id="@+id/optSortTitleAz"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_reindex_option_card"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bookmark_sort_title_az"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/imgCheckTitleAz"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Option 4: Title Z-A -->
    <LinearLayout
        android:id="@+id/optSortTitleZa"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_reindex_option_card"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bookmark_sort_title_za"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/imgCheckTitleZa"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Option 5: File Size -->
    <LinearLayout
        android:id="@+id/optSortSize"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_reindex_option_card"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bookmark_sort_size"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/imgCheckSize"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Option 6: Group by Collection -->
    <LinearLayout
        android:id="@+id/optSortGroup"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_reindex_option_card"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bookmark_sort_by_group"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/imgCheckGroup"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Group Order Subsection (Visible when Group by Collection is selected) -->
    <LinearLayout
        android:id="@+id/layoutGroupOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <!-- Sub-option: A - Z -->
        <LinearLayout
            android:id="@+id/optGroupAz"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bookmark_sort_group_az"
                android:textColor="@color/mobile_text_primary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium" />

            <ImageView
                android:id="@+id/imgCheckGroupAz"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorPrimary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sub-option: Z - A -->
        <LinearLayout
            android:id="@+id/optGroupZa"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bookmark_sort_group_za"
                android:textColor="@color/mobile_text_primary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium" />

            <ImageView
                android:id="@+id/imgCheckGroupZa"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorPrimary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp" />

</LinearLayout>

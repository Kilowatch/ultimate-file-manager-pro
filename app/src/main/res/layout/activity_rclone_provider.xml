<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient">

    <!-- Glass Header Bar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle_accent">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_md">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rclone_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_online_storage_auth_rclone"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Parent ScrollView wrapping the entire content area — both sections move up when keyboard opens -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svParent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Provider Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProviderList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rclone_select_provider"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rclone_select_provider_hint"
                        android:textColor="@color/mobile_card_text_secondary"
                        android:textSize="10sp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="208dp"
                        android:orientation="horizontal">

                        <androidx.core.widget.NestedScrollView
                            android:id="@+id/svProviderList"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:scrollbars="none"
                            android:overScrollMode="never">

                            <LinearLayout
                                android:id="@+id/providerListContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                        </androidx.core.widget.NestedScrollView>

                        <!-- Custom scroll indicator -->
                        <FrameLayout
                            android:id="@+id/scrollIndicator"
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="6dp"
                            android:layout_marginStart="8dp">

                            <!-- Yellow track background -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/scrollbar_thumb_rclone" />

                            <!-- Moving dark thumb -->
                            <View
                                android:id="@+id/scrollThumb"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/scrollbar_thumb_dark" />

                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dynamic Fields Card — populated programmatically -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/mobile_glass_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.core.widget.NestedScrollView
                            android:id="@+id/svFields"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:scrollbars="none"
                            android:overScrollMode="never">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <!-- Storage Name (display name) — always shown when fields are visible -->
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    android:hint="@string/rclone_field_storage_name"
                                    app:boxStrokeColor="?attr/colorPrimary">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etStorageName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:paddingVertical="12dp"
                                        android:textSize="16sp"
                                        android:inputType="text" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <LinearLayout
                                    android:id="@+id/fieldContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />

                                <!-- Result text -->
                                <TextView
                                    android:id="@+id/txtResult"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone"
                                    android:padding="12dp"
                                    android:textSize="14sp" />

                                <!-- Buttons: Test Connection (top), Save (bottom), stacked full-width -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginTop="8dp">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnTest"
                                        style="@style/Widget.Material3Expressive.Button"
                                        android:layout_width="match_parent"
                                        android:layout_height="48dp"
                                        android:layout_marginBottom="8dp"
                                        android:text="@string/rclone_btn_test"
                                        app:cornerRadius="12dp"
                                        android:backgroundTint="?attr/colorPrimary"
                                        android:textColor="@android:color/white" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnSave"
                                        style="@style/Widget.Material3Expressive.Button"
                                        android:layout_width="match_parent"
                                        android:layout_height="48dp"
                                        android:text="@string/rclone_btn_save"
                                        app:cornerRadius="12dp"
                                        android:backgroundTint="?attr/colorPrimary"
                                        android:textColor="@android:color/white"
                                        android:enabled="false" />

                                </LinearLayout>   <!-- closes buttons container -->

                            </LinearLayout>   <!-- closes inner content -->
                        </androidx.core.widget.NestedScrollView>

                        <!-- Custom scroll indicator for fields section -->
                        <FrameLayout
                            android:id="@+id/scrollIndicatorFields"
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="6dp"
                            android:layout_marginStart="8dp"
                            android:visibility="gone">

                            <!-- Yellow track background -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/scrollbar_thumb_rclone" />

                            <!-- Moving dark thumb -->
                            <View
                                android:id="@+id/scrollThumbFields"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/scrollbar_thumb_dark" />

                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

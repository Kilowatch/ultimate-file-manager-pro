<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Crash & Freeze Dialog - TV glass card with vertically stacked buttons and yellow focus
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_glass_card"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Icon Badge -->
    <ImageView
        android:id="@+id/imgCrashIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_crash_report"
        app:tint="@color/ufm_progress_critical"
        android:layout_marginBottom="12dp"
        android:contentDescription="@null" />

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/txtCrashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Dialog Message Body -->
    <TextView
        android:id="@+id/txtCrashMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="22dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp" />

    <!-- TV Buttons (Vertical stack) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Send Report (Primary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrashSend"
            style="@style/TvContinueButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- No Thanks (Secondary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrashNoThanks"
            style="@style/TvContinueButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_gradient">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/bg_icon_circle_accent"
            app:tint="@color/tv_text_primary"
            android:contentDescription="@null"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/txtIconName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tv_text_primary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <!-- Accent underline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_border" />

    <!-- Body: Left action panel + Right grid of alternative icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- LEFT PANEL (actions & preview) -->
        <LinearLayout
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="32dp">

            <!-- Card for preview -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/tv_glass_white_10"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/tv_glass_border">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/imgCurrentIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Done Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                style="@style/TvGrantButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:text="@string/done"
                app:icon="@drawable/ic_check" />

            <!-- Browse custom file Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBrowseIcon"
                style="@style/TvContinueButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:text="@string/browse_icon_file"
                app:icon="@drawable/ic_folder" />

            <!-- Reset Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetIcon"
                style="@style/TvContinueButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/reset_icon_to_default"
                app:strokeColor="?attr/colorError"
                android:textColor="?attr/colorError"
                app:icon="@drawable/ic_refresh"
                app:iconTint="?attr/colorError" />

        </LinearLayout>

        <!-- Vertical divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="32dp"
            android:background="@color/tv_glass_border" />

        <!-- RIGHT PANEL (Grid list) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tile_icon_pick_builtin"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBuiltinIcons"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="8dp"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>

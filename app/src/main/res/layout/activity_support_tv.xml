<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".support.SupportActivity">

    <!-- TV Header Bar (Solid dark) -->
    <LinearLayout
        android:id="@+id/layerHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_white_10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/selector_tv_icon_btn"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/cd_support_back"
            app:tint="@color/tv_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support_tile_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- TV Centered Content Container -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="720dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:isScrollContainer="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/layerHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_tv_glass_card">

            <!-- ======== OPTIONS VIEW ======== -->
            <LinearLayout
                android:id="@+id/layoutOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- 1. Report Bug Card -->
                <LinearLayout
                    android:id="@+id/cardReportBug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/selector_tv_button">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_bug_report"
                        app:tint="@color/tv_text_primary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_report_bug"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_report_bug_subtitle"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/tv_text_secondary"
                        android:contentDescription="@null" />
                </LinearLayout>

                <!-- 2. Feature Request Card -->
                <LinearLayout
                    android:id="@+id/cardFeatureRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/selector_tv_button">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_feature_request"
                        app:tint="@color/tv_text_primary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_feature_request"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_feature_request_subtitle"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/tv_text_secondary"
                        android:contentDescription="@null" />
                </LinearLayout>

                <!-- 3. General Support Card -->
                <LinearLayout
                    android:id="@+id/cardGeneral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/selector_tv_button">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_message"
                        app:tint="@color/tv_text_primary"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_general"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_general_subtitle"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/tv_text_secondary"
                        android:contentDescription="@null" />
                </LinearLayout>

                <!-- 4. Direct Contact Card -->
                <LinearLayout
                    android:id="@+id/cardDirectEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/selector_tv_button">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_support"
                        app:tint="@color/tv_button_focused_yellow"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_direct_email_title"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/support_direct_email_subtitle"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/tv_text_secondary"
                        android:contentDescription="@null" />
                </LinearLayout>

            </LinearLayout>

            <!-- ======== FORM VIEW ======== -->
            <LinearLayout
                android:id="@+id/layoutForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Form Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/imgFormHeaderIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_support"
                        app:tint="@color/tv_button_focused_yellow"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/txtFormType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>

                <!-- Subject field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputSubject"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/support_subject"
                    app:hintTextColor="@color/tv_text_secondary"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtSubject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="200"
                        android:singleLine="true"
                        android:textColor="@color/tv_text_primary"
                        android:textColorHint="@color/tv_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Description / Message field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputMessage"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/support_description"
                    app:hintTextColor="@color/tv_text_secondary"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLength="5000"
                        android:maxLines="6"
                        android:minLines="3"
                        android:textColor="@color/tv_text_primary"
                        android:textColorHint="@color/tv_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Steps to Reproduce (Bug only) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputSteps"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone"
                    android:hint="@string/support_steps"
                    app:hintTextColor="@color/tv_text_secondary"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLength="5000"
                        android:maxLines="5"
                        android:minLines="2"
                        android:textColor="@color/tv_text_primary"
                        android:textColorHint="@color/tv_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Use Case (Feature only) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputUseCase"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone"
                    android:hint="@string/support_use_case"
                    app:hintTextColor="@color/tv_text_secondary"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtUseCase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLength="5000"
                        android:maxLines="4"
                        android:minLines="2"
                        android:textColor="@color/tv_text_primary"
                        android:textColorHint="@color/tv_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email field (optional) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="@string/support_email"
                    app:hintTextColor="@color/tv_text_secondary"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLength="254"
                        android:singleLine="true"
                        android:textColor="@color/tv_text_primary"
                        android:textColorHint="@color/tv_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Remember email checkbox -->
                <CheckBox
                    android:id="@+id/chkRememberEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/support_remember_email"
                    android:textColor="@color/tv_text_primary"
                    android:buttonTint="?attr/colorPrimary"
                    android:focusable="true"
                    android:checked="false" />

                <!-- Dynamic Container for attached files -->
                <LinearLayout
                    android:id="@+id/layoutAttachmentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Attach File Card -->
                <LinearLayout
                    android:id="@+id/layoutAttachment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="18dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/selector_tv_button">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/tv_text_primary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/txtAttachment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/support_attach_file"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <ImageView
                        android:id="@+id/btnRemoveAttachment"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_close"
                        android:contentDescription="@string/support_remove_file"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/selector_tv_icon_btn"
                        app:tint="@color/tv_text_secondary" />
                </LinearLayout>

                <!-- Send Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSend"
                    style="@style/TvContinueButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/support_send"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:focusable="true"
                    android:clickable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <!-- Honeypot field -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtHoneypot"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

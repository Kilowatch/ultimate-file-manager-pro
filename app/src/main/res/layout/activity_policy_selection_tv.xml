<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_premium_dark"
    tools:context=".ui.policy.PolicySelectionActivity">

    <!-- Premium TV Header -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="#26000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            app:tint="@color/tv_text_primary"
            android:background="@drawable/selector_tv_icon_btn" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/legal_amp_policy"
                android:textColor="@color/tv_text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/please_review_the_terms_before"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden toolbar for compatibility -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Policy Cards Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="96dp"
        android:paddingVertical="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Terms & Conditions Button Component -->
        <LinearLayout
            android:id="@+id/cardTerms"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="32dp"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_policy_button">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_policy"
                android:layout_marginEnd="24dp"
                app:tint="@color/selector_tv_policy_icon"
                android:duplicateParentState="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/terms_amp_conditions"
                android:textColor="@color/selector_tv_policy_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:duplicateParentState="true" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="@color/selector_tv_policy_icon"
                android:alpha="0.7"
                android:duplicateParentState="true" />
        </LinearLayout>

        <!-- Privacy Policy Button Component -->
        <LinearLayout
            android:id="@+id/cardPrivacy"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="32dp"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_policy_button">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_policy"
                android:layout_marginEnd="24dp"
                app:tint="@color/selector_tv_policy_icon"
                android:duplicateParentState="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/privacy_policy"
                android:textColor="@color/selector_tv_policy_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:duplicateParentState="true" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="@color/selector_tv_policy_icon"
                android:alpha="0.7"
                android:duplicateParentState="true" />
        </LinearLayout>

        <!-- Open Source Licenses Button Component -->
        <LinearLayout
            android:id="@+id/cardLicenses"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="32dp"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_policy_button">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_policy"
                android:layout_marginEnd="24dp"
                app:tint="@color/selector_tv_policy_icon"
                android:duplicateParentState="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/policy_licenses_button"
                android:textColor="@color/selector_tv_policy_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:duplicateParentState="true" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="@color/selector_tv_policy_icon"
                android:alpha="0.7"
                android:duplicateParentState="true" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="700dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="32dp"
    android:gravity="center_horizontal">

    <!-- Top Icon Badge -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="18dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_terminal"
            app:tint="@color/tv_text_primary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/keyboard_rebind_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="6dp" />

    <!-- Action Name -->
    <TextView
        android:id="@+id/txtActionName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_accent"
        android:textSize="17sp"
        android:fontFamily="sans-serif-bold"
        android:textAlignment="center"
        android:layout_marginBottom="18dp" />

    <!-- Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/tv_glass_white_05"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/tv_glass_white_10"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/txtCurrentKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_rebind_prompt"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:textAlignment="center"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Reset to Default Button -->
    <Button
        android:id="@+id/btnResetDefault"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/keyboard_shortcuts_reset_defaults"
        android:background="@drawable/selector_tv_button"
        android:textColor="@color/tv_text_primary"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/cancel"
        android:background="@drawable/selector_tv_button"
        android:textColor="@color/tv_text_primary"
        android:focusable="true" />

</LinearLayout>

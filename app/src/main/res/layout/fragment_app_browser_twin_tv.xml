<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Twin-Window App Browser Fragment — compact layout for the TV/FireTV dual-pane mode.
    Uses TV colour tokens (tv_glass_*) and D-pad-friendly button sizes.
    No tabs or search bar — shows only user-installed apps.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ─── Compact Header ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp"
        android:background="@color/tv_glass_white_10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btnTvBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/selector_tv_button_yellow"
            app:tint="@color/selector_tv_button_text" />

        <!-- Title -->
        <TextView
            android:id="@+id/txtTvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:text="@string/perm_query_apps_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Sort -->
        <ImageView
            android:id="@+id/btnSortApp"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_sort"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/tv_icon_tint" />

    </LinearLayout>

    <!-- ─── App count ───────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/txtAppCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/tv_text_hint"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="76 apps" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="txtAppCount" />

    <!-- ─── Selection Bar ───────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/tv_glass_white_10"
        android:elevation="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/barrier_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/btnCloseSelection"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/action_clear_selection"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            app:tint="@color/tv_icon_tint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSelectionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                tools:text="1 selected" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_select_all"
                android:textColor="@color/tv_accent"
                android:focusable="true"
                android:focusableInTouchMode="false"
                app:backgroundTint="@color/tv_glass_white_10"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/tv_accent"
                app:iconSize="20dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ─── Solid Bottom Action Bar ──────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutActionPillsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:background="@color/tv_glass_white_10"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPillCopy"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/extract"
            android:clickable="true"
            android:focusable="true"
            app:icon="@drawable/ic_copy"
            app:iconSize="18dp" />

    </LinearLayout>

    <!-- ─── App List ────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSelectionBar"
        app:layout_constraintBottom_toTopOf="@id/layoutActionPillsScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_app_twin_tv" />


    <!-- ─── Progress ───────────────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:indeterminateTint="#FF0284C7"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ─── Empty State ─────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_apps_found"
        android:textColor="@color/tv_text_hint"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

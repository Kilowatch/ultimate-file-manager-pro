<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient">

    <!-- Mobile Glass Header Bar (56dp UFMStandard) -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/mobile_icon_tint" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/txtAuthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_online_storage_auth_onedrive"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onedrive_device_code_subtitle"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:gravity="center_horizontal">

            <!-- Instruction Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Step 1: Open Link -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onedrive_device_code_step1"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/txtVerificationUrl"
                    style="@style/Widget.Material3Expressive.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="microsoft.com/devicelogin"
                    android:textColor="@color/btn_save_bg_tint"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:textAllCaps="false" />

                <!-- Step 2: Code -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onedrive_device_code_step2"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/txtUserCode"
                    style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---- ----"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.12"
                    android:layout_marginTop="10dp"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="@color/mobile_icon_tint"
                    app:strokeColor="@color/mobile_glass_stroke"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="16dp"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="24dp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/txtExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Code expires in --:--"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- Hidden TV Elements to prevent crashes -->
            <ImageView
                android:id="@+id/imgQrCode"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressQr"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Polling Status Container -->
            <LinearLayout
                android:id="@+id/layoutPolling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_card"
                android:paddingVertical="14dp"
                android:paddingHorizontal="20dp">

                <ProgressBar
                    android:id="@+id/progressPolling"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="@color/btn_save_bg_tint" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onedrive_auth_waiting"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

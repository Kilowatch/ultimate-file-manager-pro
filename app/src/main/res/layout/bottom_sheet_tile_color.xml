                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_color_swatch"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════ -->

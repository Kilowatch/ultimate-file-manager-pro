<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="false"
    android:focusable="false"
    android:foreground="@drawable/selector_tv_card"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/card_radius_lg"
    app:cardElevation="0dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/tv_glass_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_xl"
        android:paddingVertical="@dimen/margin_md"
        android:background="@drawable/bg_glass_card">

        <!-- Sort icon -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_sort"
            android:layout_marginEnd="@dimen/margin_lg"
            android:contentDescription="@null" />

        <!-- Path & summary -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtFolderPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="middle"
                tools:text="/storage/emulated/0/Movies" />

            <TextView
                android:id="@+id/txtSortSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                tools:text="Name · Ascending · All" />

            <!-- Network badge (shown only for network/online entries) -->
            <LinearLayout
                android:id="@+id/imgNetworkBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_network"
                    app:tint="@color/ufm_primary"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/folder_sort_network_badge"
                    android:textColor="@color/ufm_primary"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Delete action (D-pad focusable) -->
        <ImageView
            android:id="@+id/btnDeleteFolderSort"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_icon_btn"
            android:contentDescription="@string/folder_sort_manager_delete_cd" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

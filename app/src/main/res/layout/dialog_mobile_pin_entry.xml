<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile PIN Entry — Premium Glassmorphic Dialog -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_xl"
    android:background="@drawable/bg_dialog_glass">

    <!-- Hero TV Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_tv"
        app:tint="?attr/colorPrimary"
        android:layout_marginBottom="@dimen/margin_md" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/enter_pin"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/margin_sm"
        android:text="@string/enter_the_4digit_pin_shown"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <!-- 4 PIN Boxes -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/pin_digit_1"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_mobile_pin_digit"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/mobile_text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:cursorVisible="false"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/pin_digit_2"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_mobile_pin_digit"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/mobile_text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:cursorVisible="false"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/pin_digit_3"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_mobile_pin_digit"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/mobile_text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:cursorVisible="false"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/pin_digit_4"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_mobile_pin_digit"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/mobile_text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:cursorVisible="false"
            android:importantForAutofill="no" />

    </LinearLayout>

    <!-- Link Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLink"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/link"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_check_circle"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/white" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelPin"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:textAllCaps="false" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  TV Extract Options Dialog — centered glassmorphism style.
  Matches dialog_archive_options_tv.xml aesthetic: bg_dialog_glass, tv_text_primary colours,
  yellow selector button for the primary action, standard selector for cancel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="32dp">

    <!-- Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_extract"
        android:tint="@color/tv_accent"
        android:contentDescription="@null" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/extract_options_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle / Archive Name -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="24dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnExtractHere"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/extract_to_current_folder"
            android:background="@drawable/selector_tv_button_yellow"
            android:textColor="@color/tv_button_focused_yellow_text"
            android:textAllCaps="false"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnExtractToNewFolder"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/extract_to_new_folder"
            android:background="@drawable/selector_tv_button"
            android:textColor="@color/tv_text_primary"
            android:textAllCaps="false"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnExtractAndSelectFolder"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/extract_select_folder"
            android:background="@drawable/selector_tv_button"
            android:textColor="@color/tv_text_primary"
            android:textAllCaps="false"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/cancel"
            android:background="@drawable/selector_tv_button"
            android:textColor="@color/tv_text_primary"
            android:textAllCaps="false"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>

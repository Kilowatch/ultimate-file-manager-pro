<?xml version="1.0" encoding="utf-8"?>
<!--
    Large File Row — Mobile (glassmorphism light theme)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke"
    app:rippleColor="@color/mobile_glass_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/margin_md">

        <ImageView
            android:id="@+id/imgLargeFileIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="@dimen/margin_md"
            android:contentDescription="@null"
            app:tint="@color/tv_accent"
            tools:src="@drawable/ic_file_generic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtLargeFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="BigVideoFile.mp4" />

            <TextView
                android:id="@+id/txtLargeFilePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="start"
                tools:text="/storage/emulated/0/DCIM" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLargeFileSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_sm"
            android:textColor="@color/tv_accent"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            tools:text="2.4 GB" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

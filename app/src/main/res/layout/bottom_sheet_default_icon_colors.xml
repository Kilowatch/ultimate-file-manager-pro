<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="28dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- Hero Icon Badge -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_palette"
                app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_default_icon_colors_title"
            android:textColor="@color/mobile_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:gravity="center_horizontal"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_default_icon_colors_subtitle"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="18dp" />

        <!-- Live Icon Preview Glass Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header of preview: label + hex badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/default_icon_color_preview_label"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/txtPreviewHex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#7DAECC"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_btn_icon_frosted"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>

                <!-- 4 Live-preview icons in frosted squircles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_icon_frosted"
                        android:layout_marginHorizontal="6dp">

                        <ImageView
                            android:id="@+id/imgPreviewIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_folder"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_icon_frosted"
                        android:layout_marginHorizontal="6dp">

                        <ImageView
                            android:id="@+id/imgPreviewIcon2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_file_video"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_icon_frosted"
                        android:layout_marginHorizontal="6dp">

                        <ImageView
                            android:id="@+id/imgPreviewIcon3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_file_audio"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_icon_frosted"
                        android:layout_marginHorizontal="6dp">

                        <ImageView
                            android:id="@+id/imgPreviewIcon4"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_file_image"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Light Theme Section                                     -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLightSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header: theme title + current swatch + reset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/swatchLightCurrent"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_color_swatch" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/default_icon_color_section_light"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/btnResetLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_icon_color_reset"
                        android:textColor="@color/mobile_stop_btn"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_btn_icon_frosted"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Presets Row -->
                <LinearLayout
                    android:id="@+id/presetsLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <View android:id="@+id/swatchLight0" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchLight1" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchLight2" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchLight3" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchLight4" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchLight5" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchLight6" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchLight7" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                </LinearLayout>

                <!-- Custom Color Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomLight"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/default_icon_color_custom"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_palette"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/colorPrimary"
                    app:backgroundTint="@color/mobile_glass_card"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/mobile_glass_stroke" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Dark Theme Section                                      -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDarkSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header: theme title + current swatch + reset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/swatchDarkCurrent"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_color_swatch" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/default_icon_color_section_dark"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/btnResetDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_icon_color_reset"
                        android:textColor="@color/mobile_stop_btn"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_btn_icon_frosted"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Presets Row -->
                <LinearLayout
                    android:id="@+id/presetsDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <View android:id="@+id/swatchDark0" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchDark1" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchDark2" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchDark3" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchDark4" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchDark5" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchDark6" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchDark7" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                </LinearLayout>

                <!-- Custom Color Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomDark"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/default_icon_color_custom"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_palette"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/colorPrimary"
                    app:backgroundTint="@color/mobile_glass_card"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/mobile_glass_stroke" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- AMOLED Theme Section                                    -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAmoledSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="@color/mobile_glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/mobile_glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header: theme title + current swatch + reset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:id="@+id/swatchAmoledCurrent"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_color_swatch" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/default_icon_color_section_amoled"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/btnResetAmoled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_icon_color_reset"
                        android:textColor="@color/mobile_stop_btn"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_btn_icon_frosted"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Presets Row -->
                <LinearLayout
                    android:id="@+id/presetsAmoled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <View android:id="@+id/swatchAmoled0" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchAmoled1" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchAmoled2" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchAmoled3" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchAmoled4" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchAmoled5" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchAmoled6" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                    <View android:id="@+id/swatchAmoled7" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_color_swatch" android:layout_marginHorizontal="3.5dp" />
                </LinearLayout>

                <!-- Custom Color Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomAmoled"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/default_icon_color_custom"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_palette"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/colorPrimary"
                    app:backgroundTint="@color/mobile_glass_card"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/mobile_glass_stroke" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetAll"
                style="@style/Widget.Material3Expressive.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/default_icon_color_reset_all"
                android:textColor="@color/mobile_stop_btn"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="120dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="12dp"
                android:text="@string/default_icon_color_done" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

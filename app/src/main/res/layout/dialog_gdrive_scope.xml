<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Drive Scope Dialog (Language & Grouped Glass Card Standard)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Top Row: 48dp Frosted Badge + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cloud"
                app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/txtGdriveScopeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gdrive_premium_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/add_online_storage_gdrive"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Description Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="220dp"
            android:fillViewport="true"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/txtGdriveScopeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/gdrive_premium_message"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="13.5sp"
                android:lineSpacingExtra="3dp"
                android:autoLink="web"
                android:textColorLink="?attr/colorPrimary"
                android:linksClickable="true" />
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGdriveScopeOk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_ok"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-bold"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGdriveScopeCancel"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/gdrive_scope_btn_cancel"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="14sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_xl"
    android:background="@drawable/bg_glass_card">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_cloud"
        android:tint="@color/ufm_accent"
        android:layout_marginBottom="@dimen/margin_md" />

    <TextView
        android:id="@+id/txtGdriveScopeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/gdrive_premium_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/txtGdriveScopeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/margin_sm"
        android:text="@string/gdrive_premium_message"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:autoLink="web"
        android:textColorLink="@color/ufm_accent"
        android:linksClickable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/margin_xl"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGdriveScopeCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gdrive_scope_btn_cancel"
            android:textColor="@color/mobile_text_secondary"
            android:layout_marginEnd="@dimen/margin_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGdriveScopeOk"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_ok"
            app:backgroundTint="@color/ufm_accent"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>

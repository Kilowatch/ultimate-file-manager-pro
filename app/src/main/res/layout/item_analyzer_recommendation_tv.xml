<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleanup Recommendation Card — TV
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:background="@drawable/selector_tv_storage_category_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:duplicateParentState="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:duplicateParentState="true">

            <ImageView
                android:id="@+id/imgRecIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_warning_badge"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                app:tint="@color/selector_tv_storage_category_icon_tint" />

            <TextView
                android:id="@+id/txtRecRisk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_status_dot"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:duplicateParentState="true"
                tools:text="SAFE"
                tools:textColor="@color/ufm_risk_safe" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtRecTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/selector_tv_storage_category_text_primary"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:duplicateParentState="true"
            tools:text="Clear Cache &amp; Temp Files" />

        <TextView
            android:id="@+id/txtRecDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/selector_tv_storage_category_text_secondary"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:duplicateParentState="true"
            tools:text="Found 247 cache/temp files in well-known junk folders." />

        <TextView
            android:id="@+id/txtRecSavings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/selector_tv_storage_category_text_accent"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:duplicateParentState="true"
            tools:text="Save 1.2 GB" />

    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header: Icon + Name & Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:id="@+id/layoutPropertiesIconContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/imgPropertiesIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_folder"
                    app:tint="?android:attr/textColorPrimary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFilename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:ellipsize="middle"
                    android:singleLine="false"
                    android:maxLines="2"
                    tools:text="Document_2026.pdf" />

                <TextView
                    android:id="@+id/txtTypeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    tools:text="PDF Document (.pdf)" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider 1 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/dividerHorizontal"
            android:layout_marginBottom="16dp" />

        <!-- APK / XAPK App Details Section (Mobile Only) -->
        <LinearLayout
            android:id="@+id/layoutApkDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Package Name (Interactive pill chip with copy icon) -->
            <LinearLayout
                android:id="@+id/btnCopyApkPackage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_step_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txtApkPackageName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    tools:text="com.barclays.absa.banking" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_copy"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@string/apk_details_copy_package" />
            </LinearLayout>

            <!-- Table with Version, Installed, Target, Minimum -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1"
                android:layout_marginTop="8dp">

                <!-- Versão / Version Row -->
                <TableRow android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apk_details_version"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:paddingEnd="16dp" />
                    <TextView
                        android:id="@+id/txtApkVersionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        tools:text="26.2.0 - February-Release 11181" />
                </TableRow>

                <!-- Instalado / Installed Row -->
                <TableRow android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apk_details_installed"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:paddingEnd="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtApkInstalledValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            tools:text="26.7.1 - July-Release 11214" />

                        <!-- Status Badge & Open Button Row (Placed neatly below version to prevent clipping) -->
                        <LinearLayout
                            android:id="@+id/rowApkStatusActions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="5dp">

                            <TextView
                                android:id="@+id/badgeApkStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:background="@drawable/bg_apk_status_downgrade"
                                android:textColor="#FFB74D"
                                android:visibility="gone"
                                tools:visibility="visible"
                                tools:text="Downgrade" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnApkOpen"
                                style="@style/Widget.Material3Expressive.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="8dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:text="@string/apk_details_open"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="?attr/colorPrimary"
                                app:icon="@drawable/ic_arrow_forward"
                                app:iconSize="14dp"
                                app:iconTint="?attr/colorPrimary"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp"
                                app:cornerRadius="16dp"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </TableRow>

                <!-- Alvo / Target SDK Row -->
                <TableRow android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apk_details_target_sdk"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:paddingEnd="16dp" />
                    <TextView
                        android:id="@+id/txtApkTargetValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        tools:text="16.0 (SDK 36 W)" />
                </TableRow>

                <!-- Mínimo / Min SDK Row -->
                <TableRow android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apk_details_min_sdk"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:paddingEnd="16dp" />
                    <TextView
                        android:id="@+id/txtApkMinValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        tools:text="8.0 (SDK 26 O)" />
                </TableRow>
            </TableLayout>

            <!-- Premium Actions: 2 Rows filling entire width -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp">

                <!-- Row 1: Play Store & Manifest -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <!-- Play Store -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApkPlayStore"
                        style="@style/Widget.Material3Expressive.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="@string/apk_details_play_store"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorPrimary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_apps"
                        app:iconSize="18dp"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorPrimary" />

                    <!-- Manifest -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApkManifest"
                        style="@style/Widget.Material3Expressive.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="@string/apk_details_manifest"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorPrimary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_file_code"
                        app:iconSize="18dp"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorPrimary" />
                </LinearLayout>

                <!-- Row 2: Certificate & Install -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Certificate -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApkCertificate"
                        style="@style/Widget.Material3Expressive.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="@string/apk_details_certificate"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?android:attr/textColorPrimary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_shield_check"
                        app:iconSize="18dp"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:iconTint="?attr/colorPrimary" />

                    <!-- Install (Primary Accent Button) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApkInstallAction"
                        style="@style/Widget.Material3Expressive.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="@string/apk_details_install"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/white"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_install"
                        app:iconSize="18dp"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider after APK Details -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerHorizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- General Info Section (Grid/Table style rows) -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">

            <!-- Type of File Row -->
            <TableRow
                android:id="@+id/rowType"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/lblType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/properties_label_type"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtTypeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="JPEG image (.jpg)" />
            </TableRow>

            <!-- Opens With Row -->
            <TableRow
                android:id="@+id/rowOpensWith"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/properties_label_opens_with"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtOpensWithValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="UFM Photo Viewer" />
            </TableRow>

            <!-- Location Row -->
            <TableRow
                android:id="@+id/rowLocation"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/properties_label_location"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtLocationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="/storage/emulated/0/DCIM/Screenshots" />
            </TableRow>

            <!-- Size Row -->
            <TableRow
                android:id="@+id/rowSize"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/properties_label_size"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="249 KB (255,420 bytes)" />
            </TableRow>

            <!-- Contains Row (Folders / Multi Selection) -->
            <TableRow
                android:id="@+id/rowContains"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/properties_label_contains"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtContainsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="142 Files, 18 Folders" />
            </TableRow>

            <!-- Dimensions Row (Images) -->
            <TableRow
                android:id="@+id/rowDimensions"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/properties_label_dimensions"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtDimensionsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="1440 x 2992 (4.3 MP)" />
            </TableRow>
        </TableLayout>

        <!-- Divider 2 -->
        <View
            android:id="@+id/dividerDates"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/dividerHorizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Timestamps Section -->
        <TableLayout
            android:id="@+id/tableTimestamps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">

            <TableRow
                android:id="@+id/rowModified"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/properties_label_modified"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtModifiedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="Saturday, 4 July 2026, 12:34:56 PM" />
            </TableRow>
        </TableLayout>

        <!-- Divider Root / POSIX -->
        <View
            android:id="@+id/dividerRoot"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/dividerHorizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Root / POSIX Properties Section -->
        <TableLayout
            android:id="@+id/tableRootProperties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            android:visibility="gone">

            <!-- Permissions Row -->
            <TableRow
                android:id="@+id/rowPermissions"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/root_posix_permissions"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtPermissionsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="rwxr-xr-x (0755)" />
            </TableRow>

            <!-- Owner / Group Row -->
            <TableRow
                android:id="@+id/rowOwnerGroup"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/root_owner_group"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtOwnerGroupValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="root : root" />
            </TableRow>

            <!-- SELinux Context Row -->
            <TableRow
                android:id="@+id/rowSelinux"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/root_selinux_context"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtSelinuxValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    tools:text="u:object_r:system_file:s0" />
            </TableRow>

            <!-- Symlink Target Row -->
            <TableRow
                android:id="@+id/rowSymlink"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/root_symlink_target"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/txtSymlinkValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    tools:text="/system/bin/app_process64" />
            </TableRow>
        </TableLayout>

        <!-- Divider 3: Attributes -->
        <View
            android:id="@+id/dividerAttributes"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/dividerHorizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Attributes Section -->
        <LinearLayout
            android:id="@+id/layoutAttributes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/properties_label_attributes"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginEnd="16dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgAttributes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp" />
        </LinearLayout>

        <!-- Tags Section Container -->
        <LinearLayout
            android:id="@+id/layoutTagsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerHorizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp" />

            <!-- Tags Title + Edit Pen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tags"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnEditTags"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="@drawable/bg_icon_circle"
                    android:src="@drawable/ic_edit"
                    android:contentDescription="Edit Tags"
                    app:tint="?android:attr/textColorPrimary"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Tag pills flow/container -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

            <!-- No tags placeholder -->
            <TextView
                android:id="@+id/txtNoTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No tags added yet"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:fontStyle="italic"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Mobile App Manager — premium dark glassmorphism design
    Same dark-navy theme as activity_welcome: bg_mobile_gradient background,
    glass header bar with back button and title.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".storage.AppManagerActivity">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:paddingVertical="14dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnAppsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_icon_circle_accent"
            app:tint="@color/mobile_icon_tint" />

        <!-- Accent divider -->
        <View
            android:layout_width="1.5dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="14dp"
            android:background="#990284C7" />

        <!-- Title + Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_query_apps_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/apps_tile_subtitle"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Sort Button -->
        <ImageView
            android:id="@+id/btnSortApp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_sort"
            android:contentDescription="@string/sort_title"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="@dimen/margin_sm"
            android:background="@drawable/bg_icon_circle_accent"
            app:tint="@color/mobile_icon_tint" />

        <!-- Refresh Button -->
        <ImageView
            android:id="@+id/btnRefreshDebloat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/refresh_debloat_list"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_icon_circle_accent"
            app:tint="@color/mobile_icon_tint"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Hidden toolbar stub for code compatibility -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Toggle Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_md"
        android:layout_marginTop="@dimen/margin_sm"
        android:background="@color/mobile_glass_header"
        app:tabTextColor="@color/mobile_text_secondary"
        app:tabSelectedTextColor="@color/mobile_text_primary"
        app:tabIndicatorColor="#FF0284C7"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabRippleColor="@color/mobile_glass_ripple"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search Bar -->
    <EditText
        android:id="@+id/editSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="@dimen/margin_md"
        android:layout_marginTop="@dimen/margin_sm"
        android:paddingHorizontal="@dimen/margin_md"
        android:hint="@string/search_apps"
        android:textColor="@color/mobile_card_text_primary"
        android:textColorHint="@color/mobile_card_text_secondary"
        android:textSize="14sp"
        android:background="@color/mobile_glass_card"
        android:inputType="text"
        android:maxLines="1"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="@dimen/margin_sm"
        android:drawableTint="@color/mobile_card_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- App Count -->
    <TextView
        android:id="@+id/txtAppCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_md"
        android:layout_marginTop="@dimen/margin_sm"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/editSearch"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="42 apps" />

    <!-- App List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/margin_xs"
        app:layout_constraintTop_toBottomOf="@id/txtAppCount"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="#FF0284C7"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_apps_found"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

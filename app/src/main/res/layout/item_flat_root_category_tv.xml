<?xml version="1.0" encoding="utf-8"?>
<!--
    Flat View Root Category Card (TV)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRootCategory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:strokeColor="@android:color/transparent"
    app:cardBackgroundColor="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/layoutCategoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp"
        android:background="@drawable/selector_tv_list_item"
        android:clickable="true"
        android:focusable="true">

        <!-- Checkbox in edit mode -->
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkSelectCategory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:buttonTint="?attr/ufmFocusAccent"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            tools:visibility="visible" />

        <!-- Category Squircle Icon Badge -->
        <FrameLayout
            android:id="@+id/iconContainerCategory"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_squircle_category_icon">

            <ImageView
                android:id="@+id/imgCategoryIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                app:tint="?attr/ufmFocusAccent"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Title & Subtitle column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/txtCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="A Google Review" />

            <TextView
                android:id="@+id/txtCategorySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:text="48 files across 6 folders" />
        </LinearLayout>

        <!-- Collapsed item count pill badge -->
        <TextView
            android:id="@+id/txtCategoryCountPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_category_count_pill"
            android:layout_marginEnd="10dp"
            tools:text="48 files" />

        <!-- Open Folder in Standard Browser Button -->
        <ImageView
            android:id="@+id/btnOpenCategory"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:background="@drawable/selector_tv_button"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/tv_text_primary"
            android:contentDescription="@string/flat_view_open_folder"
            android:clickable="true"
            android:focusable="true" />

        <!-- Expand / Collapse Chevron Indicator -->
        <ImageView
            android:id="@+id/imgCategoryChevron"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/tv_text_secondary"
            android:contentDescription="@null" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Duplicate Retention Strategy Settings Dialog — TV UFMStandard layout.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="28dp">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_duplicate"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/settings_duplicate_retention_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center" />

    <!-- Description -->
    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="@string/settings_duplicate_retention_dialog_subtitle"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center" />

    <!-- Options Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Keep Oldest (Original) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRetentionOldest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/tv_glass_white_10"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/tv_glass_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgIconOldest"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_history"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="16dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTitleOldest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_duplicate_retention_summary_oldest"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/txtDescOldest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analyzer_strategy_oldest_desc"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/checkRetentionOldest"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Keep Newest -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRetentionNewest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/tv_glass_white_10"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/tv_glass_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgIconNewest"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_sync"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="16dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTitleNewest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_duplicate_retention_summary_newest"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/txtDescNewest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analyzer_strategy_newest_desc"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/checkRetentionNewest"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Always Ask -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRetentionAsk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/tv_glass_white_10"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/tv_glass_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgIconAsk"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_help"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="16dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTitleAsk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_duplicate_retention_summary_ask"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/txtDescAsk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_duplicate_retention_desc_ask"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/checkRetentionAsk"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="@string/cancel"
        android:textColor="@color/tv_button_text_selector"
        android:textSize="15sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        android:background="@drawable/selector_tv_button"
        app:backgroundTint="@null"
        android:focusable="true" />

</LinearLayout>

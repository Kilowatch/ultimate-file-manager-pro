<?xml version="1.0" encoding="utf-8"?>
<!-- File Size Filter Dialog — Premium Mobile Glassmorphic Standard -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorPrimary" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_filter_size_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <!-- Min size container -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_filter_size_min_label"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_reindex_option_card"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="14dp">

        <EditText
            android:id="@+id/editMinSize"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="@string/search_filter_size_min_hint"
            android:textColor="@color/mobile_card_text_primary"
            android:textColorHint="@color/mobile_text_secondary"
            android:background="@android:color/transparent"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerMinUnit"
            android:layout_width="85dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:popupBackground="#FF0A1628" />

    </LinearLayout>

    <!-- Max size container -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_filter_size_max_label"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_reindex_option_card"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="22dp">

        <EditText
            android:id="@+id/editMaxSize"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="@string/search_filter_size_max_hint"
            android:textColor="@color/mobile_card_text_primary"
            android:textColorHint="@color/mobile_text_secondary"
            android:background="@android:color/transparent"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerMaxUnit"
            android:layout_width="85dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:popupBackground="#FF0A1628" />

    </LinearLayout>

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSizeApply"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/search_filter_apply"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSizeCancel"
        style="@style/Widget.Material3Expressive.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_primary"
        app:strokeColor="@color/mobile_glass_stroke"
        app:cornerRadius="12dp"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false" />

</LinearLayout>

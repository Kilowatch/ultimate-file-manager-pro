<?xml version="1.0" encoding="utf-8"?>
<!-- TV Subtitle Track Selection Dialog - Centered 650dp Glass Panel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_card_glass"
    android:padding="28dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_subtitle_track"
            android:textColor="@color/tv_text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/txtFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/tv_text_secondary"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="middle"
            tools:text="movie_sample.mkv" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tv_glass_white_10"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Tracks List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTracks"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:clipToPadding="false" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:text="@string/cancel"
        android:textColor="@color/tv_text_primary"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/tv_glass_white_20"
        app:strokeWidth="1dp"
        app:backgroundTint="@color/tv_glass_white_10" />

</LinearLayout>

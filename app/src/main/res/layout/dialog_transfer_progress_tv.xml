<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Transfer / Extraction / Compression Progress Dialog - UFM Glass Standard
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="28dp">

    <!-- Title row with hero icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/imgProgressIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_copy"
            app:tint="@color/tv_button_focused_yellow"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/txtProgressTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/copying_files"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtProgressFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/item_00"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtProgressCurrentFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/filenameext"
        android:textColor="@color/tv_text_primary"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="middle" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:trackThickness="10dp"
        app:trackCornerRadius="5dp"
        android:progress="0"
        app:indicatorColor="@color/tv_button_focused_yellow" />

    <TextView
        android:id="@+id/txtProgressSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/s_0_mb_0_mb_0"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp"
        android:gravity="end" />

</LinearLayout>

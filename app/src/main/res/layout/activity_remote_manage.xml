<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile Remote Manage — Premium Glassmorphic Standard -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".remote.RemoteManageActivity">

    <!-- 56dp Fixed Glass Header Bar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/mobile_glass_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_header_action_ripple"
            app:tint="@color/mobile_icon_tint" />

        <!-- Title + Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remote_manage_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remote_tile_subtitle"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Hero Server Info Card -->
            <LinearLayout
                android:id="@+id/cardServerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_reindex_option_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <!-- 64dp Hero Icon Badge -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_btn_icon_frosted"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:id="@+id/imgHeroRemote"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_remote_manage"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@null" />
                </FrameLayout>

                <!-- Status Pill Badge -->
                <LinearLayout
                    android:id="@+id/layoutStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_badge_step_pill"
                    android:layout_marginBottom="14dp">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/remote_server_running"
                        android:textColor="#4ADE80"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <!-- Open Browser / IP Label -->
                <TextView
                    android:id="@+id/txtOpenBrowser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_open_browser"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="center"
                    android:layout_marginBottom="8dp" />

                <!-- IP / URL Display Box -->
                <TextView
                    android:id="@+id/txtServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_url_box"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="14dp"
                    tools:text="192.168.10.76" />

                <!-- Warning / Help text -->
                <TextView
                    android:id="@+id/txtWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_warning_screen"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.3"
                    android:textAlignment="center" />

            </LinearLayout>

            <!-- HTTPS Security & Fingerprint Card (visible in HTTPS mode) -->
            <LinearLayout
                android:id="@+id/cardSecurityDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_reindex_option_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Fingerprint Label -->
                <TextView
                    android:id="@+id/txtFingerprintLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_fingerprint_label"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_marginBottom="6dp" />

                <!-- Fingerprint Value -->
                <TextView
                    android:id="@+id/txtFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:background="@drawable/bg_url_box"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:layout_marginBottom="6dp"
                    tools:text="9B:3E:44:A1:7F:..." />

                <!-- Verify hint -->
                <TextView
                    android:id="@+id/txtVerifyFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_verify_fingerprint"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.2"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_marginBottom="12dp" />

                <!-- CA Trust Status Badge -->
                <LinearLayout
                    android:id="@+id/layoutCaStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_url_box"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgCaShield"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield_alert"
                        android:contentDescription="@null"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/txtCaStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Unverified — Auto-generated CA" />

                </LinearLayout>

            </LinearLayout>

            <!-- Stop Server Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopServer"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/remote_stop_server"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/mobile_stop_btn"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                android:layout_marginBottom="10dp" />

            <!-- Import / Remove CA Certificate Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUseCA"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/remote_ca_action_import"
                android:textColor="@color/mobile_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_lock"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/mobile_text_primary" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

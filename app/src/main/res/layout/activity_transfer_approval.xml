<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Transfer Approval Dialog Screen - UFM TV Glass Standard
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#CC000000">

    <LinearLayout
        android:layout_width="650dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_glass"
        android:padding="28dp">

        <!-- Icon -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_sync"
            app:tint="@color/tv_button_focused_yellow"
            android:contentDescription="@string/transfer_settings" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/transfer_settings"
            android:textSize="22sp"
            android:textColor="@color/tv_text_primary"
            android:fontFamily="sans-serif-black"
            android:gravity="center" />

        <!-- Source device -->
        <TextView
            android:id="@+id/txtSourceDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="@color/tv_text_secondary"
            android:gravity="center" />

        <!-- Summary of what will be transferred -->
        <TextView
            android:id="@+id/txtSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="15sp"
            android:textColor="@color/tv_text_primary"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3" />

        <!-- Countdown -->
        <TextView
            android:id="@+id/txtCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="@color/tv_text_secondary"
            android:gravity="center" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="@string/cancel"
                android:background="@drawable/selector_tv_button"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/tv_button_text_selector"
                android:textSize="15sp"
                android:focusable="true"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/approved"
                android:background="@drawable/selector_tv_button_yellow"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/tv_button_focused_yellow_text"
                android:textSize="15sp"
                android:focusable="true"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_support_dialog_card"
    android:padding="32dp"
    android:gravity="center_horizontal">

    <!-- Icon Badge Circle -->
    <FrameLayout
        android:id="@+id/badgeIconContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_icon_circle_accent"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgDialogIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_success"
            app:tint="@color/ufm_progress_fill" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Dialog Message Body -->
    <TextView
        android:id="@+id/txtDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <!-- TV Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Secondary Button (Cancel / Retry) -->
        <Button
            android:id="@+id/btnDialogNegative"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:textColor="@color/tv_text_secondary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:background="@drawable/selector_tv_button"
            android:visibility="gone" />

        <!-- Primary Action Button (OK / Confirm) -->
        <Button
            android:id="@+id/btnDialogPositive"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:background="@drawable/selector_tv_button" />
    </LinearLayout>

</LinearLayout>

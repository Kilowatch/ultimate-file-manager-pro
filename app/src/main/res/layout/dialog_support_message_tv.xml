<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Support Message/Confirm Dialog - TV glass card with yellow focus
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_glass_card"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Icon Badge -->
    <ImageView
        android:id="@+id/imgDialogIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_success"
        app:tint="@color/ufm_progress_fill"
        android:layout_marginBottom="12dp"
        android:contentDescription="@null" />

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center" />

    <!-- Dialog Message Body -->
    <TextView
        android:id="@+id/txtDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="22dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp" />

    <!-- TV Buttons (Vertical stack) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Primary Action Button (OK / Confirm / Retry) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogPositive"
            style="@style/TvContinueButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Secondary Button (Cancel / Discard) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogNegative"
            style="@style/TvContinueButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>

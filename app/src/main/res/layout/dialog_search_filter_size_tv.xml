<?xml version="1.0" encoding="utf-8"?>
<!-- TV: File Size filter dialog -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/bg_tv_dialog_surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_filter_size_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_filter_size_min_label"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <EditText
            android:id="@+id/editMinSize"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="@string/search_filter_size_min_hint"
            android:textColor="@color/tv_text_primary"
            android:textColorHint="@color/tv_text_hint"
            android:textSize="16sp"
            android:background="@drawable/selector_tv_button_yellow"
            android:paddingHorizontal="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Spinner
            android:id="@+id/spinnerMinUnit"
            android:layout_width="110dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/selector_tv_button_yellow"
            android:paddingHorizontal="12dp"
            android:popupBackground="@color/tv_dialog_background"
            android:focusable="true"
            android:focusableInTouchMode="false" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_filter_size_max_label"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="28dp">

        <EditText
            android:id="@+id/editMaxSize"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="@string/search_filter_size_max_hint"
            android:textColor="@color/tv_text_primary"
            android:textColorHint="@color/tv_text_hint"
            android:textSize="16sp"
            android:background="@drawable/selector_tv_button_yellow"
            android:paddingHorizontal="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Spinner
            android:id="@+id/spinnerMaxUnit"
            android:layout_width="110dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/selector_tv_button_yellow"
            android:paddingHorizontal="12dp"
            android:popupBackground="@color/tv_dialog_background"
            android:focusable="true"
            android:focusableInTouchMode="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnSizeCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/cancel"
            android:paddingHorizontal="24dp"
            android:textColor="@color/tv_text_primary"
            android:background="@drawable/selector_tv_button_yellow"
            android:focusable="true"
            android:focusableInTouchMode="false" />

        <Button
            android:id="@+id/btnSizeApply"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:text="@string/search_filter_apply"
            android:paddingHorizontal="24dp"
            android:textColor="@color/tv_text_primary"
            android:background="@drawable/selector_tv_button_yellow"
            android:focusable="true"
            android:focusableInTouchMode="false" />

    </LinearLayout>

</LinearLayout>

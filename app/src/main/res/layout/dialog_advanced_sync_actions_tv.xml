<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="28dp">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sync"
            app:tint="@color/tv_accent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="6dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnEdit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/edit"
        android:textSize="15sp"
        android:textColor="@color/tv_text_primary"
        android:background="@drawable/selector_tv_button"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSyncNow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/sync_now"
        android:textSize="15sp"
        android:textColor="@color/tv_text_primary"
        android:background="@drawable/selector_tv_button"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnConflictLog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/conflict_log_title"
        android:textSize="15sp"
        android:textColor="@color/tv_text_primary"
        android:background="@drawable/selector_tv_button"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/action_delete"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:background="@drawable/selector_tv_button_danger"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/cancel"
        android:textSize="14sp"
        android:textColor="@color/tv_text_secondary"
        android:background="@drawable/selector_tv_button"
        android:focusable="true" />

</LinearLayout>

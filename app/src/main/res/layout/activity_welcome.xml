<?xml version="1.0" encoding="utf-8"?>
<!--
    Mobile Welcome Screen — premium dark glassmorphism design
    Background: deep navy gradient (bg_mobile_gradient)
    Header: white-glass bar with logo, app name, Setup badge
    Body: section title + permission RecyclerView
    Footer: hint text + Continue button
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".onboarding.WelcomeActivity">

    <!-- ══════════════════════════════════════════════════
         HEADER BAR — glass bar with logo, name, Setup badge
         ══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:paddingVertical="14dp"
        android:background="#22FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App Logo with glass circle background -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_circle_accent">

            <ImageView
                android:id="@+id/imgAppIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/cd_app_icon" />
        </FrameLayout>

        <!-- Accent divider -->
        <View
            android:layout_width="1.5dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="14dp"
            android:background="#990284C7" />

        <!-- App Name + tagline -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_subtitle_tv"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- SETUP pill badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup"
            android:textColor="#FF0284C7"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:background="@drawable/bg_status_badge_accent"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════
         SECTION HEADING
         ══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/margin_md"
        android:layout_marginTop="@dimen/margin_md"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txtSectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant_permissions"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.01" />

        <!-- Accent underline bar -->
        <View
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:background="#FF0284C7" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════
         PERMISSION CARDS LIST
         ══════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPermissions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/margin_sm"
        android:paddingBottom="@dimen/margin_xs"
        app:layout_constraintTop_toBottomOf="@id/layoutSectionHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_permission_card" />

    <!-- ══════════════════════════════════════════════════
         FOOTER — hint + Continue button
         ══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_md"
        android:paddingVertical="@dimen/margin_md"
        android:background="#22FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/welcome_footer_hint"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginEnd="@dimen/margin_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:text="@string/btn_continue"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#FF0284C7"
            app:cornerRadius="24dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

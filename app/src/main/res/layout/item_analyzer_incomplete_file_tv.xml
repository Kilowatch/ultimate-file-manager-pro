<?xml version="1.0" encoding="utf-8"?>
<!--
    Incomplete / Sparse Download Row — Android TV (UFMStandard)
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:background="@drawable/selector_tv_storage_category_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/imgIncompleteFileIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            app:tint="@color/selector_tv_storage_category_icon_tint"
            android:duplicateParentState="true"
            tools:src="@drawable/ic_file_generic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:id="@+id/txtIncompleteFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/selector_tv_storage_category_text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:duplicateParentState="true"
                tools:text="BigVideoFile.mp4" />

            <TextView
                android:id="@+id/txtIncompleteFilePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/selector_tv_storage_category_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="start"
                android:duplicateParentState="true"
                tools:text="/storage/emulated/0/Download" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="12dp"
            android:duplicateParentState="true">

            <TextView
                android:id="@+id/txtIncompleteFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/selector_tv_storage_category_text_accent"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:duplicateParentState="true"
                tools:text="4.5 GB" />

            <TextView
                android:id="@+id/txtIncompleteAllocatedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-bold"
                android:background="@drawable/bg_badge_sparse"
                android:textColor="#FFA726"
                android:duplicateParentState="true"
                tools:text="350 MB (7.8%)" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/mobile_glass_header"
    android:padding="12dp"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/imgFileIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:padding="11dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_file_generic" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="document.pdf" />

        <TextView
            android:id="@+id/txtFileInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="1.2 MB · Internal Storage" />

        <TextView
            android:id="@+id/txtDateDeleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="10sp"
            tools:text="Deleted 2 hours ago" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/checkSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginStart="8dp" />

</LinearLayout>

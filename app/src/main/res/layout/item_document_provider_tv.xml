<?xml version="1.0" encoding="utf-8"?>
<!--
    Document Provider Row Item — TV Layout
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProvider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/tv_glass_white_10"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/tv_glass_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- 44dp Frosted Provider Icon Container -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:id="@+id/imgProviderIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Provider Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/txtProviderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Proton Drive" />

            <TextView
                android:id="@+id/txtProviderPackage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="me.proton.android.drive" />

            <!-- Capability Pill / Chip -->
            <TextView
                android:id="@+id/txtCapabilityTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_category_count_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/tv_accent"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                tools:text="Files &amp; Cloud" />
        </LinearLayout>

        <!-- Right Chevron / Action Indicator -->
        <ImageView
            android:id="@+id/imgChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/tv_text_secondary"
            android:importantForAccessibility="no" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

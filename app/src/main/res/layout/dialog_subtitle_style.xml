<?xml version="1.0" encoding="utf-8"?>
<!--
    Mobile Subtitle Styling Customizer — UFMStandard Glass Bottom Sheet
    Adheres strictly to UFMStandard:
    - Root background: @drawable/bg_bottom_sheet_glass
    - Top drag handle: 40dp x 4dp @drawable/bg_drag_handle
    - 48dp frosted squircle hero badge: @drawable/bg_btn_icon_frosted
    - Live interactive SubtitlePreviewView
    - Glass cards: @drawable/bg_glass_card
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_glass"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_subtitles"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_style_dialog_title"
                android:textColor="@color/mobile_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_subtitle_style_desc"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Live Subtitle Preview Box -->
            <za.kilowatch.ultimatefilemanager.viewer.subtitles.SubtitlePreviewView
                android:id="@+id/subtitlePreviewView"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="14dp" />

            <!-- Mode Selection Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_glass_card"
                android:padding="6dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/btnModeSystem"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/subtitle_style_mode_system"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnModeCustom"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/subtitle_style_mode_custom"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_chip_unselected"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- System Mode Section -->
            <LinearLayout
                android:id="@+id/layoutSystemSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_style_mode_system_desc"
                    android:textColor="@color/mobile_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/txtSystemUnavailableHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/subtitle_style_system_unavailable"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenSystemSettings"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/subtitle_style_open_system"
                    android:textColor="@android:color/white"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-medium"
                    app:cornerRadius="12dp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- Custom Mode Section -->
            <LinearLayout
                android:id="@+id/layoutCustomSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <!-- Text Size Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/subtitle_style_text_size"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/txtTextSizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekTextSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="150"
                    android:progress="50"
                    android:layout_marginBottom="14dp" />

                <!-- Text Color -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_style_text_color"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/layoutColorSwatches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp" />

                <!-- Background Opacity -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_style_bg_color"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/layoutBgChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp" />

                <!-- Edge Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_style_edge_type"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:id="@+id/layoutEdgeChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Bottom Margin -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/subtitle_style_bottom_margin"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/txtBottomMarginValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16 dp"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBottomMargin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="64"
                    android:progress="16" />
            </LinearLayout>

            <!-- Embedded Styles Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle_style_apply_embedded"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/subtitle_style_apply_embedded_desc"
                        android:textColor="@color/mobile_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchApplyEmbedded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Done Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/btn_done"
                android:textColor="@color/white"
                android:textSize="14.5sp"
                android:fontFamily="sans-serif-bold"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                android:textAllCaps="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

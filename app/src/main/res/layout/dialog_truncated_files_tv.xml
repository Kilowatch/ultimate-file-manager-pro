<?xml version="1.0" encoding="utf-8"?>
<!--
    The truncated-file cleanup offer — TV (FR-21, FR-22, FR-23).

    Paired with dialog_truncated_files.xml, selected at runtime by
    DeviceUtils.isTvDevice(). Same ids, so TransferPreflight.showTruncatedCleanup()
    is one code path for both.

    700dp, the list convention — same width and same reasoning as
    dialog_preflight_excluded_tv.xml, whose structure this mirrors deliberately:
    a long filename plus its reason pill has to fit on one row in both dialogs, and
    the two are seen one after the other.

    The scroll container is focusable and carries selector_tv_scroll_card for the
    same reason it is there: the rows are read, not chosen, so without a focusable
    container a remote could never reach a list longer than the dialog is tall — and
    the user is being asked to confirm the deletion of files they would not be able
    to see.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="700dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_glass">

    <TextView
        android:id="@+id/txtTruncatedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        tools:text="3 damaged files found" />

    <TextView
        android:id="@+id/txtTruncatedSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp"
        tools:text="12.0 GB of space that cannot be used — these files stop exactly where the limit is" />

    <!-- Fixed 240dp, matching the mobile layout's list height and for the same
         reason: a long result set must not grow the dialog past the screen.
         showTruncatedCleanup() relaxes this view — not the scroll view inside,
         which is already WRAP_CONTENT — for a short list. See
         dialog_preflight_excluded_tv.xml for why it is not weighted. -->
    <FrameLayout
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/selector_tv_scroll_card"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:padding="4dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollTruncated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/layoutTruncatedFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- Primary action, stacked above the secondary per UFMStandard. Label includes
         the count, set at runtime — "Remove" alone gives no scale to what is about
         to be deleted. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTruncatedRemove"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:textColor="@color/selector_tv_button_text_yellow"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:background="@drawable/selector_tv_button_yellow"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        tools:text="Remove 3 files" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTruncatedKeep"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/preflight_truncated_keep"
        android:textColor="@color/tv_button_text_selector"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/selector_tv_button"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true" />
</LinearLayout>

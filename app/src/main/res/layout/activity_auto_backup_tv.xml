<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup Activity — TV Standard
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".settings.AutoBackupActivity">

    <!-- TV Header Bar (72dp standard) -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        android:background="@color/tv_glass_white_10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:background="@drawable/selector_tv_icon_btn" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/margin_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_backup_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_backup_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/tv_safe_horizontal"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="48dp">

            <!-- Top Guidance Notice Card -->
            <LinearLayout
                android:id="@+id/cardInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_glass_card">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_cloud"
                    app:tint="@color/tv_button_focused_yellow"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/auto_backup_info_notice"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2" />
            </LinearLayout>

            <!-- ── SECTION 1: CONFIGURATION ───────────────────────────────── -->
            <TextView
                android:id="@+id/labelSectionGeneral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_backup_section_general"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <!-- Enable Auto Backup Toggle Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoBackupEnable"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <ImageView
                        android:id="@+id/imgEnableIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_cloud"
                        android:layout_marginEnd="@dimen/margin_lg"
                        app:tint="@color/tv_button_focused_yellow"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEnableTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_backup_enable"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />

                        <TextView
                            android:id="@+id/txtEnableSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_backup_enable_desc"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoBackup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Backup Settings Checkbox Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoBackupSettings"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <ImageView
                        android:id="@+id/imgSettingsIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_export"
                        android:layout_marginEnd="@dimen/margin_lg"
                        app:tint="@color/tv_button_focused_yellow"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtSettingsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_backup_settings_label"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />

                        <TextView
                            android:id="@+id/txtSettingsSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_backup_settings_desc"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/chkBackupSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false"
                        android:buttonTint="@color/tv_button_focused_yellow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Backup Theme Checkbox Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoBackupTheme"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <ImageView
                        android:id="@+id/imgThemeIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_palette"
                        android:layout_marginEnd="@dimen/margin_lg"
                        app:tint="@color/tv_button_focused_yellow"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtThemeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_backup_theme_label"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />

                        <TextView
                            android:id="@+id/txtThemeSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_backup_theme_desc"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/chkBackupTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false"
                        android:buttonTint="@color/tv_button_focused_yellow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── SECTION 2: SCHEDULE ────────────────────────────────────── -->
            <TextView
                android:id="@+id/labelSectionSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_backup_section_schedule"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_backup_schedule_label"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginBottom="14dp" />

                    <!-- Schedule Toggle Button Group -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleSchedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDaily"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/auto_backup_schedule_daily"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-bold"
                            android:focusable="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWeekly"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/auto_backup_schedule_weekly"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-bold"
                            android:focusable="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMonthly"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/auto_backup_schedule_monthly"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-bold"
                            android:focusable="true" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── SECTION 3: SECURITY & ENCRYPTION ───────────────────────── -->
            <TextView
                android:id="@+id/labelSectionSecurity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_backup_section_security"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoBackupPassword"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/selector_tv_card"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <ImageView
                        android:id="@+id/imgPasswordIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_lock"
                        android:layout_marginEnd="@dimen/margin_lg"
                        app:tint="@color/tv_button_focused_yellow"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtPasswordTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_backup_password_set"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />

                        <TextView
                            android:id="@+id/txtPasswordStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_backup_password_status_none"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/tv_text_secondary"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── SECTION 4: BACKUP DESTINATION ─────────────────────────── -->
            <TextView
                android:id="@+id/labelSectionLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_backup_section_location"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoBackupLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:cardCornerRadius="@dimen/card_radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/tv_glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_xl"
                    android:background="@drawable/bg_glass_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_backup_save_location"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginBottom="14dp" />

                    <!-- Location Toggle Button Group -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLocationDefault"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/auto_backup_location_default"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-bold"
                            android:focusable="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLocationCustom"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/auto_backup_location_custom"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-bold"
                            android:focusable="true" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView
                        android:id="@+id/txtLocationPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="middle"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtLocationWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_backup_location_unavailable"
                        android:textColor="@color/status_error"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnSelectFolder"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/auto_backup_select_folder_btn"
                        android:textSize="15sp"
                        android:textColor="@android:color/white"
                        android:visibility="gone"
                        android:focusable="true"
                        android:background="@drawable/selector_tv_button_yellow"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnResetLocation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/auto_backup_reset_default"
                        android:textSize="15sp"
                        android:visibility="gone"
                        android:focusable="true"
                        android:background="@drawable/selector_tv_button" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Summary -->
            <TextView
                android:id="@+id/txtAutoBackupSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Auto backup is ON — Settings and Theme — Weekly — No password" />

            <!-- Backup Now Button -->
            <Button
                android:id="@+id/btnBackupNow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/auto_backup_now"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:focusable="true"
                android:background="@drawable/selector_tv_button_yellow" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/tv_button_focused_yellow" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

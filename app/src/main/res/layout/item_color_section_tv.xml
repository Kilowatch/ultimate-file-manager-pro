<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Section header row -->
    <LinearLayout
        android:id="@+id/sectionHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="32dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/selector_tv_button_yellow">

        <!-- Colour dot -->
        <View
            android:id="@+id/sectionColorDot"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_color_swatch" />

        <!-- Section name -->
        <TextView
            android:id="@+id/sectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/selector_tv_button_text"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Expand arrow -->
        <ImageView
            android:id="@+id/sectionExpandArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_expand_more"
            app:tint="@color/tv_text_secondary"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- Colour grid container (collapsed by default) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sectionSwatchGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

</LinearLayout>

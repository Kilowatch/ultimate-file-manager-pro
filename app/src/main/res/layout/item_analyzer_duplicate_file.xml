<?xml version="1.0" encoding="utf-8"?>
<!--
    Duplicate File Row — Language & Grouped Glass Card Standard
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Primary Checkbox -->
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/checkDupFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        app:buttonTint="?attr/colorPrimary" />

    <!-- Frosted File Icon Badge -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/imgDupFileIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_file"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- File details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtDupFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_card_text_primary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:ellipsize="middle"
            tools:text="IMG_20230101.jpg" />

        <TextView
            android:id="@+id/txtDupFilePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_card_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="middle"
            android:layout_marginTop="2dp"
            tools:text="/storage/emulated/0/DCIM" />
    </LinearLayout>

    <!-- Size + Location Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/txtDupFileSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-bold"
            tools:text="4.2 MB" />

        <TextView
            android:id="@+id/txtDupLocationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_badge_in_folder"
            android:textColor="#00897B"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="In Folder" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Torrent Content & File Selection Dialog — UFMStandard Glass (Mobile)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Hero Icon Badge -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/imgTorrentHeaderIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_file_torrent"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTorrentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/torrent_file_selection_title"
        android:textColor="@color/mobile_text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:maxLines="1"
        android:ellipsize="middle"
        android:layout_marginBottom="2dp" />

    <!-- Live Selected Summary -->
    <TextView
        android:id="@+id/txtSelectedSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Selected: 0 of 0 files (0 B of 0 B)"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-bold"
        android:textAlignment="center"
        android:layout_marginBottom="12dp" />

    <!-- Location Row Glass Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/txtSaveLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:ellipsize="middle" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnChangeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_change_location"
                android:textColor="?attr/colorPrimary"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Search Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/torrent_search_hint"
        app:endIconMode="clear_text"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSearchFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/mobile_text_primary"
            android:textSize="13sp"
            android:paddingVertical="8dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Category Filter Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/filter_all"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_btn_icon_frosted"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipFilterVideos"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/filter_videos"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/mobile_text_secondary"
                android:background="@drawable/bg_btn_icon_frosted"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipFilterAudio"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/filter_audio"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/mobile_text_secondary"
                android:background="@drawable/bg_btn_icon_frosted"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipFilterImages"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/filter_images"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/mobile_text_secondary"
                android:background="@drawable/bg_btn_icon_frosted"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipFilterArchives"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/filter_archives"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/mobile_text_secondary"
                android:background="@drawable/bg_btn_icon_frosted"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipFilterDocs"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/filter_documents"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/mobile_text_secondary"
                android:background="@drawable/bg_btn_icon_frosted"
                android:paddingHorizontal="10dp"
                android:gravity="center" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Quick Action Select / Deselect All Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectAll"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/torrent_select_all"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="@color/mobile_glass_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeselectAll"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/torrent_deselect_all"
            android:textSize="12sp"
            android:textColor="@color/mobile_text_secondary"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Scrollable Files & Folders Tree List Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke"
        android:layout_marginBottom="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTorrentFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:paddingVertical="4dp"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons (Stacked Vertically per UFMStandard) -->

    <!-- Primary Action: Start Download -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartDownload"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/download_action_start"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:backgroundTint="?attr/colorPrimary"
        android:layout_marginBottom="6dp" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3Expressive.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13.5sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp" />

</LinearLayout>

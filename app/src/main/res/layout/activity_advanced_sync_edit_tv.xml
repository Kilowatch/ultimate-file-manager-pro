<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient">

    <LinearLayout
        android:id="@+id/layerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/selector_tv_icon_btn"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:clickable="true"
            app:tint="@color/tv_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/advanced_sync_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/advanced_sync_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="120dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomBar"
        app:layout_constraintTop_toBottomOf="@+id/layerHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Profile Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profile_name_eg_dcim_backup"
                app:hintTextColor="@color/tv_text_hint"
                android:textColorHint="@color/tv_text_hint"
                app:boxBackgroundColor="@android:color/transparent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="18sp"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Direction -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/sync_direction"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipDirectionUpload"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/sync_direction_upload"
                    android:textSize="14sp"
                    android:background="@drawable/selector_tv_button"
                    android:textColor="@color/tv_text_primary"
                    android:focusable="true" />

                <Button
                    android:id="@+id/chipDirectionDownload"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/sync_direction_download"
                    android:textSize="14sp"
                    android:background="@drawable/selector_tv_button"
                    android:textColor="@color/tv_text_primary"
                    android:focusable="true" />
            </LinearLayout>

            <Button
                android:id="@+id/chipDirectionTwoway"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/sync_direction_twoway"
                android:textSize="14sp"
                android:background="@drawable/selector_tv_button"
                android:textColor="@color/tv_text_primary"
                android:focusable="true" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/tv_glass_white_10"
                app:cardElevation="0dp"
                app:cardCornerRadius="12dp">

                <TextView
                    android:id="@+id/txtDirectionDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="@string/sync_direction_upload_desc"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Source Folder -->
            <TextView
                android:id="@+id/txtSourceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/source_phone"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_dialog_glass"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtLocalPath"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/not_selected"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnSelectLocal"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:text="@string/select_folder"
                    android:textColor="@color/tv_text_primary"
                    android:background="@drawable/selector_tv_button" />
            </LinearLayout>

            <!-- Destination Folder -->
            <TextView
                android:id="@+id/txtDestLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/destination"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_dialog_glass"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtRemotePath"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/not_selected"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnBrowseRemote"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:text="@string/browse_remote"
                    android:textColor="@color/tv_text_primary"
                    android:background="@drawable/selector_tv_button" />
            </LinearLayout>

            <!-- Settings Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/settings"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Schedule -->
            <RadioGroup
                android:id="@+id/radioGroupSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioInterval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:text="@string/every_x_minshrs" />

                <RadioButton
                    android:id="@+id/radioScheduled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:text="@string/scheduled_time" />

                <RadioButton
                    android:id="@+id/radioManual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:text="@string/manual" />
            </RadioGroup>

            <!-- Instant sync toggle -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchInstantSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="false"
                android:textColor="@color/tv_text_primary"
                android:textSize="16sp"
                android:text="@string/trigger_instant" />

            <!-- WiFi-only toggle -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchWifiOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="false"
                android:textColor="@color/tv_text_primary"
                android:textSize="16sp"
                android:text="@string/network_wifi_only" />

            <!-- Download subfolders toggle (visible only for Download) -->
            <LinearLayout
                android:id="@+id/layoutDownloadSubfolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDownloadSubfolders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:checked="false"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:text="@string/download_subfolders" />
            </LinearLayout>

            <!-- Sync deletions + Move files (visible only for Upload / Download) -->
            <LinearLayout
                android:id="@+id/layoutSyncDeletions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMoveFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:checked="false"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:text="@string/move_files_upload" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSyncDeletions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:checked="false"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:text="@string/sync_deletions" />
            </LinearLayout>

            <!-- Filters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/sync_filtering"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipFilterAll"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:text="@string/filter_all_types"
                    android:textSize="14sp"
                    android:background="@drawable/selector_tv_button"
                    android:textColor="@color/tv_text_primary" />

                <Button
                    android:id="@+id/chipFilterOnly"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="@string/filter_only"
                    android:textSize="14sp"
                    android:background="@drawable/selector_tv_button"
                    android:textColor="@color/tv_text_primary" />

                <Button
                    android:id="@+id/chipFilterSkip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:text="@string/filter_skip"
                    android:textSize="14sp"
                    android:background="@drawable/selector_tv_button"
                    android:textColor="@color/tv_text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtFilterExtensionsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/filter_extensions_label"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutFilterExtensions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:hintTextColor="@color/tv_text_hint"
                android:textColorHint="@color/tv_text_hint"
                app:boxBackgroundColor="@android:color/transparent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editFilterExtensions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="18sp"
                    android:hint="@string/filter_extensions_hint"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/filter_exclude_label"
                app:hintTextColor="@color/tv_text_hint"
                android:textColorHint="@color/tv_text_hint"
                app:boxBackgroundColor="@android:color/transparent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editExcludePatterns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="18sp"
                    android:hint="@string/filter_exclude_hint"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Notifications toggle -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:textColor="@color/tv_text_primary"
                android:textSize="16sp"
                android:text="@string/show_sync_notifications" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:orientation="horizontal"
        android:gravity="end"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/delete_1"
            android:textColor="@color/ufm_denied"
            android:background="@drawable/selector_tv_button"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:text="@string/save_profile"
            android:textColor="@color/tv_text_primary"
            android:background="@drawable/selector_tv_button_yellow" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Mobile Storage Browser — premium glassmorphism design.
    Header upgraded to MaterialToolbar (M3) — supports elevation, scroll behaviour,
    and Dynamic Color. Background stays on the custom gradient.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_gradient"
    tools:context=".storage.StorageBrowserActivity">

    <!-- ══════════════════════════════════════════════════
         HEADER BAR — MaterialToolbar (M3) replaces the legacy LinearLayout.
         Transparent background so the gradient background shows through.
         The subtitle is driven programmatically via toolbar.subtitle.
         ══════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mobile_glass_header"
        android:elevation="6dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/recyclerStorage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:menu="@menu/menu_storage_browser">

            <!-- Custom Title Layout inside Toolbar to guarantee alignment -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="start">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_storage_browser_logo"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/storage_title"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                    android:textColor="@color/mobile_text_primary"
                    android:letterSpacing="0.01" />

            </LinearLayout>

            <!-- Manage Tiles button — placed inside the toolbar as an action -->
            <ImageView
                android:id="@+id/btnManageTiles"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:src="@drawable/ic_tune"
                android:contentDescription="@string/cd_manage_tiles"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_icon_circle_accent"
                app:tint="@color/mobile_icon_tint"
                android:visibility="gone" />

            <!-- Color button — visible only in Edit Mode -->
            <ImageView
                android:id="@+id/btnColorTile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:src="@drawable/ic_palette"
                android:contentDescription="@string/tile_color_title"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_icon_circle_accent"
                app:tint="@color/mobile_icon_tint"
                android:visibility="gone" />

            <!-- Import Code button — visible only in Edit Mode -->
            <ImageView
                android:id="@+id/btnImportColorCode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:src="@drawable/ic_import_code"
                android:contentDescription="@string/tile_color_import"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_icon_circle_accent"
                app:tint="@color/mobile_icon_tint"
                android:visibility="gone" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>


    <!-- ══════════════════════════════════════════════════
         TIP JAR PROGRESS CARD
         ══════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTipJarProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_md"
        android:layout_marginTop="@dimen/margin_md"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/mobile_glass_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/mobile_glass_stroke"
        app:rippleColor="@color/mobile_glass_ripple"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:padding="16dp">

            <!-- Jar Icon (left) -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_tip_jar_glow"
                android:contentDescription="@null"
                android:layout_marginEnd="14dp" />

            <!-- Center details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/txtTipJarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mobile_card_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-black"
                    tools:text="Tip jar progress • June 2025" />

                <TextView
                    android:id="@+id/tip_jar_desc_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tip_jar_desc_label"
                    android:textColor="@color/mobile_card_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="sans-serif" />

                <!-- Progress bar and percentage -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <ProgressBar
                        android:id="@+id/progressTipJar"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/bg_tip_jar_progress"
                        android:max="100" />

                    <TextView
                        android:id="@+id/txtTipJarPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/tile_tip_jar_accent"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-black" />

                </LinearLayout>

            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="56dp"
                android:background="@color/mobile_glass_stroke"
                android:layout_marginHorizontal="14dp" />

            <!-- Right layout -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:minWidth="80dp"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_heart_outline"
                    android:contentDescription="@null"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tip_jar_thanks_label"
                    android:textColor="@color/tile_tip_jar_accent"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tip_jar_awesome_label"
                    android:textColor="@color/mobile_card_text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textAlignment="center" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ══════════════════════════════════════════════════
         SECTION HEADING
         ══════════════════════════════════════════════════ -->
    <RelativeLayout
        android:id="@+id/layoutSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_md"
        android:layout_marginTop="@dimen/margin_md"
        app:layout_constraintTop_toBottomOf="@id/cardTipJarProgress"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/storage_section_devices"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.01" />

            <!-- Accent underline bar — uses ?attr/colorPrimary to honour Dynamic Colors -->
            <View
                android:layout_width="36dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="?attr/colorPrimary" />
        </LinearLayout>

        <!-- View Mode Toggle Container -->
        <LinearLayout
            android:id="@+id/layoutToggleViewMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_view_toggle_container"
            android:padding="3dp">

            <ImageView
                android:id="@+id/btnToggleGrid"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_grid_view_custom"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_view_toggle_item_active"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnToggleList"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_list_view_custom"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                app:tint="@color/white" />
        </LinearLayout>

    </RelativeLayout>

    <!-- ══════════════════════════════════════════════════
         STORAGE LIST — vertical full-width cards
         ══════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerStorage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/margin_sm"
        android:paddingBottom="@dimen/margin_xl"
        app:layout_constraintTop_toBottomOf="@id/layoutSectionHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_storage_card" />

    <!-- Empty State — Lottie animation + label, shown when no storage volumes are found -->
    <LinearLayout
        android:id="@+id/layoutEmptyStorage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieEmptyStorage"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@null"
            app:lottie_rawRes="@raw/anim_empty_storage"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:id="@+id/txtEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_sm"
            android:text="@string/storage_no_storages"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            android:textAlignment="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

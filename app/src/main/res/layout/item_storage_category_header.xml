<?xml version="1.0" encoding="utf-8"?>
<!--
    Modern Frosted Category Header Card for Main Menu (Storage Browser)
    Collapsible with chevron toggle, count pill, and frosted icon badge.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategoryHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/mobile_glass_stroke"
    app:cardBackgroundColor="@color/mobile_glass_card"
    app:rippleColor="@color/mobile_glass_ripple"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/layoutCategoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Category Squircle Icon Badge -->
        <FrameLayout
            android:id="@+id/iconContainerHeader"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_squircle_category_icon">

            <ImageView
                android:id="@+id/imgCategoryIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_storage_internal"
                app:tint="@color/mobile_icon_tint"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Category Title & Subtitle Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/txtCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_menu_category_storage"
                android:textColor="@color/mobile_card_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/txtCategorySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/mobile_card_text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:text="4 items" />
        </LinearLayout>

        <!-- Collapsed Item Count Pill Badge -->
        <TextView
            android:id="@+id/txtCategoryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_count_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="7 items"
            android:textColor="@color/mobile_card_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:layout_marginEnd="10dp" />

        <!-- Edit Mode Delete Button for Custom Category Headers -->
        <ImageView
            android:id="@+id/btnDeleteCategoryHeader"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:src="@drawable/ic_close"
            app:tint="@color/mobile_icon_tint"
            android:contentDescription="@string/custom_header_delete_title"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- Expand / Collapse Chevron Indicator -->
        <ImageView
            android:id="@+id/imgCategoryChevron"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/mobile_card_text_secondary"
            android:contentDescription="@null" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

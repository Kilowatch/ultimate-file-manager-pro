<?xml version="1.0" encoding="utf-8"?>
<!--
    Modern Frosted Category Header for Main Menu (Storage Browser)
    Collapsible with chevron toggle, count pill, and frosted icon badge.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutCategoryHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="4dp"
    android:layout_marginHorizontal="12dp"
    android:background="@drawable/bg_btn_icon_frosted"
    android:clickable="true"
    android:focusable="true">

    <!-- Category Icon in Frosted Squircle -->
    <FrameLayout
        android:id="@+id/iconContainerHeader"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_btn_icon_frosted">

        <ImageView
            android:id="@+id/imgCategoryIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_storage_internal"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Category Title -->
    <TextView
        android:id="@+id/txtCategoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="@string/main_menu_category_storage"
        android:textColor="@color/mobile_card_text_primary"
        android:textSize="15sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.02" />

    <!-- Item Count Pill -->
    <TextView
        android:id="@+id/txtCategoryCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_btn_icon_frosted"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="7 items"
        android:textColor="@color/mobile_card_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-bold"
        android:layout_marginEnd="8dp" />

    <!-- Expand / Collapse Chevron Indicator -->
    <ImageView
        android:id="@+id/imgCategoryChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_expand_more"
        app:tint="@color/mobile_card_text_secondary"
        android:contentDescription="@null" />

    <!-- Edit Mode Delete Button for Custom Category Headers -->
    <ImageView
        android:id="@+id/btnDeleteCategoryHeader"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="5dp"
        android:background="@drawable/bg_btn_icon_frosted"
        android:src="@drawable/ic_close"
        app:tint="@color/mobile_icon_tint"
        android:contentDescription="@string/custom_header_delete_title"
        android:visibility="gone" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Server Host — same structure as mobile but with TV-aware styling
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".server.ServerHostActivity">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
            android:background="@drawable/selector_tv_icon_btn" />

        <View
            android:layout_width="1.5dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="14dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/file_server_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/file_server_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- FTP Card -->
            <LinearLayout
                android:id="@+id/layoutFtpCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/selector_tv_list_item"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:duplicateParentState="true"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ftp_server_label"
                        android:textColor="@color/selector_tv_button_text_yellow"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:duplicateParentState="true" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFtp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="false"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ftp_port_info"
                    android:textColor="@color/selector_tv_btn_secondary_text"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true" />

                <TextView
                    android:id="@+id/txtFtpUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_url_box"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- SFTP Card -->
            <LinearLayout
                android:id="@+id/layoutSftpCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/selector_tv_list_item"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:duplicateParentState="true"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sftp_server_label"
                        android:textColor="@color/selector_tv_button_text_yellow"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:duplicateParentState="true" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSftp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="false"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sftp_port_info"
                    android:textColor="@color/selector_tv_btn_secondary_text"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true" />

                <TextView
                    android:id="@+id/txtSftpUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_url_box"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- DLNA Card -->
            <LinearLayout
                android:id="@+id/layoutDlnaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/selector_tv_list_item"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:duplicateParentState="true"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dlna_host_title"
                        android:textColor="@color/selector_tv_button_text_yellow"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:duplicateParentState="true" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_down"
                        android:rotation="-90"
                        android:duplicateParentState="true"
                        app:tint="@color/selector_tv_btn_secondary_text"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDlnaStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dlna_host_subtitle"
                    android:textColor="@color/selector_tv_btn_secondary_text"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:duplicateParentState="true" />
            </LinearLayout>


            <!-- Profiles Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_profiles"
                android:textColor="@color/tv_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:id="@+id/layoutEmptyProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_file_server"
                    android:alpha="0.4"
                    app:tint="@color/tv_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_profiles_yet"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Add Profile Button (TV uses a button instead of FAB) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fabAddProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_profile"
                android:focusable="true"
                app:icon="@drawable/ic_add"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

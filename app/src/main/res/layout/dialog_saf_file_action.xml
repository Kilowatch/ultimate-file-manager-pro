<?xml version="1.0" encoding="utf-8"?>
<!--
    SAF Picked File Action Dialog — Mobile Layout (UFMStandard)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- Header with Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/saf_file_action_dialog_title"
            android:textColor="@color/mobile_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:textAlignment="center"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13.5sp"
            android:textAlignment="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Remember My Choice Checkbox -->
    <CheckBox
        android:id="@+id/chkRemember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/saf_file_action_remember"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center_horizontal" />

    <!-- Action Buttons (Vertical Layout Standard) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Primary Action: Open in Viewer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenViewer"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/saf_file_action_open_viewer"
            android:textColor="@android:color/white"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="12dp"
            android:layout_marginBottom="10dp" />

        <!-- Secondary Action: Copy to Local Storage -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyLocal"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/saf_file_action_copy_local"
            android:textColor="@color/mobile_text_primary"
            app:backgroundTint="@color/mobile_glass_card"
            app:strokeColor="@color/mobile_glass_stroke"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="4dp" />

        <!-- Destination Info & Change Action -->
        <LinearLayout
            android:id="@+id/layoutDestinationInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtDestinationPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/btnChangeDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/saf_copy_destination_change"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Cancel Text Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3Expressive.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/cancel"
            android:textColor="@color/mobile_text_secondary" />
    </LinearLayout>

</LinearLayout>

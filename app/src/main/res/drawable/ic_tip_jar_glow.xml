            <gradient
                android:type="linear"
                android:startX="23.7"
                android:startY="31.7"
                android:endX="40.3"
                android:endY="47.0">
                <item android:color="#FF00E5FF" android:offset="0.0" />
                <item android:color="#FF2979FF" android:offset="0.5" />
                <item android:color="#FF651FFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass jar outer outline stroke -->
    <path
        android:strokeColor="#B0FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 24,22 C 24,22 22,26 21,28 C 19.5,31 19,34 19,38 L 19,50 C 19,53.3 21.7,56 25,56 L 39,56 C 42.3,56 45,53.3 45,50 L 45,38 C 45,34 44.5,31 43,28 C 42,26 40,22 40,22 Z"/>

    <!-- Glass highlight accent line on the left side to look 3D -->
    <path
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 22,30 C 20.5,33 20.2,36 20.2,39 L 20.2,48 C 20.2,49 20.8,50 21.5,50"/>

    <!-- Glass neck outline line -->
    <path
        android:strokeColor="#B0FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M 25,22 L 39,22"/>

    <!-- Jar Lid (gradient filled) -->
    <path
        android:pathData="M 24,14 C 23.5,14 23,14.5 23,15 C 23,15.5 23,21 23,21 C 23,21.5 23.5,22 24,22 L 40,22 C 40.5,22 41,21.5 41,21 C 41,21 41,15.5 41,15 C 41,14.5 40.5,14 40,14 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="23.0"
                android:startY="14.0"
                android:endX="41.0"

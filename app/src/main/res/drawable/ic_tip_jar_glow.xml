    <!-- Glass jar inner background fill (faint glass reflection/glow) -->
    <path
        android:fillColor="#15FFFFFF"
        android:pathData="M 24,22 C 24,22 22,26 21,28 C 19.5,31 19,34 19,38 L 19,50 C 19,53.3 21.7,56 25,56 L 39,56 C 42.3,56 45,53.3 45,50 L 45,38 C 45,34 44.5,31 43,28 C 42,26 40,22 40,22 Z"/>

    <!-- Floating heart inside the jar (gradient filled) -->
    <path
        android:pathData="M 32,47 L 30.8,45.9 C 26.5,42.0 23.7,39.5 23.7,36.3 C 23.7,33.7 25.7,31.7 28.3,31.7 C 29.8,31.7 31.2,32.4 32,33.5 C 32.8,32.4 34.2,31.7 35.7,31.7 C 38.3,31.7 40.3,33.7 40.3,36.3 C 40.3,39.5 37.5,42.0 33.2,45.9 L 32,47 Z">

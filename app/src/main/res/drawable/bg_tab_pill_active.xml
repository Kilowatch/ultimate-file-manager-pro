<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mobile_glass_ripple">
    <item>
        <layer-list>
            <!-- Chrome Tab Body: sloped/curved top corners and flat bottom sitting flush above content -->
            <item>
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="10dp"
                        android:topRightRadius="10dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <solid android:color="#212A3D" />
                    <stroke
                        android:width="1dp"
                        android:color="#364966" />
                </shape>
            </item>
            <!-- Chrome Active Indicator: Top accent stripe (Google Chrome / modern IDE aesthetic) -->
            <item
                android:height="2.5dp"
                android:gravity="top">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="10dp"
                        android:topRightRadius="10dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                    <solid android:color="#00E5FF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/ufmFocusFill" />
                    <stroke android:width="3dp" android:color="?attr/ufmFocusStrokeColor" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- FR-06 leading-edge marker (T011); transparent when Off. -->
            <item android:drawable="@drawable/ufm_focus_marker_bar" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/ufmFocusFill" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

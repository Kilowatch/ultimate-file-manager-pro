<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Yellow background with Black text -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/ufmFocusFill" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <!-- FR-06 leading-edge marker (T011); transparent when Off. -->
            <item android:drawable="@drawable/ufm_focus_marker_bar" />
        </layer-list>
    </item>
    <!-- Default state: Transparent glass background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_white_10" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/tv_glass_border" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Danger Red background -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ufm_denied" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/white" />
        </shape>
    </item>
    <!-- Default state: Transparent glass background with subtle danger tint -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_white_10" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/ufm_denied" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mobile_glass_ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ufm_selection_highlight" />
                    <stroke android:width="2dp" android:color="@color/ufm_primary" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ufm_selection_highlight" />
                    <stroke android:width="2dp" android:color="@color/ufm_primary" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0D000000" />
                    <stroke android:width="1dp" android:color="@color/mobile_glass_stroke" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<!-- Focused glass surface (blue family). This IS a focus drawable — it is the
     focused background applied by focus selectors — so it belongs to the
     FR-05/06/07 conversion. Wrapped in a layer-list purely so the FR-06
     leading-edge marker can ride along; the surface itself is unchanged, and
     the marker is transparent while Colorblind Mode is Off. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/ufmFocusAccentSurface" />
            <stroke android:width="2dp" android:color="?attr/ufmFocusAccent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- FR-06 leading-edge marker (T012); transparent when Off. -->
    <item android:drawable="@drawable/ufm_focus_marker_bar" />
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item android:top="-6dp" android:bottom="-6dp" android:left="-6dp" android:right="-6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="@color/tv_button_focused_blue_glow" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/tv_button_focused_blue" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_button_focused_blue" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_btn_default_surface" />
            <stroke android:width="1.5dp" android:color="@color/tv_btn_default_border" />
        </shape>
    </item>

</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
    FR-09 warning glyph: a triangle with an exclamation mark knocked out of it.

    Same contract as ic_status_success: colour from ?attr/ufmStatusWarning, so
    the glyph follows the applied Colorblind Mode overlay with no call-site
    tinting; silhouette distinct from the other two so it survives greyscale.

    The bang is a rectangle plus a dot, both knocked out via fillType="evenOdd"
    rather than drawn in a contrasting colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="?attr/ufmStatusWarning"
        android:fillType="evenOdd"
        android:pathData="M12,2.6 L22,20 L2,20 Z M11,9 L13,9 L13,15 L11,15 Z M12,16.4 A1.1,1.1 0 1,0 12,18.6 A1.1,1.1 0 1,0 12,16.4 Z" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Simulated cinema viewport backdrop for live subtitle styling preview -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1E2235"
        android:centerColor="#131520"
        android:endColor="#0B0C12"
        android:type="linear" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#334155" />
</shape>

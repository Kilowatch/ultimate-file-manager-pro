<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="-4dp" android:left="-4dp" android:right="-4dp" android:top="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_button_focused_yellow_glow" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_button_focused_yellow" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_white_10" />
            <stroke android:width="1.5dp" android:color="@color/tv_glass_border_strong" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>

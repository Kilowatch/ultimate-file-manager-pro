<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Premium High-Visibility Yellow -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/ufmFocusFill" />
                    <corners android:radius="20dp" />
                    <stroke android:width="3dp" android:color="?attr/ufmFocusGlow" />
                </shape>
            </item>
            <!-- FR-06 leading-edge marker (T011); transparent when Off. -->
            <item android:drawable="@drawable/ufm_focus_marker_bar" />
        </layer-list>
    </item>
    
    <!-- Unfocused: Translucent Frosted Glass (Theme-Aware) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_white_15" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/tv_glass_border_strong" />
        </shape>
    </item>
</selector>

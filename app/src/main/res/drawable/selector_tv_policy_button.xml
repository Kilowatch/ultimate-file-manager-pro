<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Premium High-Visibility Yellow -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_focused_yellow" />
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="@color/tv_button_focused_yellow_glow" />
        </shape>
    </item>
    
    <!-- Unfocused: Translucent Frosted Glass (Theme-Aware) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_white_15" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/tv_glass_border_strong" />
        </shape>
    </item>
</selector>

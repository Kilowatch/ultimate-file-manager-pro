<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: bright yellow fill + strong amber glow -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer amber glow bleed -->
            <item android:top="-6dp" android:bottom="-6dp" android:left="-6dp" android:right="-6dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_button_focused_yellow_glow" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
            <!-- Inner glow ring -->
            <item android:top="-2dp" android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_button_focused_yellow" />
                    <corners android:radius="27dp" />
                </shape>
            </item>
            <!-- Yellow button body -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_button_focused_yellow" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default: glass outline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_white_10" />
            <stroke android:width="1dp" android:color="@color/tv_glass_border_strong" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- UFM Player controls background: dark bottom fading to transparent at top.
     Uses solid black base at the bottom edge and fades out upward,
     providing a visible backdrop for buttons without harsh edges. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="90"
        android:endColor="#00000000"
        android:startColor="#CC000000" />
</shape>

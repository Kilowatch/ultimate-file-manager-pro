<?xml version="1.0" encoding="utf-8"?>
<!--
    Colorblind Accessibility Mode icon (FR-20).

    An eye whose iris is split down the vertical diameter: the left half solid,
    the right half left open. The eye is the perception metaphor; the half-fill
    is the contrast metaphor. Together they say "how you see", which is what this
    setting changes.

    The split is drawn with fill parity rather than with two colours, which is
    the point: the icon has to read correctly for a user who cannot distinguish
    the two colours it would otherwise be painted in. Left-half-solid is legible
    in greyscale, at small sizes, and through every simulated deficiency.

    Geometry: the eye lens is the standard Material visibility outline; the iris
    is a 5-unit hole, filled on its left side by a half-disc. The hole is knocked
    out by fillType="evenOdd" on the first path, and the half-disc is a second
    path that repaints its half. Checked by .plans/tools/check_glyphs.py, which
    flattens the curves and evaluates paint parity at sampled points.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- Eye lens, with the iris knocked out as a hole -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M12,4.5 C7,4.5 2.73,7.61 1,12 C2.73,16.39 7,19.5 12,19.5 C17,19.5 21.27,16.39 23,12 C21.27,7.61 17,4.5 12,4.5 Z M12,17 A5,5 0 1,0 12,7 A5,5 0 1,0 12,17 Z" />

    <!-- Left half of the iris. The closing chord is the vertical diameter, so
         the right half of the hole stays unpainted and the split reads. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,7 A5,5 0 0,0 12,17 Z" />

</vector>

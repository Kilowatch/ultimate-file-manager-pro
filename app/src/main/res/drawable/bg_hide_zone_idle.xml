<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed border for the Hide Zone strip — idle (not hovered) state -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="2dp"
        android:color="#FF0284C7"
        android:dashWidth="8dp"
        android:dashGap="4dp" />
    <solid android:color="#FFF5F5F5" /> <!-- Solid off-white background -->
    <corners android:radius="16dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: TV Yellow highlight -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_focused_yellow" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Selected state (currently playing video when not focused) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FBBF24" />
            <stroke android:width="1.5dp" android:color="#FBBF24" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Normal state: theme-aware glass surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_white_10" />
            <stroke android:width="1dp" android:color="@color/tv_glass_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused and Checked (Active) -->
    <item android:state_checked="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_focused_yellow" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/tv_accent" />
        </shape>
    </item>
    <!-- Checked (Active) but not focused -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_focused_yellow" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/tv_accent" />
        </shape>
    </item>
    <!-- Focused but not checked -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_focused_yellow" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass_white_10" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/tv_glass_border" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <!-- Solid left literal: #FFD32F2F is a third red for this role
                     (see selector_tv_button_danger.xml). No attribute default
                     matches it, so converting would change the Off appearance. -->
                <shape android:shape="rectangle">
                    <solid android:color="#FFD32F2F" />
                    <stroke android:width="3dp" android:color="?attr/ufmFocusStrokeColor" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- FR-06 leading-edge marker (T011); transparent when Off. -->
            <item android:drawable="@drawable/ufm_focus_marker_bar" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFD32F2F" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

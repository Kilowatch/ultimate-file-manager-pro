<?xml version="1.0" encoding="utf-8"?>
<!-- TV Focus Drawable: Yellow solid circle for the Back Button.

     This is the FOCUSED drawable (applied in code on focus; see
     BackupRestoreActivity/ExportDetailsActivity/ImportDetailsActivity and the
     icon-picker grids), so it is a focus surface and belongs to the FR-05/06
     conversion. Wrapped in a layer-list purely so the FR-06 leading-edge marker
     can ride along; the oval itself is unchanged, and the marker is transparent
     while Colorblind Mode is Off (NFR: appearance-neutral when Off). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/ufmFocusFill" />
        </shape>
    </item>
    <!-- FR-06 leading-edge marker (T011); transparent when Off. -->
    <item android:drawable="@drawable/ufm_focus_marker_bar" />
</layer-list>

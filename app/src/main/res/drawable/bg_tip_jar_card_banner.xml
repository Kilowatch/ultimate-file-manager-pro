<?xml version="1.0" encoding="utf-8"?>
<!--
    Gradient banner for the top section of the tip jar progress card.
    Left-to-right: translucent electric cyan/blue aura → transparent.
    The card's own cardCornerRadius clips the top corners naturally.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#3300B0FF"
        android:centerColor="#1500B0FF"
        android:endColor="#00000000" />
</shape>

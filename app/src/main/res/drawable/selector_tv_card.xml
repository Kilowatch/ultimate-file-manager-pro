<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer Glow Bleed (largest, most transparent) -->
            <item android:bottom="-8dp" android:left="-8dp" android:right="-8dp" android:top="-8dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="?attr/ufmFocusAccentGlowOuter" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
            <!-- Mid Glow -->
            <item android:bottom="-4dp" android:left="-4dp" android:right="-4dp" android:top="-4dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="?attr/ufmFocusAccentGlow" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <!-- Solid Border. All three rings convert as a UNIT (T012): they are
                 one graduated glow at 50/40/100% of the same hue, so remapping
                 only the solid ring would leave blue halos around a
                 differently-hued border. -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="3dp"
                        android:color="?attr/ufmFocusAccent" />
                    <corners android:radius="@dimen/card_radius_lg" />
                </shape>
            </item>
            <!-- FR-06 leading-edge marker (T012); transparent when Off. -->
            <item android:drawable="@drawable/ufm_focus_marker_bar" />
        </layer-list>
    </item>
    <!-- Default: more visible border so cards are always distinguishable -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/tv_glass_border_strong" />
            <corners android:radius="@dimen/card_radius_lg" />
        </shape>
    </item>
</selector>

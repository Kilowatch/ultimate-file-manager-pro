<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer Glow Bleed (largest, most transparent) -->
            <item android:bottom="-8dp" android:left="-8dp" android:right="-8dp" android:top="-8dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="@color/tv_focus_glow_outer" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
            <!-- Mid Glow -->
            <item android:bottom="-4dp" android:left="-4dp" android:right="-4dp" android:top="-4dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="@color/tv_accent_glow" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <!-- Solid Border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/tv_focus_border_strong" />
                    <corners android:radius="@dimen/card_radius_lg" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default: more visible border so cards are always distinguishable -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/tv_glass_border_strong" />
            <corners android:radius="@dimen/card_radius_lg" />
        </shape>
    </item>
</selector>

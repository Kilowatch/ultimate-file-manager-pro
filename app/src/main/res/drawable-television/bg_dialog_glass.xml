<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV Dialog Background - Solid Opaque Dark Surface (#F81A1D27)
    Automatically loaded on Android TV devices via 'television' qualifier.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Opaque Solid Dark Surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F81A1D27" />
            <stroke android:width="1.5dp" android:color="@color/tv_glass_border" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Inner Top Highlight -->
    <item android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/tv_glass_highlight" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>

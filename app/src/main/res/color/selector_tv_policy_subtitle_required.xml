<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused (Yellow Background): Text should be black -->
    <item android:state_focused="true" android:color="?attr/ufmFocusFillText" />
    <!-- Unfocused (Glass Background): Text should be yellow (accent) to draw attention -->
    <item android:color="?attr/ufmFocusFill" />
</selector>

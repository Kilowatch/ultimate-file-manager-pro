<?xml version="1.0" encoding="utf-8"?>
<!-- Tint for TV scan/browse icon buttons:
     black when focused (sitting on yellow bg), white otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"  android:color="@color/tv_button_focused_yellow_text" />
    <item android:state_pressed="true"  android:color="@color/tv_button_focused_yellow_text" />
    <item                               android:color="@color/tv_text_primary" />
</selector>

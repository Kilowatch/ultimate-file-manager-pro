<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Yellow -->
    <item android:state_focused="true" android:color="@color/tv_button_focused_yellow" />
    <!-- Checked (Selected) state: Yellow (even when not focused) -->
    <item android:state_checked="true" android:color="@color/tv_button_focused_yellow" />
    <!-- Disabled state: Subdued glass -->
    <item android:state_enabled="false" android:color="@color/btn_disabled_bg" />
    <!-- Default state: Transparent glass -->
    <item android:color="@color/tv_button_default_bg" />
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Text color selector for the Save button.
    Enabled  → mobile_text_primary (white on dark theme, near-black on light)
    Disabled → btn_disabled_text (muted, theme-aware)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/btn_disabled_text" />
    <item android:color="@color/mobile_text_primary" />
</selector>

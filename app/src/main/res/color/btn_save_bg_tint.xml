<?xml version="1.0" encoding="utf-8"?>
<!--
    Background tint selector for the Save button.
    Enabled  → ufm_primary  (teal in light, brighter teal in dark — driven by values-night/colors.xml)
    Disabled → btn_disabled_bg (muted grey — also theme-aware via values-night/colors.xml)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/btn_disabled_bg" />
    <item android:color="@color/ufm_primary" />
</selector>

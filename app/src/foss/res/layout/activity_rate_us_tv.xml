<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    tools:context=".settings.RateUsActivity">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/layerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_icon_circle_accent"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusRight="@+id/btnRateUs"
            android:nextFocusDown="@+id/btnRateUs"
            app:tint="@color/tv_text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_us_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_us_subtitle"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/bg_glass_card_dark"
        app:layout_constraintTop_toBottomOf="@id/layerHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_star"
            app:tint="@color/tv_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_us_screen_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_us_screen_body_foss"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRateUs"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="240dp"
            android:layout_height="52dp"
            android:text="@string/rate_us_button_play_foss"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            app:backgroundTint="@color/ufm_primary"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_star"
            app:iconGravity="textStart"
            app:iconTint="@color/tv_text_primary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
